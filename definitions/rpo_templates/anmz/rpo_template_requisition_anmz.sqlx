config {
    type: "operations",
    description: "Dynamically creates the anonymized table for RPO requisition.",
    dependencies: "rpo_template_requisition_gold", 
    tags: ["rpo_template_gold_anmz"] 
}

js {
    const anonymization = require("includes/anonymization");
    const helper = require("/includes/helper");
    const config_ds_name = helper.get_config_ds();
    const config_table_name = helper.get_config_table();
    const env = helper.get_env();
    const region = helper.get_region();
    const dataset_id = dataform.projectConfig.vars.dataset_id;
    const client_code = dataform.projectConfig.vars.client_code;
    const region_code = helper.get_region_code(); 

    const gold_dataset = (env == "prd") ? `gold_${dataset_id}` : `dev_gold_${dataset_id}`;
    
     const anmz_dataset =
     `db_anmz_${region_code}_requisition_stdschema`;
    const metadata_path = `\`rsr-bi-group-prd-701e.db_${region_code}_mysql_configs.master_template_report_fields\``;
}

DECLARE requisition_table_id STRING;
DECLARE select_clause STRING;
DECLARE final_ddl_statement STRING;

-- RPO tables use the 'stdrv_candidate_' prefix followed by the client code
SET requisition_table_id = "stdrv_requisition_" || '${client_code}';

-- 1. Fetch the Select Clause logic from the shared includes file
-- Flag 1 = Masking/Hashing, Flag 0 = Mandatory Casting
EXECUTE IMMEDIATE
  FORMAT("""${
        anonymization.get_anonymized_select_clause({
            report_type: "requisition",
            solution: "RPO",
            metadata_table: metadata_path
        })
    }""") INTO select_clause;

-- 2. Create anmz table in the dynamic region-based dataset

SET final_ddl_statement = FORMAT("""
  CREATE OR REPLACE TABLE `${anmz_dataset}.anmz_requisition_${client_code}` AS (
    SELECT %s FROM `${gold_dataset}.%s`
  )
""", select_clause, requisition_table_id );

EXECUTE IMMEDIATE final_ddl_statement;