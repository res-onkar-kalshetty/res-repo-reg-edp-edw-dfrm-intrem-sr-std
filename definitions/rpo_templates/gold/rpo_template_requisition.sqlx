config {
    type: "operations",
    name: "rpo_template_requisition_gold",
    dependencies: "rpo_template_candidate_gold",
    tags: 'rpo_template_gold',
    description: 'This file creates the  stdrv layer'
}


js {
    const helper = require("/includes/helper");

    const config_ds_name = helper.get_config_ds();
    const config_table_name = helper.get_config_table();
    const env = helper.get_env();
    const region = helper.get_region();
    const dataset_id = dataform.projectConfig.vars.dataset_id;

    const gold_dataset = (env == "prd") ?
        `gold_${dataset_id}` :
        `dev_gold_${dataset_id}`;

    const slvr_dataset = (env == "prd") ?
        `slvr_${dataset_id}` :
        `dev_slvr_${dataset_id}`;
    
    const slvr_ph1_r = helper.getSlvrTableName(config_ds_name, config_table_name, 'candidate_src', dataset_id);
    const slvr_ph2_r = helper.getSlvrTableName(config_ds_name, config_table_name, 'requisition_src', dataset_id);
}

DECLARE
  requisition_table_id STRING;
DECLARE
  gold_dataset STRING;
DECLARE
  slvr_dataset STRING;
DECLARE
  config_ds_name STRING;
DECLARE
  config_table_name STRING;
DECLARE
  region STRING;
DECLARE
  slvr_ph1_r STRING;
DECLARE
  slvr_ph2_r STRING;
SET
  config_ds_name = '${config_ds_name}';
SET
  config_table_name = '${config_table_name}';
SET
  region = '${region}';
SET
  gold_dataset = '${gold_dataset}';
SET
  slvr_dataset = '${slvr_dataset}';
SET 
  slvr_ph1_r = 'v_' || ${slvr_ph1_r};
SET
  slvr_ph2_r = 'v_' || ${slvr_ph2_r};

EXECUTE IMMEDIATE
  FORMAT ('''
  SELECT
  DISTINCT 't_' || table_id,
  FROM
  `%s.%s`
    WHERE entity_type = 'requisition_src' and dataset_id = '${dataform.projectConfig.vars.dataset_id}' LIMIT 1
''', config_ds_name,config_table_name) INTO requisition_table_id;
IF
  requisition_table_id IS NULL THEN RAISE
USING
  MESSAGE = 'requisition_table_id TABLE ID IS MISSING FROM CONFIGS';
END IF
  ;

EXECUTE IMMEDIATE FORMAT ("""

CREATE OR REPLACE TABLE `%s.%s` AS (
/* QUERY DOCUMENTATION
-- TYPE: requisition, non-transactional
-- outermost query contains calcuations that take fields from subquery1 as input
-- subquery1 gets the standard fields from the source, maps fields using the
standard mapping, calculates fields using source fields, and retrieves aggregations
from candidate stdz table
*/
SELECT DISTINCT subquery1.*
------------------------------------------------------------------------
-- CALCULATED FIELDS
------------------------------------------------------------------------
    -- rsr_closed_reason
    ,CASE WHEN subquery1.rsr_closed_date IS NOT NULL THEN subquery1.rsr_req_status
          ELSE NULL
     END AS rsr_closed_reason
    -- rsr_cancelled_positions
    ,CASE WHEN subquery1.rsr_req_status IN ('Filled', 'Cancelled', 'Canceled') THEN subquery1.rsr_positions_remaining
          ELSE NULL
     END AS rsr_cancelled_positions
    ,'${dataform.projectConfig.vars.client_code}' as rsr_client_code
    -- req_aging_bd_eh
    ,Function_library${region}.f_workday(subquery1.rsr_recruiting_start_date, CURRENT_DATE()) - subquery1.days_on_hold_bd AS req_aging_bd_eh
    -- req_aging_cd_eh
    ,Function_library${region}.f_calendarday(subquery1.rsr_recruiting_start_date, CURRENT_DATE()) - subquery1.days_on_hold_cd AS req_aging_cd_eh
    -- time_to_fill_req_bd_eh
    ,Function_library${region}.f_workday(subquery1.rsr_recruiting_start_date, subquery1.filled_date) - subquery1.days_on_hold_bd AS time_to_fill_req_bd_eh
    -- time_to_fill_req_cd_eh
    ,Function_library${region}.f_calendarday(subquery1.rsr_recruiting_start_date, subquery1.filled_date) - subquery1.days_on_hold_cd AS time_to_fill_req_cd_eh
FROM (
    ------------------------------------------------------------------------
    -- CANDIDATE AGGREGATIONS CTE
    ------------------------------------------------------------------------
    WITH
    cand_aggs AS (
        SELECT stdz_cand.req_id
            -- first_cand_submitted_to_hm_date
        ,MIN(stdz_cand.cand_shortlisted_date) AS first_cand_submitted_to_hm_date
            -- cand_applied_cnt
        ,COUNT(stdz_cand.cand_submit_date) AS cand_applied_cnt
        -- cand_submitted_to_hm_cnt
        ,COUNT(stdz_cand.cand_shortlisted_date) AS cand_submitted_to_hm_cnt
        -- cand_interviewed_cnt
        ,COUNT(stdz_cand.cand_interview_date) AS cand_interviewed_cnt
        -- cand_offered_cnt
        ,COUNT(stdz_cand.cand_offer_extended_date) AS cand_offered_cnt
        -- cand_offers_accepted_cnt
        ,COUNT(stdz_cand.cand_offer_accepted_date) AS cand_offers_accepted_cnt
        -- cand_hired_cnt
        ,COUNT(stdz_cand.cand_hired_date) AS cand_hired_cnt
        FROM %s.%s stdz_cand
        GROUP BY stdz_cand.req_id
    )

    SELECT
    ------------------------------------------------------------------------
    -- STANDARD FIELDS FROM SOURCE
    ------------------------------------------------------------------------
    req.buyer
    ,req.req_id
    ,req.req_title
    ,req.req_status
    ,req.pay_details
    ,req.city
    ,req.state_province
    ,req.zip_postal_code
    ,req.country
    ,req.reason_for_req
    ,req.recruiter_name
    ,req.hiring_manager_full_name
    ,req.rsr_recruiting_start_date
    ,req.filled_date
    ,req.closed_date
    ,req.cancelled_date
    ,req.positions_requested_cnt
    ,req.positions_remaining_cnt
    ,req.positions_canceled_cnt
    ,req.req_publish_date
    ,req.currency
    -- ,req.rsr_processed_date
    ,req.rsr_staffing_entity
    ,req.labor_type
    ,req.job_grade
    ,req.business_unit

    ------------------------------------------------------------------------
    -- MAPPED FIELDS
    ------------------------------------------------------------------------
    -- rsr_labor_type
    ,CASE WHEN IFNULL(lt.rsr_labor_type, '') <> '' THEN lt.rsr_labor_type
          WHEN IFNULL(req.labor_type, '') = '' THEN 'Undisclosed'
        ELSE 'Unmapped'
     END AS rsr_labor_type
    -- client_job_grade
    ,CASE WHEN IFNULL(jg.client_job_grade, '') <> '' THEN jg.client_job_grade
          WHEN IFNULL(req.job_grade, '') = '' THEN 'Undisclosed'
        ELSE 'Unmapped'
     END AS client_job_grade
    -- client_business_unit
    ,CASE WHEN IFNULL(bu.client_business_unit, '') <> '' THEN bu.client_business_unit
          WHEN IFNULL(req.business_unit, '') = '' THEN 'Undisclosed'
        ELSE req.business_unit
     END AS client_business_unit
    -- rsr_req_status
    ,COALESCE(rsm.rsr_req_status,(CASE WHEN IFNULL(rs.rsr_req_status, '') <> '' THEN rs.rsr_req_status
          WHEN IFNULL(req.req_status, '') = '' THEN 'Undisclosed'
        ELSE 'Unmapped'
     END)) AS rsr_req_status
    -- rsr_country
    ,CASE WHEN IFNULL(gcr.rsr_country, '') <> '' THEN gcr.rsr_country
          WHEN IFNULL(req.country, '') = '' THEN 'Undisclosed'
        ELSE 'Unmapped'
     END AS rsr_country
    -- rsr_region
    ,CASE WHEN IFNULL(gcr.rsr_region, '') <> '' THEN gcr.rsr_region
          WHEN IFNULL(req.country, '') = '' THEN 'Undisclosed'
        ELSE 'Unmapped'
     END AS rsr_region
    -- rsr_state
    ,CASE WHEN IFNULL(gsm.rsr_state, '') <> '' THEN gsm.rsr_state
          WHEN IFNULL(req.state_province, '') = '' THEN 'Undisclosed'
        ELSE 'Unmapped'
     END AS rsr_state

    ------------------------------------------------------------------------
    -- CALCULATED FIELDS
    ------------------------------------------------------------------------
    -- current_date
    ,CURRENT_DATE() AS current_date
    -- req_closed_date_revised
    ,CAST(cal_map.reporting_week_date as DATE FORMAT 'MM/DD/YYYY') AS req_closed_date_revised
    -- rsr_closed_date
    ,COALESCE(req.closed_date, req.filled_date, req.cancelled_date) AS rsr_closed_date
    -- req_aging_bd_ih
    ,Function_library${region}.f_workday(req.rsr_recruiting_start_date, CURRENT_DATE()) AS req_aging_bd_ih
    -- req_aging_cd_ih
    ,Function_library${region}.f_calendarday(req.rsr_recruiting_start_date, CURRENT_DATE()) AS req_aging_cd_ih
    -- time_to_fill_req_bd_ih
    ,Function_library${region}.f_workday(req.rsr_recruiting_start_date, req.filled_date) AS time_to_fill_req_bd_ih
    -- time_to_fill_req_cd_ih
    ,Function_library${region}.f_calendarday(req.rsr_recruiting_start_date, req.filled_date) AS time_to_fill_req_cd_ih
    -- first_cand_submitted_to_hm_date
    ,cand_aggs.first_cand_submitted_to_hm_date
    -- cand_applied_cnt
    ,cand_aggs.cand_applied_cnt
    -- cand_submitted_to_hm_cnt
    ,cand_aggs.cand_submitted_to_hm_cnt
    -- cand_interviewed_cnt
    ,cand_aggs.cand_interviewed_cnt
    -- cand_offered_cnt
    ,cand_aggs.cand_offered_cnt
    -- cand_offers_accepted_cnt
    ,cand_aggs.cand_offers_accepted_cnt
    -- cand_hired_cnt
    ,cand_aggs.cand_hired_cnt
    -- time_to_submit_first_cand_to_hm
    ,Function_library${region}.f_workday(req.rsr_recruiting_start_date, cand_aggs.first_cand_submitted_to_hm_date) AS time_to_submit_first_cand_to_hm
    -- rsr_positions_remaining
    ,CASE WHEN req.positions_requested_cnt - cand_aggs.cand_hired_cnt < 0 THEN 0
          ELSE req.positions_requested_cnt - cand_aggs.cand_hired_cnt
     END AS rsr_positions_remaining
    ,CAST(COALESCE(req.days_on_hold_bd, ROUND((req.days_on_hold_cd / 7) * 5), 0) AS INT64) AS days_on_hold_bd
    ,CAST(COALESCE(req.days_on_hold_cd, ROUND((req.days_on_hold_bd / 5) * 7), 0) AS INT64) AS days_on_hold_cd
    ,req.rsr_processed_date
    ,norm_jt.suppressed_title,
        norm_jt.pii_found,
        norm_jt.process_status,
        norm_jt.suppression_type,
        norm_jt.llm_cleaned,
        norm_jt.title_cleaned,
        norm_jt.ms_category_1,
        norm_jt.ms_category_2,
        norm_jt.onet_career_pathway,
        norm_jt.onet_job_family,
        norm_jt.onet_career_cluster,
        norm_jt.onet_occupation,
        norm_jt.soc_major_group,
        norm_jt.soc_minor_group,
        norm_jt.soc_broad_group,
        norm_jt.onet_detailed_occupation,
        norm_jt.bg_categorization,
        norm_jt.tk_categorization,
        norm_jt.rand_categorization,
        norm_jt.rmi_categorization,
        norm_jt.R1_label,
        norm_jt.R2_label,
        norm_jt.R3_label,
        norm_jt.R4_label,
        norm_jt.R5_label,
        norm_jt.R6_label,
        norm_loc.location_level_1,
        norm_loc.location_level_2,
        norm_loc.location_level_3,
        norm_loc.location_level_4,
        norm_loc.location_level_5,
        norm_loc.location_level_6,
        norm_loc.location_level_7,
        norm_loc.location_level_8,
        norm_loc.location_level_1a,
        norm_loc.location_level_2a
    FROM ${slvr_dataset}.%s req
    LEFT JOIN db_common${region}.rpo_calendar_mapping cal_map ON req.closed_date = CAST(cal_map.Day as DATE FORMAT 'MM/DD/YYYY')
    LEFT JOIN db_common${region}.rpo_std_labor_type AS lt ON IFNULL(req.labor_type, '') = lt.labor_type
    LEFT JOIN db_common${region}.rpo_std_job_grade AS jg ON req.buyer = jg.buyer_code AND IFNULL(req.job_grade, '') = jg.job_grade
    LEFT JOIN db_common${region}.rpo_std_business_unit AS bu ON req.buyer = bu.buyer_code AND IFNULL(req.business_unit, '') = bu.business_unit
    LEFT JOIN db_common${region}.rpo_std_req_status AS rs ON IFNULL(req.req_status, '') = rs.req_status
    LEFT JOIN cand_aggs ON req.req_id = cand_aggs.req_id
    LEFT JOIN db_common${region}.global_countries gcr on IFNULL(lower(req.country), '') = lower(gcr.country)
    LEFT JOIN db_common${region}.global_state_mapping gsm on IFNULL(req.state_province, '') = gsm.vms_state
    LEFT JOIN db_common${region}.rpo_global_standard_value_mapping rsm on rsm.buyer_code = req.buyer and rsm.req_status=req.req_status
    LEFT JOIN db${region}_yellowdata_normalization.job_titles_${dataform.projectConfig.vars.ds_name}_normalised norm_jt on req.req_title = norm_jt.raw_job_title
    LEFT JOIN db${region}_yellowdata_normalization.locations_${dataform.projectConfig.vars.ds_name}_normalised norm_loc on COALESCE(req.city, '') = COALESCE(norm_loc.city, '') AND COALESCE((CASE 
    WHEN IFNULL(gsm.vms_state, '') <> '' THEN gsm.vms_state
    WHEN IFNULL(req.state_province, '') = '' THEN 'Undisclosed'
    ELSE 'Unmapped'
  END), '') = COALESCE(norm_loc.state, '')
  AND COALESCE(req.state_province, '') = COALESCE(norm_loc.province, '') AND COALESCE((CASE 
    WHEN IFNULL(gcr.rsr_country, '') <> '' THEN gcr.rsr_country
    WHEN IFNULL(req.country, '') = '' THEN 'Undisclosed'
    ELSE 'Unmapped'
  END), '') = COALESCE(norm_loc.country_name, '') AND COALESCE(req.country, '') = COALESCE(norm_loc.country_code, '')
    
    ) subquery1)""",gold_dataset,requisition_table_id,
    gold_dataset,slvr_ph1_r,slvr_ph2_r
    );