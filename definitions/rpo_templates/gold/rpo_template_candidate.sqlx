config {
    type: "operations",
    name: "rpo_template_candidate_gold",
    tags: 'rpo_template_gold',
    description: 'This file creates the  stdrv layer'
}

js {
    const helper = require("/includes/helper");

    const config_ds_name = helper.get_config_ds();
    const config_table_name = helper.get_config_table();
    const env = helper.get_env();
    const region = helper.get_region();
    const dataset_id = dataform.projectConfig.vars.dataset_id;

    const gold_dataset = (env == "prd") ?
        `gold_${dataset_id}` :
        `dev_gold_${dataset_id}`;

    const slvr_dataset = (env == "prd") ?
        `slvr_${dataset_id}` :
        `dev_slvr_${dataset_id}`;
    
    const slvr_ph1_c = helper.getSlvrTableName(config_ds_name, config_table_name, 'candidate_src', dataset_id);
    const slvr_ph2_c = helper.getSlvrTableName(config_ds_name, config_table_name, 'requisition_src', dataset_id);
}

DECLARE
  candidate_table_id STRING;
DECLARE
  gold_dataset STRING;
DECLARE
  slvr_dataset STRING;
DECLARE
  config_ds_name STRING;
DECLARE
  config_table_name STRING;
DECLARE
  region STRING;
DECLARE
  slvr_ph1_c STRING;
DECLARE
  slvr_ph2_c STRING;
SET
  config_ds_name = '${config_ds_name}';
SET
  config_table_name = '${config_table_name}';
SET
  region = '${region}';
SET
  gold_dataset = '${gold_dataset}';
SET
  slvr_dataset = '${slvr_dataset}';
SET 
  slvr_ph1_c = 'v_' || ${slvr_ph1_c};
SET
  slvr_ph2_c = 'v_' || ${slvr_ph2_c};
EXECUTE IMMEDIATE
  FORMAT ('''
  SELECT
  DISTINCT 't_' || table_id,
  FROM
  `%s.%s`
    WHERE entity_type = 'candidate_src' and dataset_id = '${dataform.projectConfig.vars.dataset_id}' LIMIT 1
''', config_ds_name,config_table_name) INTO candidate_table_id;
IF
  candidate_table_id IS NULL THEN RAISE
USING
  MESSAGE = 'candidate_table_id TABLE ID IS MISSING FROM CONFIGS';
END IF
  ;

EXECUTE IMMEDIATE FORMAT ("""
CREATE OR REPLACE TABLE `%s.%s` AS (
/* QUERY DOCUMENTATION
-- TYPE: candidate, single report, non-transactional
-- deduped_cand CTE de-duplicates the cand data by req_id, cand_id using rules agreed upon by BPs, Blue data, and Data Solutions
-- outermost query contains calcuations that take fields from subquery2 as input
-- subquery2 contains calculations that take fields from subquery1 as input
-- subquery1 gets the standard fields from the source, and maps fields using the standard mapping
*/
WITH deduped_cand AS (
    SELECT *
          ,ROW_NUMBER() OVER (
            PARTITION BY req_id, cand_id
            ORDER BY cand_hired_date ASC NULLS LAST
                    ,cand_offer_accepted_date ASC NULLS LAST
                    ,cand_offer_extended_date ASC NULLS LAST
                    ,cand_interview_date ASC NULLS LAST
                    ,cand_interview_scheduled_date ASC NULLS LAST
                    ,cand_shortlisted_date ASC NULLS LAST
                    ,cand_screen_date ASC NULLS LAST
                    ,cand_advisor_review_date ASC NULLS LAST
                    ,cand_submit_date ASC NULLS LAST
                    ,rsr_processed_date DESC
                    ,row_num DESC
            ) AS dedupe_rnk
    FROM (
        SELECT *
            ,ROW_NUMBER() OVER () AS row_num
        FROM ${slvr_dataset}.%s
    )
),
req_mst as (
 select  req.req_id,CASE WHEN IFNULL(gcr.rsr_country, '') <> '' THEN gcr.rsr_country
          WHEN IFNULL(req.country, '') = '' THEN 'Undisclosed'
        ELSE 'Unmapped'
     END AS rsr_country
    ,CASE WHEN IFNULL(gsm.rsr_state, '') <> '' THEN gsm.rsr_state
          WHEN IFNULL(req.state_province, '') = '' THEN 'Undisclosed'
        ELSE 'Unmapped'
     END AS rsr_state
     from
     ${slvr_dataset}.%s req
     LEFT JOIN db_common${region}.global_countries gcr on IFNULL(lower(req.country), '') = lower(gcr.country)
     LEFT JOIN db_common${region}.global_state_mapping gsm on IFNULL(req.state_province, '') = gsm.vms_state

)

SELECT DISTINCT subquery2.*
------------------------------------------------------------------------
-- CALCULATED FIELDS
------------------------------------------------------------------------
-- overall_diversity_count
,IF(1 IN UNNEST([subquery2.veteran_count, subquery2.disabled_count, subquery2.gender_count, subquery2.ethnicity_count, subquery2.race_count]), 1, 0) AS overall_diversity_count
-- overall_diversity_status
,CASE WHEN rsr_race_diverse = 'Diverse' OR rsr_ethnicity_diverse = 'Diverse' OR rsr_gender_diverse = 'Diverse' OR rsr_veteran_diverse = 'Diverse' OR rsr_disabled_diverse = 'Diverse'
        THEN 'Diverse'
    WHEN rsr_race_diverse = 'Not Diverse' AND rsr_ethnicity_diverse = 'Not Diverse' AND rsr_gender_diverse = 'Not Diverse' AND rsr_veteran_diverse = 'Not Diverse' AND rsr_disabled_diverse = 'Not Diverse'
        THEN 'Not Diverse'
    ELSE 'Undisclosed'
END AS overall_diversity_status
,'${dataform.projectConfig.vars.client_code}' as rsr_client_code
FROM (
    SELECT
    ------------------------------------------------------------------------
    -- FIELDS FROM SUBQUERY1
    ------------------------------------------------------------------------
    subquery1.buyer
    ,subquery1.req_id
    ,subquery1.cand_id
    ,subquery1.cand_name
    ,subquery1.rsr_unique_identifier
    ,subquery1.rejected_reason
    ,subquery1.cand_rejected_date
    ,subquery1.cand_withdrawn_date
    ,subquery1.withdrawn_reason
    ,subquery1.application_status
    ,subquery1.salary
    ,subquery1.cand_submit_date
    ,subquery1.cand_advisor_review_date
    ,subquery1.cand_screen_date
    ,subquery1.cand_shortlisted_date
    ,subquery1.cand_interview_scheduled_date
    ,subquery1.cand_interview_date
    ,subquery1.cand_offer_extended_date
    ,subquery1.cand_offer_accepted_date
    ,subquery1.cand_hired_date
    ,subquery1.internal_external
    ,subquery1.source_detail
    ,subquery1.race
    ,subquery1.ethnicity
    ,subquery1.gender
    ,subquery1.disabled
    ,subquery1.veteran
    ,subquery1.current_date
    ,subquery1.rsr_staffing_entity
    ,subquery1.rsr_source
    ,subquery1.rsr_source_detail
    ,subquery1.rsr_internal_external
    ,subquery1.rsr_race
    ,subquery1.rsr_ethnicity
    ,subquery1.rsr_gender
    ,subquery1.rsr_disabled
    ,subquery1.rsr_veteran

    ------------------------------------------------------------------------
    -- MAPPED FIELDS
    ------------------------------------------------------------------------
    -- rsr_race_diverse
    ,rd.rsr_race_diverse
    -- rsr_ethnicity_diverse
    ,ed.rsr_ethnicity_diverse
    -- rsr_gender_diverse
    ,gd.rsr_gender_diverse
    -- rsr_disabled_diverse
    ,dd.rsr_disabled_diverse
    -- rsr_veteran_diverse
    ,vd.rsr_veteran_diverse

    ------------------------------------------------------------------------
    -- CALCULATED FIELDS
    ------------------------------------------------------------------------
    -- time_to_submit_to_hm
    ,Function_library${region}.f_workday(subquery1.rsr_recruiting_start_date, subquery1.cand_shortlisted_date) AS time_to_submit_to_hm
    -- time_to_hire_bd_eh
    ,Function_library${region}.f_workday(subquery1.rsr_recruiting_start_date, subquery1.cand_hired_date) - IFNULL(subquery1.days_on_hold_bd, 0) AS time_to_hire_bd_eh
    -- time_to_offer_bd_eh
    ,Function_library${region}.f_workday(subquery1.rsr_recruiting_start_date, subquery1.cand_offer_extended_date) - IFNULL(subquery1.days_on_hold_bd, 0) AS time_to_offer_bd_eh
    -- time_to_offer_accept_bd_eh
    ,Function_library${region}.f_workday(subquery1.rsr_recruiting_start_date, subquery1.cand_offer_accepted_date) - IFNULL(subquery1.days_on_hold_bd, 0) AS time_to_offer_accept_bd_eh
    -- time_to_hire_cd_eh
    ,Function_library${region}.f_calendarday(subquery1.rsr_recruiting_start_date, subquery1.cand_hired_date) - IFNULL(subquery1.days_on_hold_cd, 0) AS time_to_hire_cd_eh
    -- time_to_offer_cd_eh
    ,Function_library${region}.f_calendarday(subquery1.rsr_recruiting_start_date, subquery1.cand_offer_extended_date) - IFNULL(subquery1.days_on_hold_cd, 0) AS time_to_offer_cd_eh
    -- time_to_offer_accept_cd_eh
    ,Function_library${region}.f_calendarday(subquery1.rsr_recruiting_start_date, subquery1.cand_offer_accepted_date) - IFNULL(subquery1.days_on_hold_cd, 0) AS time_to_offer_accept_cd_eh
    -- time_to_hire_bd_ih
    ,Function_library${region}.f_workday(subquery1.rsr_recruiting_start_date, subquery1.cand_hired_date) AS time_to_hire_bd_ih
    -- time_to_offer_bd_ih
    ,Function_library${region}.f_workday(subquery1.rsr_recruiting_start_date, subquery1.cand_offer_extended_date) AS time_to_offer_bd_ih
    -- time_to_offer_accept_bd_ih
    ,Function_library${region}.f_workday(subquery1.rsr_recruiting_start_date, subquery1.cand_offer_accepted_date) AS time_to_offer_accept_bd_ih
    -- time_to_hire_cd_ih
    ,Function_library${region}.f_calendarday(subquery1.rsr_recruiting_start_date, subquery1.cand_hired_date) AS time_to_hire_cd_ih
    -- time_to_offer_cd_ih
    ,Function_library${region}.f_calendarday(subquery1.rsr_recruiting_start_date, subquery1.cand_offer_extended_date) AS time_to_offer_cd_ih
    -- time_to_offer_accept_cd_ih
    ,Function_library${region}.f_calendarday(subquery1.rsr_recruiting_start_date, subquery1.cand_offer_accepted_date) AS time_to_offer_accept_cd_ih
    -- time_new_cand_to_hm_review
    ,Function_library${region}.f_workday(subquery1.cand_submit_date, subquery1.cand_shortlisted_date) AS time_new_cand_to_hm_review
    -- time_new_cand_to_offer_accept
    ,Function_library${region}.f_workday(subquery1.cand_submit_date, subquery1.cand_offer_accepted_date) AS time_new_cand_to_offer_accept
    -- time_new_cand_to_hire
    ,Function_library${region}.f_workday(subquery1.cand_submit_date, subquery1.cand_hired_date) AS time_new_cand_to_hire
    -- time_new_cand_to_offer
    ,Function_library${region}.f_workday(subquery1.cand_submit_date, subquery1.cand_offer_extended_date) AS time_new_cand_to_offer
    -- dwell_time_new_cand_to_talent_advisor_review
    ,Function_library${region}.f_workday(subquery1.cand_submit_date, subquery1.cand_advisor_review_date) AS dwell_time_new_cand_to_talent_advisor_review
    -- dwell_time_talent_advisor_review_to_screen_cand
    ,Function_library${region}.f_workday(subquery1.cand_advisor_review_date, subquery1.cand_screen_date) AS dwell_time_talent_advisor_review_to_screen_cand
    -- dwell_time_screen_cand_to_hm_review
    ,Function_library${region}.f_workday(subquery1.cand_screen_date, subquery1.cand_shortlisted_date) AS dwell_time_screen_cand_to_hm_review
    -- dwell_time_hm_review_to_interview
    ,Function_library${region}.f_workday(subquery1.cand_shortlisted_date, subquery1.cand_interview_date) AS dwell_time_hm_review_to_interview
    -- dwell_time_interview_to_offer_extended
    ,Function_library${region}.f_workday(subquery1.cand_interview_date, subquery1.cand_offer_extended_date) AS dwell_time_interview_to_offer_extended
    -- dwell_time_offer_extended_offer_accepted
    ,Function_library${region}.f_workday(subquery1.cand_offer_extended_date, subquery1.cand_offer_accepted_date) AS dwell_time_offer_extended_offer_accepted
    -- agency_usage_candidate
    ,CASE WHEN subquery1.rsr_source = 'Agency' THEN 1 ELSE 0 END AS agency_usage_candidate
    -- veteran_count
    ,CASE WHEN vd.rsr_veteran_diverse = 'Diverse' THEN 1 ELSE 0 END AS veteran_count
    -- disabled_count
    ,CASE WHEN dd.rsr_disabled_diverse = 'Diverse' THEN 1 ELSE 0 END AS disabled_count
    -- gender_count
    ,CASE WHEN gd.rsr_gender_diverse = 'Diverse' THEN 1 ELSE 0 END AS gender_count
    -- ethnicity_count
    ,CASE WHEN ed.rsr_ethnicity_diverse = 'Diverse' THEN 1 ELSE 0 END AS ethnicity_count
    -- race_count
    ,CASE WHEN rd.rsr_race_diverse = 'Diverse' THEN 1 ELSE 0 END AS race_count
    ,subquery1.recruiter_name
    ,subquery1.rsr_processed_date
    , subquery1.rsr_req_country
        ,subquery1.rsr_req_state
        ,subquery1.req_title
        ,subquery1.req_city
        ,subquery1.req_state_province
        ,subquery1.req_zip_postal_code
        ,subquery1.req_country
        ,subquery1.suppressed_title,
        subquery1.pii_found,
        subquery1.process_status,
        subquery1.suppression_type,
        subquery1.llm_cleaned,
        subquery1.title_cleaned,
        subquery1.ms_category_1,
        subquery1.ms_category_2,
        subquery1.onet_career_pathway,
        subquery1.onet_job_family,
        subquery1.onet_career_cluster,
        subquery1.onet_occupation,
        subquery1.soc_major_group,
        subquery1.soc_minor_group,
        subquery1.soc_broad_group,
        subquery1.onet_detailed_occupation,
        subquery1.bg_categorization,
        subquery1.tk_categorization,
        subquery1.rand_categorization,
        subquery1.rmi_categorization,
        subquery1.R1_label,
        subquery1.R2_label,
        subquery1.R3_label,
        subquery1.R4_label,
        subquery1.R5_label,
        subquery1.R6_label,
        subquery1.location_level_1,
        subquery1.location_level_2,
        subquery1.location_level_3,
        subquery1.location_level_4,
        subquery1.location_level_5,
        subquery1.location_level_6,
        subquery1.location_level_7,
        subquery1.location_level_8,
        subquery1.location_level_1a,
        subquery1.location_level_2a




    FROM (
        SELECT
        ------------------------------------------------------------------------
        -- STANDARD FIELDS FROM SOURCE
        ------------------------------------------------------------------------
        cand.buyer
        ,cand.req_id
        ,cand.cand_id
        ,cand.cand_name
        ,cand.rsr_unique_identifier
        ,cand.rejected_reason
        ,cand.cand_rejected_date
        ,cand.cand_withdrawn_date
        ,cand.withdrawn_reason
        ,cand.salary
        ,req.rsr_recruiting_start_date
        ,cand.cand_advisor_review_date
        ,cand.cand_hired_date
        ,cand.cand_interview_date
        ,cand.cand_interview_scheduled_date
        ,cand.cand_offer_accepted_date
        ,cand.cand_offer_extended_date
        ,cand.cand_screen_date
        ,cand.cand_shortlisted_date
        ,cand.cand_submit_date
        ,cand.application_status
        -- ,cand.rsr_processed_date
        ,cand.rsr_staffing_entity
        ,cand.source_detail
        ,cand.internal_external
        ,cand.race
        ,cand.ethnicity
        ,cand.gender
        ,cand.disabled
        ,cand.veteran

        ------------------------------------------------------------------------
        -- MAPPED FIELDS
        ------------------------------------------------------------------------
        -- rsr_source
        ,CASE WHEN IFNULL(sd.rsr_source, '') <> '' THEN sd.rsr_source
              WHEN IFNULL(cand.source_detail, '') = '' THEN 'Undisclosed'
            ELSE 'Unmapped'
         END AS rsr_source
        -- rsr_source_detail
        ,CASE WHEN IFNULL(sd.rsr_source_detail, '') <> '' THEN sd.rsr_source_detail
              WHEN IFNULL(cand.source_detail, '') = '' THEN 'Undisclosed'
            ELSE 'Unmapped'
         END AS rsr_source_detail
        -- rsr_internal_external
        ,CASE WHEN IFNULL(ie.rsr_internal_external, '') <> '' THEN ie.rsr_internal_external
              WHEN IFNULL(cand.internal_external, '') = '' THEN 'Undisclosed'
            ELSE 'Unmapped'
         END AS rsr_internal_external
        -- rsr_race
        ,CASE WHEN IFNULL(r.rsr_race, '') <> '' THEN r.rsr_race
              WHEN IFNULL(cand.race, '') = '' THEN 'Undisclosed'
            ELSE 'Unmapped'
         END AS rsr_race
        -- rsr_ethnicity
        ,CASE WHEN IFNULL(e.rsr_ethnicity, '') <> '' THEN e.rsr_ethnicity
              WHEN IFNULL(cand.ethnicity, '') = '' THEN 'Undisclosed'
            ELSE 'Unmapped'
         END AS rsr_ethnicity
        -- rsr_gender
        ,CASE WHEN IFNULL(g.rsr_gender, '') <> '' THEN g.rsr_gender
              WHEN IFNULL(cand.gender, '') = '' THEN 'Undisclosed'
            ELSE 'Unmapped'
         END AS rsr_gender
        -- rsr_disabled
        ,CASE WHEN IFNULL(d.rsr_disabled, '') <> '' THEN d.rsr_disabled
              WHEN IFNULL(cand.disabled, '') = '' THEN 'Undisclosed'
            ELSE 'Unmapped'
         END AS rsr_disabled
        -- rsr_veteran
        ,CASE WHEN IFNULL(v.rsr_veteran, '') <> '' THEN v.rsr_veteran
              WHEN IFNULL(cand.veteran, '') = '' THEN 'Undisclosed'
            ELSE 'Unmapped'
         END AS rsr_veteran

        ------------------------------------------------------------------------
        -- CALCULATED FIELDS
        ------------------------------------------------------------------------
        -- current_date
        ,CURRENT_DATE() AS current_date
        ,CAST(COALESCE(req.days_on_hold_bd, ROUND((req.days_on_hold_cd / 7) * 5), 0) AS INT64) AS days_on_hold_bd
        ,CAST(COALESCE(req.days_on_hold_cd, ROUND((req.days_on_hold_bd / 5) * 7), 0) AS INT64) AS days_on_hold_cd
        ,req.recruiter_name
        ,req.rsr_processed_date
        ,req_mst.rsr_country as rsr_req_country
        ,req_mst.rsr_state as rsr_req_state
        ,req.req_title
        ,req.city as req_city
        ,req.state_province as req_state_province
        ,req.zip_postal_code as req_zip_postal_code
        ,	req.country as 	req_country,
        norm_jt.suppressed_title,
        norm_jt.pii_found,
        norm_jt.process_status,
        norm_jt.suppression_type,
        norm_jt.llm_cleaned,
        norm_jt.title_cleaned,
        norm_jt.ms_category_1,
        norm_jt.ms_category_2,
        norm_jt.onet_career_pathway,
        norm_jt.onet_job_family,
        norm_jt.onet_career_cluster,
        norm_jt.onet_occupation,
        norm_jt.soc_major_group,
        norm_jt.soc_minor_group,
        norm_jt.soc_broad_group,
        norm_jt.onet_detailed_occupation,
        norm_jt.bg_categorization,
        norm_jt.tk_categorization,
        norm_jt.rand_categorization,
        norm_jt.rmi_categorization,
        norm_jt.R1_label,
        norm_jt.R2_label,
        norm_jt.R3_label,
        norm_jt.R4_label,
        norm_jt.R5_label,
        norm_jt.R6_label,
        norm_loc.location_level_1,
        norm_loc.location_level_2,
        norm_loc.location_level_3,
        norm_loc.location_level_4,
        norm_loc.location_level_5,
        norm_loc.location_level_6,
        norm_loc.location_level_7,
        norm_loc.location_level_8,
        norm_loc.location_level_1a,
        norm_loc.location_level_2a
        FROM deduped_cand cand
        LEFT JOIN ${slvr_dataset}.%s req ON cand.req_id = req.req_id
        LEFT JOIN req_mst ON cand.req_id = req_mst.req_id
        LEFT JOIN db_common${region}.rpo_std_source_detail sd ON IFNULL(cand.source_detail, '') = sd.source_detail
        LEFT JOIN db_common${region}.rpo_std_internal_external ie ON IFNULL(cand.internal_external, '') = ie.internal_external
        LEFT JOIN db_common${region}.rpo_std_race r ON IFNULL(cand.race, '') = r.race
        LEFT JOIN db_common${region}.rpo_std_ethnicity e ON IFNULL(cand.ethnicity, '') = e.ethnicity
        LEFT JOIN db_common${region}.rpo_std_gender g ON IFNULL(cand.gender, '') = g.gender
        LEFT JOIN db_common${region}.rpo_std_disabled d ON IFNULL(cand.disabled, '') = d.disabled
        LEFT JOIN db_common${region}.rpo_std_veteran v ON IFNULL(cand.veteran, '') = v.veteran
       LEFT JOIN db${region}_yellowdata_normalization.job_titles_${dataform.projectConfig.vars.ds_name}_normalised norm_jt on req.req_title = norm_jt.raw_job_title
       LEFT JOIN db${region}_yellowdata_normalization.locations_${dataform.projectConfig.vars.ds_name}_normalised norm_loc on COALESCE(req.city, '') = COALESCE(norm_loc.city, '') AND COALESCE(req_mst.rsr_state, '') = COALESCE(norm_loc.state, '')
  AND COALESCE(req.state_province, '') = COALESCE(norm_loc.province, '') AND COALESCE(req_mst.rsr_country, '') = COALESCE(norm_loc.country_name, '') AND COALESCE(req.country, '') = COALESCE(norm_loc.country_code, '')

        WHERE cand.dedupe_rnk = 1
        ) subquery1
    LEFT JOIN db_common${region}.rpo_std_race_diverse rd ON subquery1.rsr_race = rd.rsr_race
    LEFT JOIN db_common${region}.rpo_std_ethnicity_diverse ed ON subquery1.rsr_ethnicity = ed.rsr_ethnicity
    LEFT JOIN db_common${region}.rpo_std_gender_diverse gd ON subquery1.rsr_gender = gd.rsr_gender
    LEFT JOIN db_common${region}.rpo_std_disabled_diverse dd ON subquery1.rsr_disabled = dd.rsr_disabled
    LEFT JOIN db_common${region}.rpo_std_veteran_diverse vd ON subquery1.rsr_veteran = vd.rsr_veteran
    ) subquery2)""",gold_dataset,candidate_table_id,slvr_ph1_c,slvr_ph2_c,slvr_ph2_c);