config {
    type: "table",
    name: "rpo_template_requisition",
    tags: 'rpo_template',
    description: 'This file creates the  stdrv layer'
}
CREATE OR REPLACE TABLE `${dataform.projectConfig.vars.ds_name}.stdrv_requisition_${dataform.projectConfig.vars.client_code}_dform_test` AS (
/* QUERY DOCUMENTATION
-- TYPE: requisition, non-transactional
-- outermost query contains calcuations that take fields from subquery1 as input
-- subquery1 gets the standard fields from the source, maps fields using the
standard mapping, calculates fields using source fields, and retrieves aggregations
from candidate stdz table
*/
SELECT DISTINCT subquery1.*
------------------------------------------------------------------------
-- CALCULATED FIELDS
------------------------------------------------------------------------
    -- rsr_closed_reason
    ,CASE WHEN subquery1.rsr_closed_date IS NOT NULL THEN subquery1.rsr_req_status
          ELSE NULL
     END AS rsr_closed_reason
    -- rsr_cancelled_positions
    ,CASE WHEN subquery1.rsr_req_status IN ('Filled', 'Cancelled', 'Canceled') THEN subquery1.rsr_positions_remaining
          ELSE NULL
     END AS rsr_cancelled_positions
    ,'${dataform.projectConfig.vars.client_code}' as rsr_client_code
    -- req_aging_bd_eh
    ,Function_library${dataform.projectConfig.vars.region}.f_workday(subquery1.rsr_recruiting_start_date, CURRENT_DATE()) - subquery1.days_on_hold_bd AS req_aging_bd_eh
    -- req_aging_cd_eh
    ,Function_library${dataform.projectConfig.vars.region}.f_calendarday(subquery1.rsr_recruiting_start_date, CURRENT_DATE()) - subquery1.days_on_hold_cd AS req_aging_cd_eh
    -- time_to_fill_req_bd_eh
    ,Function_library${dataform.projectConfig.vars.region}.f_workday(subquery1.rsr_recruiting_start_date, subquery1.filled_date) - subquery1.days_on_hold_bd AS time_to_fill_req_bd_eh
    -- time_to_fill_req_cd_eh
    ,Function_library${dataform.projectConfig.vars.region}.f_calendarday(subquery1.rsr_recruiting_start_date, subquery1.filled_date) - subquery1.days_on_hold_cd AS time_to_fill_req_cd_eh
FROM (
    ------------------------------------------------------------------------
    -- CANDIDATE AGGREGATIONS CTE
    ------------------------------------------------------------------------
    WITH
    cand_aggs AS (
        SELECT stdz_cand.req_id
            -- first_cand_submitted_to_hm_date
        ,MIN(stdz_cand.cand_shortlisted_date) AS first_cand_submitted_to_hm_date
            -- cand_applied_cnt
        ,COUNT(stdz_cand.cand_submit_date) AS cand_applied_cnt
        -- cand_submitted_to_hm_cnt
        ,COUNT(stdz_cand.cand_shortlisted_date) AS cand_submitted_to_hm_cnt
        -- cand_interviewed_cnt
        ,COUNT(stdz_cand.cand_interview_date) AS cand_interviewed_cnt
        -- cand_offered_cnt
        ,COUNT(stdz_cand.cand_offer_extended_date) AS cand_offered_cnt
        -- cand_offers_accepted_cnt
        ,COUNT(stdz_cand.cand_offer_accepted_date) AS cand_offers_accepted_cnt
        -- cand_hired_cnt
        ,COUNT(stdz_cand.cand_hired_date) AS cand_hired_cnt
        FROM ${dataform.projectConfig.vars.ds_name}.${dataform.projectConfig.vars.ph1} stdz_cand
        GROUP BY stdz_cand.req_id
    )

    SELECT
    ------------------------------------------------------------------------
    -- STANDARD FIELDS FROM SOURCE
    ------------------------------------------------------------------------
    req.buyer
    ,req.req_id
    ,req.req_title
    ,req.req_status
    ,req.pay_details
    ,req.city
    ,req.state_province
    ,req.zip_postal_code
    ,req.country
    ,req.reason_for_req
    ,req.recruiter_name
    ,req.hiring_manager_full_name
    ,req.rsr_recruiting_start_date
    ,req.filled_date
    ,req.closed_date
    ,req.cancelled_date
    ,req.positions_requested_cnt
    ,req.positions_remaining_cnt
    ,req.positions_canceled_cnt
    ,req.req_publish_date
    ,req.currency
    -- ,req.rsr_processed_date
    ,req.rsr_staffing_entity
    ,req.labor_type
    ,req.job_grade
    ,req.business_unit

    ------------------------------------------------------------------------
    -- MAPPED FIELDS
    ------------------------------------------------------------------------
    -- rsr_labor_type
    ,CASE WHEN IFNULL(lt.rsr_labor_type, '') <> '' THEN lt.rsr_labor_type
          WHEN IFNULL(req.labor_type, '') = '' THEN 'Undisclosed'
        ELSE 'Unmapped'
     END AS rsr_labor_type
    -- client_job_grade
    ,CASE WHEN IFNULL(jg.client_job_grade, '') <> '' THEN jg.client_job_grade
          WHEN IFNULL(req.job_grade, '') = '' THEN 'Undisclosed'
        ELSE 'Unmapped'
     END AS client_job_grade
    -- client_business_unit
    ,CASE WHEN IFNULL(bu.client_business_unit, '') <> '' THEN bu.client_business_unit
          WHEN IFNULL(req.business_unit, '') = '' THEN 'Undisclosed'
        ELSE req.business_unit
     END AS client_business_unit
    -- rsr_req_status
    ,COALESCE(rsm.rsr_req_status,(CASE WHEN IFNULL(rs.rsr_req_status, '') <> '' THEN rs.rsr_req_status
          WHEN IFNULL(req.req_status, '') = '' THEN 'Undisclosed'
        ELSE 'Unmapped'
     END)) AS rsr_req_status
    -- rsr_country
    ,CASE WHEN IFNULL(gcr.rsr_country, '') <> '' THEN gcr.rsr_country
          WHEN IFNULL(req.country, '') = '' THEN 'Undisclosed'
        ELSE 'Unmapped'
     END AS rsr_country
    -- rsr_region
    ,CASE WHEN IFNULL(gcr.rsr_region, '') <> '' THEN gcr.rsr_region
          WHEN IFNULL(req.country, '') = '' THEN 'Undisclosed'
        ELSE 'Unmapped'
     END AS rsr_region
    -- rsr_state
    ,CASE WHEN IFNULL(gsm.rsr_state, '') <> '' THEN gsm.rsr_state
          WHEN IFNULL(req.state_province, '') = '' THEN 'Undisclosed'
        ELSE 'Unmapped'
     END AS rsr_state

    ------------------------------------------------------------------------
    -- CALCULATED FIELDS
    ------------------------------------------------------------------------
    -- current_date
    ,CURRENT_DATE() AS current_date
    -- req_closed_date_revised
    ,CAST(cal_map.reporting_week_date as DATE FORMAT 'MM/DD/YYYY') AS req_closed_date_revised
    -- rsr_closed_date
    ,COALESCE(req.closed_date, req.filled_date, req.cancelled_date) AS rsr_closed_date
    -- req_aging_bd_ih
    ,Function_library${dataform.projectConfig.vars.region}.f_workday(req.rsr_recruiting_start_date, CURRENT_DATE()) AS req_aging_bd_ih
    -- req_aging_cd_ih
    ,Function_library${dataform.projectConfig.vars.region}.f_calendarday(req.rsr_recruiting_start_date, CURRENT_DATE()) AS req_aging_cd_ih
    -- time_to_fill_req_bd_ih
    ,Function_library${dataform.projectConfig.vars.region}.f_workday(req.rsr_recruiting_start_date, req.filled_date) AS time_to_fill_req_bd_ih
    -- time_to_fill_req_cd_ih
    ,Function_library${dataform.projectConfig.vars.region}.f_calendarday(req.rsr_recruiting_start_date, req.filled_date) AS time_to_fill_req_cd_ih
    -- first_cand_submitted_to_hm_date
    ,cand_aggs.first_cand_submitted_to_hm_date
    -- cand_applied_cnt
    ,cand_aggs.cand_applied_cnt
    -- cand_submitted_to_hm_cnt
    ,cand_aggs.cand_submitted_to_hm_cnt
    -- cand_interviewed_cnt
    ,cand_aggs.cand_interviewed_cnt
    -- cand_offered_cnt
    ,cand_aggs.cand_offered_cnt
    -- cand_offers_accepted_cnt
    ,cand_aggs.cand_offers_accepted_cnt
    -- cand_hired_cnt
    ,cand_aggs.cand_hired_cnt
    -- time_to_submit_first_cand_to_hm
    ,Function_library${dataform.projectConfig.vars.region}.f_workday(req.rsr_recruiting_start_date, cand_aggs.first_cand_submitted_to_hm_date) AS time_to_submit_first_cand_to_hm
    -- rsr_positions_remaining
    ,CASE WHEN req.positions_requested_cnt - cand_aggs.cand_hired_cnt < 0 THEN 0
          ELSE req.positions_requested_cnt - cand_aggs.cand_hired_cnt
     END AS rsr_positions_remaining
    ,CAST(COALESCE(req.days_on_hold_bd, ROUND((req.days_on_hold_cd / 7) * 5), 0) AS INT64) AS days_on_hold_bd
    ,CAST(COALESCE(req.days_on_hold_cd, ROUND((req.days_on_hold_bd / 5) * 7), 0) AS INT64) AS days_on_hold_cd
    ,req.rsr_processed_date

    FROM ${dataform.projectConfig.vars.ds_name}.${dataform.projectConfig.vars.ph2} req
    LEFT JOIN db_common${dataform.projectConfig.vars.region}.rpo_calendar_mapping cal_map ON req.closed_date = CAST(cal_map.Day as DATE FORMAT 'MM/DD/YYYY')
    LEFT JOIN db_common${dataform.projectConfig.vars.region}.rpo_std_labor_type AS lt ON IFNULL(req.labor_type, '') = lt.labor_type
    LEFT JOIN db_common${dataform.projectConfig.vars.region}.rpo_std_job_grade AS jg ON req.buyer = jg.buyer_code AND IFNULL(req.job_grade, '') = jg.job_grade
    LEFT JOIN db_common${dataform.projectConfig.vars.region}.rpo_std_business_unit AS bu ON req.buyer = bu.buyer_code AND IFNULL(req.business_unit, '') = bu.business_unit
    LEFT JOIN db_common${dataform.projectConfig.vars.region}.rpo_std_req_status AS rs ON IFNULL(req.req_status, '') = rs.req_status
    LEFT JOIN cand_aggs ON req.req_id = cand_aggs.req_id
    LEFT JOIN db_common${dataform.projectConfig.vars.region}.global_countries gcr on IFNULL(lower(req.country), '') = lower(gcr.country)
    LEFT JOIN db_common${dataform.projectConfig.vars.region}.global_state_mapping gsm on IFNULL(req.state_province, '') = gsm.vms_state
    LEFT JOIN db_common${dataform.projectConfig.vars.region}.rpo_global_standard_value_mapping rsm on rsm.buyer_code = req.buyer and rsm.req_status=req.req_status
    ) subquery1
)
