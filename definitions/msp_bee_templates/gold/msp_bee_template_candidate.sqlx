config {
    type: "operations",
    name: "msp_bee_template_candidate_gold",
    dependencies: ["msp_bee_template_requisition_gold", "msp_bee_template_assignment_gold"],
    description: 'This file creates the  stdrv layer ',
    tags: 'msp_bee_template_gold'
}


js {
    const helper = require("/includes/helper");
	const source_builder = require("/includes/resilient_source");

    const config_ds_name = helper.get_config_ds();
    const config_table_name = helper.get_config_table();
    const env = helper.get_env();
    const region = helper.get_region();
    const dataset_id = dataform.projectConfig.vars.dataset_id;

    const gold_dataset = (env == "prd") ?
        `gold_${dataset_id}` :
        `dev_gold_${dataset_id}`;

    const slvr_dataset = (env == "prd") ?
        `slvr_${dataset_id}` :
        `dev_slvr_${dataset_id}`;

    const slvr_cand = helper.getSlvrTableName(config_ds_name, config_table_name, 'candidate_src', dataset_id);
    const slvr_req_dist = helper.getSlvrTableName(config_ds_name, config_table_name, 'requisition_distribution_src', dataset_id);
}

DECLARE
  resilient_cand_cte_sql STRING;
DECLARE
  resilient_req_dist_cte_sql STRING;
DECLARE
  candidate_table_id STRING;
DECLARE
  requisition_table_id STRING;
DECLARE
  assignment_table_id STRING;
DECLARE
  gold_dataset STRING;
DECLARE
  slvr_dataset STRING;
DECLARE
  config_ds_name STRING;
DECLARE
  config_table_name STRING;
DECLARE
  region STRING;
DECLARE
  slvr_req_dist STRING;
DECLARE
  slvr_cand STRING;
--  Declare temporary variables to hold the query strings
DECLARE cand_query STRING;
DECLARE req_dist_query STRING;
SET
  config_ds_name = '${config_ds_name}';
SET
  config_table_name = '${config_table_name}';
SET
  region = '${region}';
SET
  gold_dataset = '${gold_dataset}';
SET
  slvr_dataset = '${slvr_dataset}';
SET
  slvr_req_dist= 'v_' || ${slvr_req_dist};
SET
  slvr_cand= 'v_' || ${slvr_cand};

SET candidate_table_id="stdrv_candidate_" || '${dataform.projectConfig.vars.client_code}';
SET requisition_table_id="stdrv_requisition_" || '${dataform.projectConfig.vars.client_code}';
SET assignment_table_id="stdrv_assignment_" || '${dataform.projectConfig.vars.client_code}';

SET cand_query = """${source_builder.resilient_source(slvr_cand, slvr_dataset, 'shubham_test_eu.ext_gold_schema_registry', 'cand', 'gold_candidate','bee')}""";
SET req_dist_query = """${source_builder.resilient_source(slvr_req_dist, slvr_dataset, 'shubham_test_eu.ext_gold_schema_registry', 'req_dist', 'gold_candidate','bee')}""";

-- Execute the variables into your CTE strings
EXECUTE IMMEDIATE cand_query INTO resilient_cand_cte_sql;
EXECUTE IMMEDIATE req_dist_query INTO resilient_req_dist_cte_sql;
  
EXECUTE IMMEDIATE
FORMAT ("""
CREATE OR REPLACE TABLE
  %s.%s AS (
WITH resilient_cand AS (SELECT %s FROM %s.%s AS T_SOURCE),
resilient_req_dist AS (SELECT %s FROM %s.%s AS T_SOURCE),
js_assingment_data as (select 
				js_in.buyer
				,js_in.buyer_code
				,js_in.req_id
				,js_in.cand_id
				,js_in.cand_name
				,js_in.supplier
				,js_in.cand_status
				,js_in.cand_submit_date
				,js_in.cand_withdraw_reason as withdrawn_reason 
				,js_in.cand_rejected_reason as rejected_reason
				,js_in.currency
				,js_in.cand_available_date
				,js_in.cand_buyer_first_viewed_date
				,js_in.cand_first_interview_date as cand_first_interviewed_date
				,js_in.cand_first_submit_date as cand_first_submitted_date
				,js_in.cand_first_interview_date as cand_last_interviewed_date
				,js_in.cand_last_modified_date
				,js_in.cand_rejected_date
				,js_in.cand_shortlisted_date
				,js_in.cand_unshortlisted_date
				,js_in.cand_withdraw_date as cand_withdrawn_date
				,js_in.assignment_activation_date
				,assingment_in.assignment_create_date_initial as cand_offer_extended_date
				,js_in.location
				,js_in.site_code
				,js_in.site
				,js_in.cand_code
				,js_in.msp_code
				,js_in.msp_company
				,case when LOWER(js_in.presented_bill_rate_st_basis) = 'hourly' then js_in.presented_bill_rate
					when LOWER(js_in.presented_bill_rate_st_basis) = 'daily' then (js_in.presented_bill_rate /(req.hours_per_week/req.days_per_week))
					when LOWER(js_in.presented_bill_rate_st_basis) = 'monthly' then (js_in.presented_bill_rate /((req.hours_per_week/req.days_per_week)*4.33))
					when LOWER(js_in.presented_bill_rate_st_basis) = 'weekly' then (js_in.presented_bill_rate /(req.hours_per_week))
				end as presented_bill_rate_st_hr
				,js_in.presented_bill_rate_supplier_st_hr
				,case when LOWER(js_in.presented_bill_rate_st_basis) = 'hourly' then js_in.presented_pay_rate
					when LOWER(js_in.presented_bill_rate_st_basis) = 'daily' then (js_in.presented_pay_rate /(req.hours_per_week/req.days_per_week))
					when LOWER(js_in.presented_bill_rate_st_basis) = 'monthly' then (js_in.presented_pay_rate /((req.hours_per_week/req.days_per_week)*4.33))
					when LOWER(js_in.presented_bill_rate_st_basis) = 'weekly' then (js_in.presented_pay_rate /(req.hours_per_week))
				end as presented_pay_rate_st_hr
				,js_in.supplier_code
				,js_in.uploaded
				,assingment_in.assignment_create_date_initial
				,assingment_in.assignment_activation_date_initial
				 ,assingment_in.sourcing_type_wk_mapped
				 ,assingment_in.sourcing_type_wo_mapped
				,assingment_in.cand_offer_accepted_date--cast(null as date) as cand_offer_accepted_date--assingment_in.cand_offer_accepted_date
				,req.req_title
				,req.req_type
				,req.max_requested_bill_rate_st_hr
				,req.max_requested_pay_rate_st_hr
				,req.min_requested_bill_rate_st_hr
				,req.min_requested_pay_rate_st_hr
				,req.labor_type
				,req.req_status
				,req.site as req_site
				,req.site_code as req_site_code
				,req.location AS req_location
				,req.city as req_city
				,req.state_province as req_state_province
				,req.country as req_country
				,req.req_approved_date
				,req.req_closed_date
				,req.req_create_date
				,req.req_end_date
				,req.req_submitted_date
				,req.req_coordinator_name
				,req.positions_requested_cnt
				,req.rsr_state
				,req.rsr_country
				,req.rsr_labor_type
				,req.rsr_region
				,req.business_unit_code
				,req.business_unit
				,req.currency as req_currency --null as req_currency
				,req.hours_per_day
				,req.hours_per_week
				,req.max_template_bill_rate_st_hr
				,req.rsr_req_status
				,req.primary_cost_center
				,req.rsr_sourced_type
				,js_in.updated_ts as rsr_processed_date
				,js_in.rsr_staffing_entity -- winter_release 2025
				,assingment_in.worker_start_date
				from resilient_cand js_in
				left join %s.%s assingment_in ON js_in.buyer = assingment_in.buyer AND js_in.cand_id= assingment_in.cand_id and js_in.req_id = assingment_in.main_document_id
				left join %s.%s  req on js_in.buyer = req.buyer AND js_in .req_id= req.req_id
				)
,fx_rates AS (
  SELECT
      CAST(fx_rate AS FLOAT64) AS fx_rate,
      from_currency,
      PARSE_DATE("%%Y-%%m-%%d", month) AS month,
      to_currency
    FROM
      db_common${region}.global_fx_rates
)
,req_dist_data AS (
	SELECT buyer_code
		  ,supplier_code
		  ,req_id
		  ,MIN(req_distribution_date) AS min_req_dist_date
	FROM resilient_req_dist
	GROUP BY buyer_code, supplier_code, req_id
)

SELECT
candidate_assingment_req.buyer
,candidate_assingment_req.buyer_code
,candidate_assingment_req.req_id
,candidate_assingment_req.cand_id
,candidate_assingment_req.cand_name
,candidate_assingment_req.supplier
,candidate_assingment_req.cand_status
,candidate_assingment_req.cand_submit_date
,candidate_assingment_req.withdrawn_reason
,candidate_assingment_req.rejected_reason
,candidate_assingment_req.business_unit_code
,candidate_assingment_req.business_unit
,candidate_assingment_req.currency
,candidate_assingment_req.req_currency
,candidate_assingment_req.cand_available_date
,candidate_assingment_req.cand_buyer_first_viewed_date
,candidate_assingment_req.cand_first_interviewed_date
,candidate_assingment_req.cand_first_submitted_date
,candidate_assingment_req.cand_last_interviewed_date
,candidate_assingment_req.cand_last_modified_date
,candidate_assingment_req.cand_rejected_date
,candidate_assingment_req.cand_shortlisted_date
,candidate_assingment_req.cand_unshortlisted_date
,candidate_assingment_req.cand_withdrawn_date
,candidate_assingment_req.assignment_activation_date
,candidate_assingment_req.cand_offer_accepted_date
,candidate_assingment_req.cand_offer_extended_date
,candidate_assingment_req.location
,candidate_assingment_req.site_code
,candidate_assingment_req.site
,candidate_assingment_req.cand_code
,candidate_assingment_req.msp_code
,candidate_assingment_req.msp_company
,candidate_assingment_req.hours_per_day
,candidate_assingment_req.hours_per_week
,candidate_assingment_req.presented_bill_rate_st_hr
,candidate_assingment_req.presented_bill_rate_supplier_st_hr
,candidate_assingment_req.presented_pay_rate_st_hr
,candidate_assingment_req.supplier_code
,candidate_assingment_req.uploaded
,candidate_assingment_req.primary_cost_center
,CASE
	WHEN candidate_assingment_req.currency = 'USD' 
		THEN ROUND(candidate_assingment_req.presented_bill_rate_st_hr, 4)
	ELSE ROUND((fx_usd.fx_rate * candidate_assingment_req.presented_bill_rate_st_hr), 4)
END AS presented_bill_rate_st_hr_usd
,CASE
	WHEN candidate_assingment_req.currency = 'USD' 
		THEN ROUND( candidate_assingment_req.presented_bill_rate_supplier_st_hr, 4)
	ELSE ROUND((fx_usd.fx_rate * candidate_assingment_req.presented_bill_rate_supplier_st_hr), 4)
END AS supplier_presented_bill_rate_st_hr_usd
,CASE
	WHEN candidate_assingment_req.currency  = 'USD' 
		THEN ROUND(candidate_assingment_req.presented_pay_rate_st_hr, 4)
	ELSE ROUND((fx_usd.fx_rate * candidate_assingment_req.presented_pay_rate_st_hr), 4)
END AS presented_pay_rate_st_hr_usd
,CASE
	WHEN candidate_assingment_req.currency  = 'EUR' 
		THEN ROUND(candidate_assingment_req.presented_bill_rate_st_hr, 4)
	ELSE ROUND((fx_eur.fx_rate * candidate_assingment_req.presented_bill_rate_st_hr), 4)
END AS presented_bill_rate_st_hr_eur 
,CASE
	WHEN candidate_assingment_req.currency  = 'EUR' 
		THEN ROUND( candidate_assingment_req.presented_bill_rate_supplier_st_hr, 4)
	ELSE ROUND((fx_eur.fx_rate * candidate_assingment_req.presented_bill_rate_supplier_st_hr), 4)
END AS supplier_presented_bill_rate_st_hr_eur
,CASE
	WHEN candidate_assingment_req.currency = 'EUR' 
		THEN ROUND(candidate_assingment_req.presented_pay_rate_st_hr, 4)
	ELSE ROUND((fx_eur.fx_rate * candidate_assingment_req.presented_pay_rate_st_hr), 4)
END AS presented_pay_rate_st_hr_eur
,CASE
	WHEN candidate_assingment_req.currency = 'GBP' 
		THEN ROUND(candidate_assingment_req.presented_bill_rate_st_hr, 4)
	ELSE ROUND((fx_gbp.fx_rate * candidate_assingment_req.presented_bill_rate_st_hr), 4)
END AS presented_bill_rate_st_hr_gbp
,CASE
	WHEN candidate_assingment_req.currency  = 'GBP' 
		THEN ROUND( candidate_assingment_req.presented_bill_rate_supplier_st_hr, 4)
	ELSE ROUND((fx_gbp.fx_rate * candidate_assingment_req.presented_bill_rate_supplier_st_hr), 4)
END AS supplier_presented_bill_rate_st_hr_gbp
,CASE
	WHEN candidate_assingment_req.currency  = 'GBP' 
		THEN ROUND(candidate_assingment_req.presented_pay_rate_st_hr, 4)
	ELSE ROUND((fx_gbp.fx_rate * candidate_assingment_req.presented_pay_rate_st_hr), 4)
END AS presented_pay_rate_st_hr_gbp
,CASE
	WHEN candidate_assingment_req.currency = 'INR' 
		THEN ROUND(candidate_assingment_req.presented_bill_rate_st_hr, 4)
	ELSE ROUND((fx_inr.fx_rate * candidate_assingment_req.presented_bill_rate_st_hr), 4)
END AS presented_bill_rate_st_hr_inr
,CASE
	WHEN candidate_assingment_req.currency = 'INR' 
		THEN ROUND(candidate_assingment_req.presented_bill_rate_supplier_st_hr, 4)
	ELSE ROUND((fx_inr.fx_rate * candidate_assingment_req.presented_bill_rate_supplier_st_hr), 4)
END AS supplier_presented_bill_rate_st_hr_inr
,CASE
	WHEN candidate_assingment_req.currency = 'INR' 
		THEN ROUND( candidate_assingment_req.presented_pay_rate_st_hr, 4)
	ELSE ROUND((fx_inr.fx_rate * candidate_assingment_req.presented_pay_rate_st_hr), 4)
END AS presented_pay_rate_st_hr_inr
,CASE
	WHEN candidate_assingment_req.currency = 'CAD' 
		THEN ROUND( candidate_assingment_req.presented_bill_rate_st_hr, 4)
	ELSE ROUND((fx_cad.fx_rate * candidate_assingment_req.presented_bill_rate_st_hr), 4)
END AS presented_bill_rate_st_hr_cad
,CASE
	WHEN candidate_assingment_req.currency = 'CAD' 
		THEN ROUND(  candidate_assingment_req.presented_bill_rate_supplier_st_hr, 4)
	ELSE ROUND((fx_cad.fx_rate * candidate_assingment_req.presented_bill_rate_supplier_st_hr), 4)
END AS supplier_presented_bill_rate_st_hr_cad
,CASE
	WHEN candidate_assingment_req.currency = 'CAD' 
		THEN ROUND(candidate_assingment_req.presented_pay_rate_st_hr, 4)
	ELSE ROUND((fx_cad.fx_rate * candidate_assingment_req.presented_pay_rate_st_hr), 4)
END AS presented_pay_rate_st_hr_cad
,PARSE_DATE('%%m/%%d/%%Y', global_calendar_445.calendar_reporting_month_date) AS control
,CASE
    WHEN candidate_assingment_req.rsr_country='United States of America' THEN div_supp.primary_diversity_type
    ELSE CAST(NULL AS STRING)
END AS supplier_primary_diversity_type
,CASE
	WHEN candidate_assingment_req.rsr_country='United States of America' THEN div_supp.small_business
    ELSE CAST(NULL AS STRING)
END AS supplier_small_business
,CASE
	WHEN candidate_assingment_req.rsr_country='United States of America' THEN div_supp.diverse_and_small
    ELSE CAST(NULL AS STRING)
END AS supplier_diverse_small
,CASE
	WHEN candidate_assingment_req.rsr_country='United States of America' THEN div_supp.supplier_id_erp
    ELSE CAST(NULL AS STRING)
END AS supplier_erp_id
,candidate_assingment_req.assignment_create_date_initial
,candidate_assingment_req.assignment_activation_date_initial
,candidate_assingment_req.req_title
,candidate_assingment_req.req_type
,candidate_assingment_req.max_requested_bill_rate_st_hr
,candidate_assingment_req.max_requested_pay_rate_st_hr
,candidate_assingment_req.min_requested_bill_rate_st_hr
,candidate_assingment_req.min_requested_pay_rate_st_hr
,candidate_assingment_req.labor_type
,candidate_assingment_req.req_status
,candidate_assingment_req.req_site
,candidate_assingment_req.req_site_code
,candidate_assingment_req.req_location
,candidate_assingment_req.req_city
,candidate_assingment_req.req_state_province
,candidate_assingment_req.req_country
,candidate_assingment_req.req_approved_date
,candidate_assingment_req.req_closed_date
,candidate_assingment_req.req_create_date
,candidate_assingment_req.req_end_date
,candidate_assingment_req.req_submitted_date
,candidate_assingment_req.req_coordinator_name
,candidate_assingment_req.positions_requested_cnt
,candidate_assingment_req.sourcing_type_wk_mapped
,candidate_assingment_req.sourcing_type_wo_mapped
,candidate_assingment_req.max_template_bill_rate_st_hr
-- used max_requested_bill_rate_st_hr instead of max_template_bill_rate_st_hr
,(CASE 
	WHEN candidate_assingment_req.max_template_bill_rate_st_hr >= candidate_assingment_req.presented_bill_rate_supplier_st_hr THEN 'Compliant'
	ELSE 
		CASE
            WHEN candidate_assingment_req.presented_bill_rate_supplier_st_hr <  (CAST('1.15' AS NUMERIC) * candidate_assingment_req.max_template_bill_rate_st_hr) THEN 'Non-Compliant - Under 115%% Max Bill Rate'
            ELSE 'Non-Compliant - Over 115%% Max Bill Rate'
        END
end) AS compliance_vs_max_template_bill_rate
,candidate_assingment_req.rsr_state
,candidate_assingment_req.rsr_country
,candidate_assingment_req.rsr_region
,candidate_assingment_req.rsr_labor_type
,global_supp_map.suppliername_dw AS rsr_supplier
,candidate_assingment_req.rsr_req_status
,ifnull(candidate_assingment_req.rsr_sourced_type,'Recruited') as rsr_sourced_type
,IFNULL(global_js_status_mapping.submittal_status_dw, NULL) AS rsr_cand_status 
,CAST(Function_library${region}.f_calendarday(candidate_assingment_req.req_approved_date, candidate_assingment_req.cand_submit_date) AS INT64) as approved_to_submit_cd
,ROUND(Function_library${region}.f_workday(candidate_assingment_req.req_approved_date, candidate_assingment_req.cand_submit_date), 4)AS approved_to_submit_bd
,CAST(Function_library${region}.f_calendarday( candidate_assingment_req.cand_submit_date,candidate_assingment_req.cand_shortlisted_date) AS INT64) as submit_to_shortlist_cd
,ROUND(Function_library${region}.f_workday(candidate_assingment_req.cand_submit_date,candidate_assingment_req.cand_shortlisted_date), 4)AS submit_to_shortlist_bd
,'${dataform.projectConfig.vars.client_code}' as rsr_client_code
, CURRENT_DATE() as current_date
,candidate_assingment_req.rsr_processed_date
,NULL AS preferred_supplier_status
,req_dist_data.min_req_dist_date AS req_distribution_date
,candidate_assingment_req.rsr_staffing_entity, -- winter_release 2025
candidate_assingment_req.worker_start_date,
norm_jt.suppressed_title,
norm_jt.pii_found,
norm_jt.process_status,
norm_jt.suppression_type,
norm_jt.llm_cleaned,
norm_jt.title_cleaned,
norm_jt.ms_category_1,
norm_jt.ms_category_2,
norm_jt.onet_career_pathway,
norm_jt.onet_job_family,
norm_jt.onet_career_cluster,
norm_jt.onet_occupation,
norm_jt.soc_major_group,
norm_jt.soc_minor_group,
norm_jt.soc_broad_group,
norm_jt.onet_detailed_occupation,
norm_jt.bg_categorization,
norm_jt.tk_categorization,
norm_jt.rand_categorization,
norm_jt.rmi_categorization,
norm_jt.R1_label,
norm_jt.R2_label,
norm_jt.R3_label,
norm_jt.R4_label,
norm_jt.R5_label,
norm_jt.R6_label,
norm_loc.location_level_1,
norm_loc.location_level_2,
norm_loc.location_level_3,
norm_loc.location_level_4,
norm_loc.location_level_5,
norm_loc.location_level_6,
norm_loc.location_level_7,
norm_loc.location_level_8,
norm_loc.location_level_1a,
norm_loc.location_level_2a
FROM js_assingment_data as candidate_assingment_req
LEFT JOIN req_dist_data ON candidate_assingment_req.buyer_code = req_dist_data.buyer_code AND candidate_assingment_req.supplier_code = req_dist_data.supplier_code AND candidate_assingment_req.req_id = req_dist_data.req_id
LEFT JOIN  db_common${region}.global_supplier_mapping AS global_supp_map ON candidate_assingment_req.buyer = global_supp_map.buyer AND candidate_assingment_req.supplier = global_supp_map.supplier
LEFT JOIN db_common${region}.global_js_status AS global_js_status_mapping ON trim(lower(candidate_assingment_req.cand_status)) = trim(lower(global_js_status_mapping.job_seeker_status))
LEFT JOIN db_common${region}.global_calendar_445 AS global_calendar_445 ON EXTRACT(DATE FROM Function_library${region}.max_array([candidate_assingment_req.cand_submit_date, candidate_assingment_req.assignment_activation_date_initial])) = PARSE_DATE("%%m/%%d/%%Y", global_calendar_445.day)
LEFT JOIN fx_rates fx_usd ON candidate_assingment_req.currency = fx_usd.from_currency AND PARSE_DATE('%%m/%%d/%%Y', global_calendar_445.calendar_reporting_month_date)=fx_usd.month AND fx_usd.to_currency = 'USD'
LEFT JOIN fx_rates fx_eur ON candidate_assingment_req.currency = fx_eur.from_currency AND PARSE_DATE('%%m/%%d/%%Y', global_calendar_445.calendar_reporting_month_date)=fx_eur.month AND fx_eur.to_currency = 'EUR'
LEFT JOIN fx_rates fx_gbp ON candidate_assingment_req.currency = fx_gbp.from_currency AND PARSE_DATE('%%m/%%d/%%Y', global_calendar_445.calendar_reporting_month_date)=fx_gbp.month AND fx_gbp.to_currency = 'GBP'
LEFT JOIN fx_rates fx_inr ON candidate_assingment_req.currency = fx_inr.from_currency AND PARSE_DATE('%%m/%%d/%%Y', global_calendar_445.calendar_reporting_month_date)=fx_inr.month AND fx_inr.to_currency = 'INR' 
LEFT JOIN fx_rates fx_cad ON candidate_assingment_req.currency = fx_cad.from_currency AND PARSE_DATE('%%m/%%d/%%Y', global_calendar_445.calendar_reporting_month_date)=fx_cad.month AND fx_cad.to_currency = 'CAD' 
LEFT JOIN db${region}_aptus.aptus_suppio_supplier_diversity_data div_supp ON lower(div_supp.customer_code)=lower(candidate_assingment_req.buyer_code) AND div_supp.supplier_code=candidate_assingment_req.supplier_code AND div_supp.fiscal_year=CAST(EXTRACT(YEAR FROM CAST(candidate_assingment_req.cand_submit_date AS DATE)) AS INTEGER) AND div_supp.accounting_period=CAST(EXTRACT(MONTH FROM CAST(candidate_assingment_req.cand_submit_date AS DATE)) AS INTEGER)
    LEFT JOIN db${region}_yellowdata_normalization.job_titles_gold_${dataform.projectConfig.vars.dataset_id}_normalised norm_jt on candidate_assingment_req.req_title = norm_jt.raw_job_title
    LEFT JOIN db${region}_yellowdata_normalization.locations_gold_${dataform.projectConfig.vars.dataset_id}_normalised norm_loc on COALESCE(candidate_assingment_req.req_city, '') = COALESCE(norm_loc.city, '') AND COALESCE(candidate_assingment_req.rsr_state, '') = COALESCE(norm_loc.state, '')
  AND COALESCE(candidate_assingment_req.req_state_province, '') = COALESCE(norm_loc.province, '') AND COALESCE(candidate_assingment_req.rsr_country, '') = COALESCE(norm_loc.country_name, '') AND COALESCE(candidate_assingment_req.req_country, '') = COALESCE(norm_loc.country_code, ''))""",
"dev_gold_tr_eu_goldschemacheck",candidate_table_id,
resilient_cand_cte_sql,slvr_dataset,slvr_cand,
resilient_req_dist_cte_sql,slvr_dataset,slvr_req_dist,
-- slvr_cand,
gold_dataset,assignment_table_id,
gold_dataset,requisition_table_id
-- slvr_req_dist
)
;