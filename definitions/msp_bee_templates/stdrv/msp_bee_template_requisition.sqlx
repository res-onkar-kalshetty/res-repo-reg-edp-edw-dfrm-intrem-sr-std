config {
    type: "operations",
    name: "msp_bee_template_requisition",
    description: 'This file creates the  stdrv layer ',
    tags: 'msp_bee_template'
}

js {
    const {
        getCompleteTableConfig
    } = require("includes/table_config");
    const config = getCompleteTableConfig(ctx);
    const baseTables = config.baseTables.defaults;
}

DECLARE
  requisition_table_id STRING;
DECLARE
  gold_dataset STRING;
EXECUTE IMMEDIATE
  FORMAT ('''
  SELECT
  DISTINCT table_id,
  FROM
  `${dataform.projectConfig.vars.config_dataset}.ext_slvr_schema_cfg_gld_test`
    WHERE standard_report_type = 'requisition_src' and dataset_id = '${dataform.projectConfig.vars.dataset_id}' LIMIT 1
''' )INTO requisition_table_id;
IF
  requisition_table_id IS NULL THEN RAISE
USING
  MESSAGE = 'REQUISITION TABLE ID IS MISSING FROM CONFIGS';
END IF
  ;
SET
  gold_dataset = CONCAT("dev","_gold_","${dataform.projectConfig.vars.dataset_id}");
EXECUTE IMMEDIATE
  FORMAT ("""
CREATE OR REPLACE TABLE
  %s.%s AS (
  WITH
    candidate_data AS (
    SELECT
      buyer_code,
      req_id,
      MIN(cand_submit_date) AS first_cand_submitted_date,
      COUNT(DISTINCT cand_id) AS cand_submitted_cnt,
      COUNT(DISTINCT supplier) AS suppliers_responded_cnt
    FROM
      `${dataform.projectConfig.vars.ds_name}.${baseTables.candidate}_${dataform.projectConfig.vars.client_code}`
    GROUP BY
      req_id,
      buyer_code ),
    req_temp_data AS (
    SELECT
      req_temp_in.req_id,
      req_temp_in.buyer_code,
      CASE
        WHEN LOWER(req_temp_in.max_template_bill_rate_st_basis) = 'hourly' THEN req_temp_in.max_template_bill_rate_st_hr
        WHEN LOWER(req_temp_in.max_template_bill_rate_st_basis) = 'daily' THEN (req_temp_in.max_template_bill_rate_st_hr /(req_in.hours_per_week/req_in.days_per_week))
        WHEN LOWER(req_temp_in.max_template_bill_rate_st_basis) = 'monthly' THEN (req_temp_in.max_template_bill_rate_st_hr /((req_in.hours_per_week/req_in.days_per_week)*4.33))
        WHEN LOWER(req_temp_in.max_template_bill_rate_st_basis) = 'weekly' THEN (req_temp_in.max_template_bill_rate_st_hr /(req_in.hours_per_week))
    END
      AS max_template_bill_rate_st_hr,
    FROM
      ${dataform.projectConfig.vars.ds_name}.${baseTables.requisition_template}_${dataform.projectConfig.vars.client_code} req_temp_in
    LEFT JOIN
      `${dataform.projectConfig.vars.ds_name}.${baseTables.requisition}_${dataform.projectConfig.vars.client_code}` req_in
    ON
      req_in.req_id= req_temp_in.req_id ),
    wo_data AS (
    SELECT
      COUNT(assignment_id) AS hired_cnt,
      buyer_code,
      main_document_id
    FROM
      ${dataform.projectConfig.vars.ds_name}.${baseTables.assignment}_${dataform.projectConfig.vars.client_code}
    GROUP BY
      buyer_code,
      main_document_id ),
    req_dist_prs AS (
    SELECT
      CASE
        WHEN job_posting_decline_date IS NOT NULL THEN 'Declined'
        ELSE req_distribution_status
    END
      AS req_distribution_status,
      CASE
        WHEN job_posting_decline_date IS NOT NULL THEN 'Declined'
        ELSE decline_reason
    END
      AS decline_reason,
      *EXCEPT(req_distribution_status,
        decline_reason)
    FROM
      ${dataform.projectConfig.vars.ds_name}.${baseTables.requisition_distribution}_${dataform.projectConfig.vars.client_code} ),
    req_dist_data AS (
    SELECT
      COUNT(DISTINCT
        CASE
          WHEN COALESCE(req_distribution_status, 'na') <> 'Declined' THEN supplier
          ELSE CAST(NULL AS STRING)
      END
        ) AS suppliers_posted_cnt,
      MIN(req_distribution_date) AS earliest_req_dist_date,
      buyer_code,
      req_id
    FROM
      req_dist_prs
    GROUP BY
      buyer_code,
      req_id )
  SELECT
    req.buyer,
    req.buyer_code,
    req.req_id,
    req.req_title,
    req.labor_type,
    req.sourcing_type,
    req.sourcing_type_template,
    IFNULL( gbl_src.sourcing_dw,
      CASE
        WHEN cand.cand_submitted_cnt <= 1 AND req_dist.suppliers_posted_cnt <= 1 THEN 'Pre-ID'
        ELSE 'Recruited'
    END
      ) AS rsr_sourced_type,
    req.req_status,
    req.req_owner,
    COALESCE(req.req_type, req.posting_type) AS req_type,
    req.posting_type,
    CASE
      WHEN req.req_status NOT IN ('Open', 'On Hold', 'Pending') THEN req.close_reason
      ELSE NULL
  END
    AS close_reason,
    CASE
      WHEN req.req_status LIKE 'Cancelled' THEN (CASE
        WHEN req.req_status NOT IN ('Open',
        'On Hold',
        'Pending') THEN req.close_reason
        ELSE NULL
    END
      )
      ELSE NULL
  END
    AS withdraw_reason,
    req.business_unit_code,
    req.business_unit,
    req.site,
    req.site_code,
    req.division,
    req.location_code,
    req.location,
    req.req_category,
    req.city,
    req.state_province,
    req.country,
    req.zip_postal_code,
    req.first_respond_date,
    req.req_approved_date,
    COALESCE(req.job_posting_filled_date, req.job_posting_cancelled_date) AS req_closed_date,
    req.req_create_date,
    req.req_end_date,
    req.req_respond_by_date AS req_responded_by_date,
    req.req_start_date,
    req.req_submit_date AS req_submitted_date,
    req.req_first_approved_date,
    req.req_creator_name,
    req.req_distributor_name,
    req.req_coordinator_name,
    CASE
      WHEN LOWER(req.max_requested_bill_rate_basis) = 'hourly' THEN req.max_requested_bill_rate
      WHEN LOWER(req.max_requested_bill_rate_basis) = 'daily' THEN (req.max_requested_bill_rate /(req.hours_per_week/req.days_per_week))
      WHEN LOWER(req.max_requested_bill_rate_basis) = 'monthly' THEN (req.max_requested_bill_rate /((req.hours_per_week/req.days_per_week)*4.33))
      WHEN LOWER(req.max_requested_bill_rate_basis) = 'weekly' THEN (req.max_requested_bill_rate /(req.hours_per_week))
  END
    AS max_requested_bill_rate_st_hr,
    CASE
      WHEN LOWER(req.max_requested_bill_rate_basis) = 'hourly' THEN req.max_requested_pay_rate
      WHEN LOWER(req.max_requested_bill_rate_basis) = 'daily' THEN (req.max_requested_pay_rate /(req.hours_per_week/days_per_week))
      WHEN LOWER(req.max_requested_bill_rate_basis) = 'monthly' THEN (req.max_requested_pay_rate /((req.hours_per_week/days_per_week)*4.33))
      WHEN LOWER(req.max_requested_bill_rate_basis) = 'weekly' THEN (req.max_requested_pay_rate /(req.hours_per_week))
  END
    AS max_requested_pay_rate_st_hr,
    req.min_requested_bill_rate_st_hr,
    req.min_requested_pay_rate_st_hr,
    req.hours_per_week,
    req.hours_per_day,
    req.msp_code,
    req.msp,
    req.start_day_of_week,
    req.positions_requested_cnt,
    req.positions_remaining_cnt,
    req_temp.max_template_bill_rate_st_hr,
    -- gjcr.closed_reason_dw as rsr_close_reason,
    CASE
      WHEN IFNULL(gjcr.closed_reason_dw, '') <> '' THEN gjcr.closed_reason_dw
      WHEN IFNULL(CASE
        WHEN req.req_status NOT IN ('Open', 'On Hold', 'Pending') THEN req.close_reason
        ELSE NULL
    END
      ,'') = '' THEN 'Undisclosed'
      ELSE 'Unmapped'
  END
    AS rsr_close_reason,
    CASE
      WHEN IFNULL(glt.labor_type_dw, '') <> '' THEN glt.labor_type_dw
      WHEN IFNULL(req.labor_type, '') = '' THEN 'Undisclosed'
      ELSE 'Unmapped'
  END
    AS rsr_labor_type,
    -- gsm.rsr_state,
    CASE
      WHEN IFNULL(gsm.rsr_state, '') <> '' THEN gsm.rsr_state
      WHEN IFNULL(req.state_province, '') = '' THEN 'Undisclosed'
      ELSE 'Unmapped'
  END
    AS rsr_state,
    -- gcr.rsr_country,
    CASE
      WHEN IFNULL(gcr.rsr_country, '') <> '' THEN gcr.rsr_country
      WHEN IFNULL(req.country, '') = '' THEN 'Undisclosed'
      ELSE 'Unmapped'
  END
    AS rsr_country,
    -- gcr.rsr_region,
    CASE
      WHEN IFNULL(gcr.rsr_region, '') <> '' THEN gcr.rsr_region
      WHEN IFNULL(req.country, '') = '' THEN 'Undisclosed'
      ELSE 'Unmapped'
  END
    AS rsr_region,
    gcr.country AS rsr_country_code,
    CURRENT_DATE() AS current_date,
    CAST(Function_library${dataform.projectConfig.vars.region}.f_calendarday(req.req_approved_date,
        CAST(CURRENT_TIMESTAMP() AS DATETIME)) AS INT64) AS req_aging_cd,
    ROUND(Function_library${dataform.projectConfig.vars.region}.f_workday(req.req_approved_date,
        CAST(CURRENT_TIMESTAMP() AS DATETIME)),2) AS req_aging_bd,
    CAST(Function_library${dataform.projectConfig.vars.region}.f_calendarday(req.req_create_date,
        req.req_approved_date) AS INT64) AS create_to_approve_cd,
    ROUND(Function_library${dataform.projectConfig.vars.region}.f_workday(req.req_create_date,
        req.req_approved_date),2) AS create_to_approve_bd,
    CAST(Function_library${dataform.projectConfig.vars.region}.f_calendarday(req.req_approved_date,
        cand.first_cand_submitted_date) AS INT64) AS time_to_submit_first_cand_cd,
    ROUND(Function_library${dataform.projectConfig.vars.region}.f_workday(req.req_approved_date,
        cand.first_cand_submitted_date),2) AS time_to_submit_first_cand_bd,
    grs.rsr_job_posting_status AS rsr_req_status,
    -- job posting status
    assing.hired_cnt,
    cand.cand_submitted_cnt,
    req_dist.suppliers_posted_cnt,
    cand.suppliers_responded_cnt,
    cand.first_cand_submitted_date,
    req_dist.earliest_req_dist_date,
    -- Fields used for other derv views
    req.dist_list,
    req.primary_cost_center,
    req.req_title_classification,
    '${dataform.projectConfig.vars.client_code}' AS rsr_client_code,
    req.rsr_processed_date,
    req.currency,
    req.days_per_week,
    req.service_type,
    -- needed for assignment MST, added by SB
    req.rsr_staffing_entity,
    -- winter_release 2025
    norm_jt.suppressed_title,
    norm_jt.pii_found,
    norm_jt.process_status,
    norm_jt.suppression_type,
    norm_jt.llm_cleaned,
    norm_jt.title_cleaned,
    norm_jt.ms_category_1,
    norm_jt.ms_category_2,
    norm_jt.onet_career_pathway,
    norm_jt.onet_job_family,
    norm_jt.onet_career_cluster,
    norm_jt.onet_occupation,
    norm_jt.soc_major_group,
    norm_jt.soc_minor_group,
    norm_jt.soc_broad_group,
    norm_jt.onet_detailed_occupation,
    norm_jt.bg_categorization,
    norm_jt.tk_categorization,
    norm_jt.rand_categorization,
    norm_jt.rmi_categorization,
    norm_jt.R1_label,
    norm_jt.R2_label,
    norm_jt.R3_label,
    norm_jt.R4_label,
    norm_jt.R5_label,
    norm_jt.R6_label,
    norm_loc.location_level_1,
    norm_loc.location_level_2,
    norm_loc.location_level_3,
    norm_loc.location_level_4,
    norm_loc.location_level_5,
    norm_loc.location_level_6,
    norm_loc.location_level_7,
    norm_loc.location_level_8,
    norm_loc.location_level_1a,
    norm_loc.location_level_2a
  FROM
    `${dataform.projectConfig.vars.ds_name}.${baseTables.requisition}_${dataform.projectConfig.vars.client_code}` req
  LEFT JOIN
    req_dist_data AS req_dist
  ON
    req.req_id = req_dist.req_id
  LEFT JOIN
    candidate_data AS cand
  ON
    req.req_id = cand.req_id
  LEFT JOIN
    req_temp_data AS req_temp
  ON
    req.req_id= req_temp.req_id
  LEFT JOIN
    wo_data AS assing
  ON
    req.req_id = assing.main_document_id
  LEFT JOIN
    `db_common${dataform.projectConfig.vars.region}.global_jp_closed_reason` gjcr
  ON
    (CASE
        WHEN req.req_status NOT IN ('Open', 'On Hold', 'Pending') THEN req.close_reason
    END
      ) = gjcr.close_reason
  LEFT JOIN
    `db_common${dataform.projectConfig.vars.region}.global_labor_type` glt
  ON
    req.labor_type = glt.vms_labor_type
  LEFT JOIN
    `db_common${dataform.projectConfig.vars.region}.global_state_mapping` gsm
  ON
    req.state_province = gsm.vms_state
  LEFT JOIN
    `db_common${dataform.projectConfig.vars.region}.global_countries` gcr
  ON
    LOWER(req.country)=LOWER(gcr.country)
  LEFT JOIN
    `db_common${dataform.projectConfig.vars.region}.global_job_posting_status` grs
  ON
    grs.job_posting_status = req.req_status
  LEFT OUTER JOIN
    db_common${dataform.projectConfig.vars.region}.global_sourcing AS gbl_src
  ON
    TRIM(LOWER(gbl_src.sourcing_type)) = TRIM(LOWER(COALESCE(req.sourcing_type, req.sourcing_type_template, '')))
  LEFT JOIN
    db${dataform.projectConfig.vars.region}_yellowdata_normalization.job_titles_${dataform.projectConfig.vars.ds_name}_normalised norm_jt
  ON
    req.req_title = norm_jt.raw_job_title
  LEFT JOIN
    db${dataform.projectConfig.vars.region}_yellowdata_normalization.locations_${dataform.projectConfig.vars.ds_name}_normalised norm_loc
  ON
    COALESCE(req.city, '') = COALESCE(norm_loc.city, '')
    AND COALESCE((CASE
          WHEN IFNULL(gsm.vms_state, '') <> '' THEN gsm.vms_state
          WHEN IFNULL(req.state_province, '') = '' THEN 'Undisclosed'
          ELSE 'Unmapped'
      END
        ), '') = COALESCE(norm_loc.state, '')
    AND COALESCE(req.state_province, '') = COALESCE(norm_loc.province, '')
    AND COALESCE((CASE
          WHEN IFNULL(gcr.rsr_country, '') <> '' THEN gcr.rsr_country
          WHEN IFNULL(req.country, '') = '' THEN 'Undisclosed'
          ELSE 'Unmapped'
      END
        ), '') = COALESCE(norm_loc.country_name, '')
    AND COALESCE(req.country, '') = COALESCE(norm_loc.country_code, ''))""",gold_dataset,requisition_table_id);
CREATE OR REPLACE TABLE
  `${dataform.projectConfig.vars.ds_name}.stdrv_requisition_${dataform.projectConfig.vars.client_code}` AS (
  WITH
    candidate_data AS (
    SELECT
      buyer_code,
      req_id,
      MIN(cand_submit_date) AS first_cand_submitted_date,
      COUNT(DISTINCT cand_id) AS cand_submitted_cnt,
      COUNT(DISTINCT supplier) AS suppliers_responded_cnt
    FROM
      `${dataform.projectConfig.vars.ds_name}.prs_candidate_${dataform.projectConfig.vars.client_code}`
    GROUP BY
      req_id,
      buyer_code ),
    req_temp_data AS (
    SELECT
      req_temp_in.req_id,
      req_temp_in.buyer_code,
      CASE
        WHEN LOWER(req_temp_in.max_template_bill_rate_st_basis) = 'hourly' THEN req_temp_in.max_template_bill_rate_st_hr
        WHEN LOWER(req_temp_in.max_template_bill_rate_st_basis) = 'daily' THEN (req_temp_in.max_template_bill_rate_st_hr /(req_in.hours_per_week/req_in.days_per_week))
        WHEN LOWER(req_temp_in.max_template_bill_rate_st_basis) = 'monthly' THEN (req_temp_in.max_template_bill_rate_st_hr /((req_in.hours_per_week/req_in.days_per_week)*4.33))
        WHEN LOWER(req_temp_in.max_template_bill_rate_st_basis) = 'weekly' THEN (req_temp_in.max_template_bill_rate_st_hr /(req_in.hours_per_week))
    END
      AS max_template_bill_rate_st_hr,
    FROM
      ${dataform.projectConfig.vars.ds_name}.prs_requisition_template_${dataform.projectConfig.vars.client_code} req_temp_in
    LEFT JOIN
      `${dataform.projectConfig.vars.ds_name}.prs_requisition_${dataform.projectConfig.vars.client_code}` req_in
    ON
      req_in.req_id= req_temp_in.req_id ),
    wo_data AS (
    SELECT
      COUNT(assignment_id) AS hired_cnt,
      buyer_code,
      main_document_id
    FROM
      ${dataform.projectConfig.vars.ds_name}.prs_assignment_${dataform.projectConfig.vars.client_code}
    GROUP BY
      buyer_code,
      main_document_id ),
    req_dist_prs AS (
    SELECT
      CASE
        WHEN job_posting_decline_date IS NOT NULL THEN 'Declined'
        ELSE req_distribution_status
    END
      AS req_distribution_status,
      CASE
        WHEN job_posting_decline_date IS NOT NULL THEN 'Declined'
        ELSE decline_reason
    END
      AS decline_reason,
      *EXCEPT(req_distribution_status,
        decline_reason)
    FROM
      ${dataform.projectConfig.vars.ds_name}.prs_requisition_distribution_${dataform.projectConfig.vars.client_code} ),
    req_dist_data AS (
    SELECT
      COUNT(DISTINCT
        CASE
          WHEN COALESCE(req_distribution_status, 'na') <> 'Declined' THEN supplier
          ELSE CAST(NULL AS STRING)
      END
        ) AS suppliers_posted_cnt,
      MIN(req_distribution_date) AS earliest_req_dist_date,
      buyer_code,
      req_id
    FROM
      req_dist_prs
    GROUP BY
      buyer_code,
      req_id )
  SELECT
    req.buyer,
    req.buyer_code,
    req.req_id,
    req.req_title,
    req.labor_type,
    req.sourcing_type,
    req.sourcing_type_template,
    IFNULL( gbl_src.sourcing_dw,
      CASE
        WHEN cand.cand_submitted_cnt <= 1 AND req_dist.suppliers_posted_cnt <= 1 THEN 'Pre-ID'
        ELSE 'Recruited'
    END
      ) AS rsr_sourced_type,
    req.req_status,
    req.req_owner,
    COALESCE(req.req_type, req.posting_type) AS req_type,
    req.posting_type,
    CASE
      WHEN req.req_status NOT IN ('Open', 'On Hold', 'Pending') THEN req.close_reason
      ELSE NULL
  END
    AS close_reason,
    CASE
      WHEN req.req_status LIKE 'Cancelled' THEN (CASE
        WHEN req.req_status NOT IN ('Open',
        'On Hold',
        'Pending') THEN req.close_reason
        ELSE NULL
    END
      )
      ELSE NULL
  END
    AS withdraw_reason,
    req.business_unit_code,
    req.business_unit,
    req.site,
    req.site_code,
    req.division,
    req.location_code,
    req.location,
    req.req_category,
    req.city,
    req.state_province,
    req.country,
    req.zip_postal_code,
    req.first_respond_date,
    req.req_approved_date,
    COALESCE(req.job_posting_filled_date, req.job_posting_cancelled_date) AS req_closed_date,
    req.req_create_date,
    req.req_end_date,
    req.req_respond_by_date AS req_responded_by_date,
    req.req_start_date,
    req.req_submit_date AS req_submitted_date,
    req.req_first_approved_date,
    req.req_creator_name,
    req.req_distributor_name,
    req.req_coordinator_name,
    CASE
      WHEN LOWER(req.max_requested_bill_rate_basis) = 'hourly' THEN req.max_requested_bill_rate
      WHEN LOWER(req.max_requested_bill_rate_basis) = 'daily' THEN (req.max_requested_bill_rate /(req.hours_per_week/req.days_per_week))
      WHEN LOWER(req.max_requested_bill_rate_basis) = 'monthly' THEN (req.max_requested_bill_rate /((req.hours_per_week/req.days_per_week)*4.33))
      WHEN LOWER(req.max_requested_bill_rate_basis) = 'weekly' THEN (req.max_requested_bill_rate /(req.hours_per_week))
  END
    AS max_requested_bill_rate_st_hr,
    CASE
      WHEN LOWER(req.max_requested_bill_rate_basis) = 'hourly' THEN req.max_requested_pay_rate
      WHEN LOWER(req.max_requested_bill_rate_basis) = 'daily' THEN (req.max_requested_pay_rate /(req.hours_per_week/days_per_week))
      WHEN LOWER(req.max_requested_bill_rate_basis) = 'monthly' THEN (req.max_requested_pay_rate /((req.hours_per_week/days_per_week)*4.33))
      WHEN LOWER(req.max_requested_bill_rate_basis) = 'weekly' THEN (req.max_requested_pay_rate /(req.hours_per_week))
  END
    AS max_requested_pay_rate_st_hr,
    req.min_requested_bill_rate_st_hr,
    req.min_requested_pay_rate_st_hr,
    req.hours_per_week,
    req.hours_per_day,
    req.msp_code,
    req.msp,
    req.start_day_of_week,
    req.positions_requested_cnt,
    req.positions_remaining_cnt,
    req_temp.max_template_bill_rate_st_hr,
    -- gjcr.closed_reason_dw as rsr_close_reason,
    CASE
      WHEN IFNULL(gjcr.closed_reason_dw, '') <> '' THEN gjcr.closed_reason_dw
      WHEN IFNULL(CASE
        WHEN req.req_status NOT IN ('Open', 'On Hold', 'Pending') THEN req.close_reason
        ELSE NULL
    END
      ,'') = '' THEN 'Undisclosed'
      ELSE 'Unmapped'
  END
    AS rsr_close_reason,
    CASE
      WHEN IFNULL(glt.labor_type_dw, '') <> '' THEN glt.labor_type_dw
      WHEN IFNULL(req.labor_type, '') = '' THEN 'Undisclosed'
      ELSE 'Unmapped'
  END
    AS rsr_labor_type,
    -- gsm.rsr_state,
    CASE
      WHEN IFNULL(gsm.rsr_state, '') <> '' THEN gsm.rsr_state
      WHEN IFNULL(req.state_province, '') = '' THEN 'Undisclosed'
      ELSE 'Unmapped'
  END
    AS rsr_state,
    -- gcr.rsr_country,
    CASE
      WHEN IFNULL(gcr.rsr_country, '') <> '' THEN gcr.rsr_country
      WHEN IFNULL(req.country, '') = '' THEN 'Undisclosed'
      ELSE 'Unmapped'
  END
    AS rsr_country,
    -- gcr.rsr_region,
    CASE
      WHEN IFNULL(gcr.rsr_region, '') <> '' THEN gcr.rsr_region
      WHEN IFNULL(req.country, '') = '' THEN 'Undisclosed'
      ELSE 'Unmapped'
  END
    AS rsr_region,
    gcr.country AS rsr_country_code,
    CURRENT_DATE() AS current_date,
    CAST(Function_library${dataform.projectConfig.vars.region}.f_calendarday(req.req_approved_date,
        CAST(CURRENT_TIMESTAMP() AS DATETIME)) AS INT64) AS req_aging_cd,
    ROUND(Function_library${dataform.projectConfig.vars.region}.f_workday(req.req_approved_date,
        CAST(CURRENT_TIMESTAMP() AS DATETIME)),2) AS req_aging_bd,
    CAST(Function_library${dataform.projectConfig.vars.region}.f_calendarday(req.req_create_date,
        req.req_approved_date) AS INT64) AS create_to_approve_cd,
    ROUND(Function_library${dataform.projectConfig.vars.region}.f_workday(req.req_create_date,
        req.req_approved_date),2) AS create_to_approve_bd,
    CAST(Function_library${dataform.projectConfig.vars.region}.f_calendarday(req.req_approved_date,
        cand.first_cand_submitted_date) AS INT64) AS time_to_submit_first_cand_cd,
    ROUND(Function_library${dataform.projectConfig.vars.region}.f_workday(req.req_approved_date,
        cand.first_cand_submitted_date),2) AS time_to_submit_first_cand_bd,
    grs.rsr_job_posting_status AS rsr_req_status,
    -- job posting status
    assing.hired_cnt,
    cand.cand_submitted_cnt,
    req_dist.suppliers_posted_cnt,
    cand.suppliers_responded_cnt,
    cand.first_cand_submitted_date,
    req_dist.earliest_req_dist_date,
    -- Fields used for other derv views
    req.dist_list,
    req.primary_cost_center,
    req.req_title_classification,
    '${dataform.projectConfig.vars.client_code}' AS rsr_client_code,
    req.rsr_processed_date,
    req.currency,
    req.days_per_week,
    req.service_type,
    -- needed for assignment MST, added by SB
    req.rsr_staffing_entity,
    -- winter_release 2025
    norm_jt.suppressed_title,
    norm_jt.pii_found,
    norm_jt.process_status,
    norm_jt.suppression_type,
    norm_jt.llm_cleaned,
    norm_jt.title_cleaned,
    norm_jt.ms_category_1,
    norm_jt.ms_category_2,
    norm_jt.onet_career_pathway,
    norm_jt.onet_job_family,
    norm_jt.onet_career_cluster,
    norm_jt.onet_occupation,
    norm_jt.soc_major_group,
    norm_jt.soc_minor_group,
    norm_jt.soc_broad_group,
    norm_jt.onet_detailed_occupation,
    norm_jt.bg_categorization,
    norm_jt.tk_categorization,
    norm_jt.rand_categorization,
    norm_jt.rmi_categorization,
    norm_jt.R1_label,
    norm_jt.R2_label,
    norm_jt.R3_label,
    norm_jt.R4_label,
    norm_jt.R5_label,
    norm_jt.R6_label,
    norm_loc.location_level_1,
    norm_loc.location_level_2,
    norm_loc.location_level_3,
    norm_loc.location_level_4,
    norm_loc.location_level_5,
    norm_loc.location_level_6,
    norm_loc.location_level_7,
    norm_loc.location_level_8,
    norm_loc.location_level_1a,
    norm_loc.location_level_2a
  FROM
    `${dataform.projectConfig.vars.ds_name}.prs_requisition_${dataform.projectConfig.vars.client_code}` req
  LEFT JOIN
    req_dist_data AS req_dist
  ON
    req.req_id = req_dist.req_id
  LEFT JOIN
    candidate_data AS cand
  ON
    req.req_id = cand.req_id
  LEFT JOIN
    req_temp_data AS req_temp
  ON
    req.req_id= req_temp.req_id
  LEFT JOIN
    wo_data AS assing
  ON
    req.req_id = assing.main_document_id
  LEFT JOIN
    `db_common${dataform.projectConfig.vars.region}.global_jp_closed_reason` gjcr
  ON
    (CASE
        WHEN req.req_status NOT IN ('Open', 'On Hold', 'Pending') THEN req.close_reason
    END
      ) = gjcr.close_reason
  LEFT JOIN
    `db_common${dataform.projectConfig.vars.region}.global_labor_type` glt
  ON
    req.labor_type = glt.vms_labor_type
  LEFT JOIN
    `db_common${dataform.projectConfig.vars.region}.global_state_mapping` gsm
  ON
    req.state_province = gsm.vms_state
  LEFT JOIN
    `db_common${dataform.projectConfig.vars.region}.global_countries` gcr
  ON
    LOWER(req.country)=LOWER(gcr.country)
  LEFT JOIN
    `db_common${dataform.projectConfig.vars.region}.global_job_posting_status` grs
  ON
    grs.job_posting_status = req.req_status
  LEFT OUTER JOIN
    db_common${dataform.projectConfig.vars.region}.global_sourcing AS gbl_src
  ON
    TRIM(LOWER(gbl_src.sourcing_type)) = TRIM(LOWER(COALESCE(req.sourcing_type, req.sourcing_type_template, '')))
  LEFT JOIN
    db${dataform.projectConfig.vars.region}_yellowdata_normalization.job_titles_${dataform.projectConfig.vars.ds_name}_normalised norm_jt
  ON
    req.req_title = norm_jt.raw_job_title
  LEFT JOIN
    db${dataform.projectConfig.vars.region}_yellowdata_normalization.locations_${dataform.projectConfig.vars.ds_name}_normalised norm_loc
  ON
    COALESCE(req.city, '') = COALESCE(norm_loc.city, '')
    AND COALESCE((CASE
          WHEN IFNULL(gsm.vms_state, '') <> '' THEN gsm.vms_state
          WHEN IFNULL(req.state_province, '') = '' THEN 'Undisclosed'
          ELSE 'Unmapped'
      END
        ), '') = COALESCE(norm_loc.state, '')
    AND COALESCE(req.state_province, '') = COALESCE(norm_loc.province, '')
    AND COALESCE((CASE
          WHEN IFNULL(gcr.rsr_country, '') <> '' THEN gcr.rsr_country
          WHEN IFNULL(req.country, '') = '' THEN 'Undisclosed'
          ELSE 'Unmapped'
      END
        ), '') = COALESCE(norm_loc.country_name, '')
    AND COALESCE(req.country, '') = COALESCE(norm_loc.country_code, ''));
