config {
    type: "table",
    name: "msp_template_assignment_sowonly",
    tags: 'msp_template_sow',
    description: 'This file creates the  stdrv layer'
}
CREATE OR REPLACE TABLE `${dataform.projectConfig.vars.ds_name}.stdrv_assignment_sowonly_${dataform.projectConfig.vars.client_code}_dform_test` AS (
WITH fx_rates AS (
  SELECT
      CAST(fx_rate AS FLOAT64) AS fx_rate,
      from_currency,
      PARSE_DATE("%Y-%m-%d", month) AS month,
      to_currency
    FROM
      db_common${dataform.projectConfig.vars.region}.global_fx_rates
), asg_asg_v0 AS (
  select asg.*,
  asg_v0.assignment_create_date AS assignment_create_date_initial,
  asg_v0.assignment_activation_date AS assignment_activation_date_initial,
  asg_v0.cand_offer_accepted_date AS cand_offer_accepted_date_initial,
  EXTRACT(DATE FROM Function_library${dataform.projectConfig.vars.region}.least_array([asg.assignment_create_date,asg_v0.assignment_create_date])) AS rsr_assignment_control_date,
  DATE_TRUNC(EXTRACT(DATE FROM Function_library${dataform.projectConfig.vars.region}.least_array([asg.assignment_create_date,asg_v0.assignment_create_date])),MONTH) AS rsr_assignment_control_date_monthstart
  FROM ${dataform.projectConfig.vars.ds_name}.prs_assignment_${dataform.projectConfig.vars.client_code} AS asg
    LEFT OUTER JOIN ${dataform.projectConfig.vars.ds_name}.prs_assignment_v0_${dataform.projectConfig.vars.client_code} AS asg_v0 ON asg.assignment_id = asg_v0.assignment_id

), worker AS (
    SELECT *,
    /*
	EXTRACT(DATE FROM Function_library${dataform.projectConfig.vars.region}.least_array([CURRENT_DATETIME(),wk.worker_end_date , wk.worker_closed_date])) AS rsr_assignment_control_date,
    DATE_TRUNC(EXTRACT(DATE FROM Function_library${dataform.projectConfig.vars.region}.least_array([CURRENT_DATETIME(),wk.worker_end_date , wk.worker_closed_date])),MONTH) AS rsr_assignment_control_date_monthstart,
	*/
    Function_library${dataform.projectConfig.vars.region}.least_array([wk.worker_end_date , wk.worker_closed_date]) as reporting_date_ends
    FROM ${dataform.projectConfig.vars.ds_name}.prs_worker_${dataform.projectConfig.vars.client_code} wk
)
SELECT
    assign.buyer,
    assign.buyer_code,
    assign.assignment_id,
    assign.cand_id,
    assign.worker_id,
    assign.main_document_id,
    assign.main_document_title,
    assign.assignment_create_date,
    assign.assignment_status,
    assign.cost_center_code,
    assign.cost_center,
    assign.business_unit_code,
    assign.business_unit,
    ------------------
    assign.location_code,
    assign.location,
    assign.site_code,
    assign.site,
    -------------------
    assign.city,
    assign.state_province,
    assign.country,
    assign.supplier,
    assign.supplier_code,
    PARSE_DATE('%m/%d/%Y', global_calendar_445.calendar_reporting_month_date) AS calendar_reporting_month_date,
    -- below 4 columns need to come from Supplier IO once that data is available
    CASE
      WHEN gcr.rsr_country='United States of America' THEN div_supp.primary_diversity_type
      ELSE CAST(NULL AS STRING)
    END AS supplier_primary_diversity_type,
    CASE
      WHEN gcr.rsr_country='United States of America' THEN div_supp.small_business
      ELSE CAST(NULL AS STRING)
    END AS supplier_small_business,
    CASE
      WHEN gcr.rsr_country='United States of America' THEN div_supp.diverse_and_small
      ELSE CAST(NULL AS STRING)
    END AS supplier_diverse_small,
    CASE
      WHEN gcr.rsr_country='United States of America' THEN div_supp.supplier_id_erp
      ELSE CAST(NULL AS STRING)
    END AS supplier_erp_id,
    assign_rates.bill_rate_st_hr,
    assign_v0_rates.bill_rate_st_hr AS bill_rate_st_hr_initial,
    assign_rates.pay_rate_st_hr,
    assign_v0_rates.pay_rate_st_hr AS pay_rate_st_hr_initial,
    assign_rates.assignment_markup_st_hr , 
    assign_v0_rates.assignment_markup_st_hr AS assignment_markup_st_hr_initial,
    assign_rates.supplier_bill_rate_st_hr,
    assign_v0_rates.supplier_bill_rate_st_hr AS supplier_bill_rate_st_hr_initial,
    CAST(NULL AS FLOAT64) as max_template_bill_rate_st_hr,
    assign_rates.currency,
    worker.worker_start_date,
    -- *** below 2 columns not available in source Worker report except pki
    assign.worker_pay_type_code,
    assign.worker_pay_type_name,
    worker.worker_closed_date,
    worker.worker_end_date,
    cast(Null as DATETIME) as req_approved_date,
    worker.country AS worker_country,
    worker.consolidated_worker_id,
    worker.worker,
    cast(Null as STRING) as labor_type,
   CAST(Null AS STRING) as dist_list,
    assign.assignment_create_date_initial,
    assign.assignment_activation_date_initial,
    worker.worker_close_reason,
    -- worker.close_comments,
    gcr_worker.rsr_country as rsr_worker_country,
    global_state_mapping.rsr_state AS rsr_state,
    global_supp_map.suppliername_dw AS rsr_supplier,
    CAST(Null AS STRING) as rsr_labor_type,
    -- IFNULL(global_wo_term_reason.termination_reason_DW, 'NULL') as rsr_assignment_close_reason,
    CASE 
      WHEN IFNULL(global_wo_term_reason.termination_reason_DW, '') <> '' THEN global_wo_term_reason.termination_reason_DW
      WHEN IFNULL(worker.worker_close_reason, '') = '' THEN 'Undisclosed'
      WHEN global_wo_term_reason.termination_reason_DW IS NULL THEN 'Unmapped'
      ELSE 'Unmapped'
    END AS rsr_assignment_close_reason,
    -- IFNULL(global_wo_term_reason.termination_close_rating_DW, 'NULL') AS rsr_assignment_close_rating,
    CASE 
      WHEN IFNULL(global_wo_term_reason.termination_close_rating_DW, '') <> '' THEN global_wo_term_reason.termination_close_rating_DW
      WHEN IFNULL(worker.worker_close_reason, '') = '' THEN 'Undisclosed'
      WHEN global_wo_term_reason.termination_close_rating_DW IS NULL THEN 'Unmapped'
      ELSE 'Unmapped'
    END AS rsr_assignment_close_rating,
    CASE
        WHEN lower(assign.main_document_type) = lower('Contract') THEN 'Contingent'
        WHEN lower(assign.main_document_type) = lower('Service Request') THEN 'Contingent'
        WHEN lower(assign.main_document_type) = lower('Contingent Labor Request') THEN 'Contingent'
        WHEN lower(assign.main_document_type) = lower('Job Posting') THEN 'Contingent'
        WHEN lower(assign.main_document_type) = lower('Non-Employee Posting') THEN 'Contingent'
        WHEN lower(assign.main_document_type) = lower('Requisition') THEN 'Contingent'
        WHEN lower(assign.main_document_type) = lower('Temp Order') THEN 'Contingent'
        WHEN lower(assign.main_document_type) = lower('Statement of Work') THEN 'SOW'
        WHEN lower(assign.main_document_type) = lower('Independent Contractor') THEN 'SOW'
        WHEN lower(assign.main_document_type) = lower('SOW Contract') THEN 'SOW'
        WHEN assign.main_document_id LIKE '%JP%' THEN 'Contingent'
        WHEN assign.main_document_id LIKE '%TQ%' THEN 'SOW'
        ELSE 'NULL'
    END AS contingent_vs_sow,
    worker.reporting_date_ends,
    CASE
        WHEN worker.worker_end_date < CURRENT_DATE() THEN 'Closed'
        ELSE worker.worker_status
    END AS worker_status,
    CAST(NULL AS FLOAT64) as time_to_fill_cd,
   CAST(NULL AS FLOAT64) as time_to_fill_bd,
   CAST(NULL AS FLOAT64) as approve_to_submit_cd,
  CAST(NULL AS FLOAT64) as approve_to_submit_bd, 
    CAST(NULL AS STRING) as compliance_vs_max_bill_rate,
    CAST(NULL AS STRING) as compliance_vs_max_template_bill_rate,
    ROUND(CASE
            WHEN assign_rates.pay_rate_st_hr = 0 THEN 0.0000
            ELSE (assign_rates.bill_rate_st_hr / assign_rates.pay_rate_st_hr - 1)
        END
    , 4) AS markup, 
    CASE
        WHEN assign_rates.currency = 'USD' THEN 1.0
        ELSE CAST(fx_usd.fx_rate AS NUMERIC)
    END AS usd_fx_rate,
    CASE
        WHEN assign_rates.currency = 'EUR' THEN 1.0
        ELSE CAST(fx_eur.fx_rate AS NUMERIC)
    END AS eur_fx_rate,
    CASE
        WHEN assign_rates.currency = 'GBP' THEN 1.0
        ELSE CAST(fx_gbp.fx_rate AS NUMERIC)
    END AS gbp_fx_rate,
    CASE
        WHEN assign_rates.currency = 'INR' THEN 1.0
        ELSE CAST(fx_inr.fx_rate AS NUMERIC)
    END AS inr_fx_rate,
    CASE
        WHEN assign_rates.currency = 'CAD' THEN 1.0
        ELSE CAST(fx_cad.fx_rate AS NUMERIC)
    END AS cad_fx_rate,
    CASE
        WHEN assign_rates.currency = 'USD' THEN assign_rates.bill_rate_st_hr
        ELSE assign_rates.bill_rate_st_hr * CAST(fx_usd.fx_rate AS NUMERIC)
    END AS bill_rate_st_hr_usd,
    CASE
        WHEN assign_rates.currency = 'EUR' THEN assign_rates.bill_rate_st_hr
        ELSE assign_rates.bill_rate_st_hr * CAST(fx_eur.fx_rate AS NUMERIC)
    END AS bill_rate_st_hr_eur,
    CASE
        WHEN assign_rates.currency = 'GBP' THEN assign_rates.bill_rate_st_hr
        ELSE assign_rates.bill_rate_st_hr * CAST(fx_gbp.fx_rate AS NUMERIC)
    END AS bill_rate_st_hr_gbp,
    CASE
        WHEN assign_rates.currency = 'INR' THEN assign_rates.bill_rate_st_hr
        ELSE assign_rates.bill_rate_st_hr * CAST(fx_inr.fx_rate AS NUMERIC)
    END AS bill_rate_st_hr_inr,
    CASE
        WHEN assign_rates.currency = 'CAD' THEN assign_rates.bill_rate_st_hr
        ELSE assign_rates.bill_rate_st_hr * CAST(fx_cad.fx_rate AS NUMERIC)
    END AS bill_rate_st_hr_cad,
    assign.rsr_assignment_control_date,
    CASE
      WHEN coalesce(Function_library${dataform.projectConfig.vars.region}.f_calendarday(worker.worker_start_date, worker.worker_end_date), CAST(0 as NUMERIC)) <= 60 THEN '< 2 months'
      WHEN coalesce(Function_library${dataform.projectConfig.vars.region}.f_calendarday(worker.worker_start_date, worker.worker_end_date), CAST(0 as NUMERIC)) <= 181 THEN '2 - 6 months'
      WHEN coalesce(Function_library${dataform.projectConfig.vars.region}.f_calendarday(worker.worker_start_date, worker.worker_end_date), CAST(0 as NUMERIC)) <= 365 THEN '6 - 12 months'
      WHEN  coalesce(Function_library${dataform.projectConfig.vars.region}.f_calendarday(worker.worker_start_date, worker.worker_end_date), CAST(0 as NUMERIC)) <= 730 THEN '1 - 2 years'
      ELSE '2 + years'
    END AS planned_tenure_buckets,
	CASE
      WHEN coalesce(Function_library${dataform.projectConfig.vars.region}.f_calendarday(worker.worker_start_date, CAST(current_timestamp() AS DATETIME)), CAST(0 as NUMERIC)) <= 60 THEN '< 2 months'
      WHEN coalesce(Function_library${dataform.projectConfig.vars.region}.f_calendarday(worker.worker_start_date, CAST(current_timestamp() AS DATETIME)), CAST(0 as NUMERIC)) <= 181 THEN '2 - 6 months'
      WHEN coalesce(Function_library${dataform.projectConfig.vars.region}.f_calendarday(worker.worker_start_date, CAST(current_timestamp() AS DATETIME)), CAST(0 as NUMERIC)) <= 365 THEN '6 - 12 months'
      WHEN coalesce(Function_library${dataform.projectConfig.vars.region}.f_calendarday(worker.worker_start_date, CAST(current_timestamp() AS DATETIME)), CAST(0 as NUMERIC)) <= 730 THEN '1 - 2 years'
      ELSE '2 + years'
    END AS current_tenure_buckets,
    COALESCE(global_sourcing_type_wk.sourced_type_assignment, global_sourcing_type_wo.sourced_type_assignment)  AS rsr_sourced_type,
    CURRENT_DATE() as current_date,
    Function_library${dataform.projectConfig.vars.region}.f_calendarday(worker.worker_start_date, worker.worker_end_date) AS planned_tenure_cd,
	Function_library${dataform.projectConfig.vars.region}.f_calendarday(worker.worker_start_date, CAST(current_timestamp() AS DATETIME)) AS current_tenure_cd,
	CAST(Function_library${dataform.projectConfig.vars.region}.f_calendarday(assign.assignment_create_date_initial, worker.first_assignment_original_start_date) AS INT64) AS create_to_start_cd,
    ROUND(Function_library${dataform.projectConfig.vars.region}.f_workday(assign.assignment_create_date_initial, worker.first_assignment_original_start_date), 4) AS create_to_start_bd,
    CAST(NULL AS STRING) AS vendor_id,
	-- fields needed for other msts
    CAST(NULL AS FLOAT64) as max_requested_bill_rate_st_hr,
    CAST(NULL AS STRING) as primary_cost_center,
    CAST(NULL AS FLOAT64) as presented_bill_rate_st_hr,
	assign.main_document_type,
	-- worker.worker_job_code,
	worker.site as site_wk,
	-- worker.location as location_wk,
	-- worker.city as city_wk,
	-- worker.state_province as stateprovince_wk,
	-- worker.country as country_wk,
	-- worker.zip_postal_code as zip_postal_code_wk,
	assign.sourcing_type_wo,    
	assign.sourcing_type_wk,
	global_sourcing_type_wk.sourced_type_assignment as sourcing_type_wk_mapped,
	global_sourcing_type_wo.sourced_type_assignment as sourcing_type_wo_mapped,
	CAST(Null AS STRING) as req_id,
	CAST(Null AS STRING) as req_title,
	CAST(Null AS STRING) as req_title_classification,
	CAST(Null AS STRING) as req_type,
	cast(Null as datetime) as req_create_date,
	cast(Null as datetime) as req_closed_date,
	cast(Null as date) as req_end_date,
    gcr.rsr_country,
	gcr.rsr_region,
	CAST(Null AS STRING) as posting_type,
	assign.cand_offer_accepted_date_initial as cand_offer_accepted_date,
	'${dataform.projectConfig.vars.client_code}' as rsr_client_code,
    assign.rsr_processed_date,
    CASE
        WHEN assign_rates.currency = 'USD' THEN assign_rates.pay_rate_st_hr
        ELSE assign_rates.pay_rate_st_hr * CAST(fx_usd.fx_rate AS NUMERIC)
    END AS pay_rate_st_hr_usd,
    CASE
        WHEN assign_rates.currency = 'EUR' THEN assign_rates.pay_rate_st_hr
        ELSE assign_rates.pay_rate_st_hr * CAST(fx_eur.fx_rate AS NUMERIC)
    END AS pay_rate_st_hr_eur,
    CASE
        WHEN assign_rates.currency = 'GBP' THEN assign_rates.pay_rate_st_hr
        ELSE assign_rates.pay_rate_st_hr * CAST(fx_gbp.fx_rate AS NUMERIC)
    END AS pay_rate_st_hr_gbp,
    CASE
        WHEN assign_rates.currency = 'INR' THEN assign_rates.pay_rate_st_hr
        ELSE assign_rates.pay_rate_st_hr * CAST(fx_inr.fx_rate AS NUMERIC)
    END AS pay_rate_st_hr_inr,
    CASE
        WHEN assign_rates.currency = 'CAD' THEN assign_rates.pay_rate_st_hr
        ELSE assign_rates.pay_rate_st_hr * CAST(fx_cad.fx_rate AS NUMERIC)
    END AS pay_rate_st_hr_cad
    ,CAST(NULL AS STRING) AS preferred_supplier_status
  FROM
    asg_asg_v0 AS assign
    -- LEFT OUTER JOIN ${dataform.projectConfig.vars.ds_name}.stdrv_requisition_${dataform.projectConfig.vars.client_code} AS req ON assign.main_document_id = req.req_id
    LEFT OUTER JOIN worker ON assign.assignment_id = worker.assignment_id 
    left join `db_common${dataform.projectConfig.vars.region}.global_countries` gcr_worker on lower(worker.country) = lower(gcr_worker.country) 
    LEFT OUTER JOIN ${dataform.projectConfig.vars.ds_name}.prs_assignment_rates_${dataform.projectConfig.vars.client_code} AS assign_rates ON assign.assignment_id = assign_rates.assignment_id
    LEFT OUTER JOIN ${dataform.projectConfig.vars.ds_name}.prs_assignment_rates_v0_${dataform.projectConfig.vars.client_code} AS assign_v0_rates ON assign.assignment_id = assign_v0_rates.assignment_id
   -- LEFT OUTER JOIN ${dataform.projectConfig.vars.ds_name}.prs_candidate_${dataform.projectConfig.vars.client_code} AS cand ON assign.main_document_id = cand.req_id AND assign.cand_id = cand.cand_id
    LEFT OUTER JOIN db_common${dataform.projectConfig.vars.region}.global_wo_term_reason AS global_wo_term_reason ON worker.worker_close_reason = global_wo_term_reason.work_order_close_reason
--    LEFT OUTER JOIN db_common${dataform.projectConfig.vars.region}.global_term_closing_rating AS global_term_closing_rating 
--        ON global_wo_term_reason.termination_reason_DW = global_term_closing_rating.termination_reason_dw
    LEFT OUTER JOIN db_common${dataform.projectConfig.vars.region}.global_state_mapping AS global_state_mapping ON assign.state_province = global_state_mapping.vms_state
    LEFT OUTER JOIN db_common${dataform.projectConfig.vars.region}.global_sourcing_type_assignment AS global_sourcing_type_wo 
        ON assign.sourcing_type_wo = global_sourcing_type_wo.vms_source_type
	LEFT OUTER JOIN db_common${dataform.projectConfig.vars.region}.global_sourcing_type_assignment AS global_sourcing_type_wk 
        ON assign.sourcing_type_wk = global_sourcing_type_wk.vms_source_type
    left join `db_common${dataform.projectConfig.vars.region}.global_countries` gcr on lower(assign.country) = lower(gcr.country)
    LEFT OUTER JOIN db_common${dataform.projectConfig.vars.region}.global_supplier_mapping AS global_supp_map ON assign.buyer = global_supp_map.buyer AND assign.supplier = global_supp_map.supplier
    LEFT OUTER JOIN db_common${dataform.projectConfig.vars.region}.global_calendar_445 AS global_calendar_445 ON assign.rsr_assignment_control_date = PARSE_DATE("%m/%d/%Y", global_calendar_445.day)
	LEFT JOIN fx_rates fx_usd ON assign_rates.currency = fx_usd.from_currency AND assign.rsr_assignment_control_date_monthstart=fx_usd.month AND fx_usd.to_currency = 'USD'
    LEFT JOIN fx_rates fx_eur ON assign_rates.currency = fx_eur.from_currency AND assign.rsr_assignment_control_date_monthstart=fx_eur.month AND fx_eur.to_currency = 'EUR'
    LEFT JOIN fx_rates fx_gbp ON assign_rates.currency = fx_gbp.from_currency AND assign.rsr_assignment_control_date_monthstart=fx_gbp.month AND fx_gbp.to_currency = 'GBP'
    LEFT JOIN fx_rates fx_inr ON assign_rates.currency = fx_inr.from_currency AND assign.rsr_assignment_control_date_monthstart=fx_inr.month AND fx_inr.to_currency = 'INR' 
    LEFT JOIN fx_rates fx_cad ON assign_rates.currency = fx_cad.from_currency AND assign.rsr_assignment_control_date_monthstart=fx_cad.month AND fx_cad.to_currency = 'CAD'
    LEFT JOIN db${dataform.projectConfig.vars.region}_aptus.aptus_suppio_supplier_diversity_data div_supp ON lower(div_supp.customer_code)=lower(assign.buyer_code) AND div_supp.supplier_code=assign.supplier_code AND div_supp.fiscal_year=CAST(EXTRACT(YEAR FROM CAST(assign.assignment_create_date AS DATE)) AS INTEGER) AND div_supp.accounting_period=CAST(EXTRACT(MONTH FROM CAST(assign.assignment_create_date AS DATE)) AS INTEGER)
)