config {
    type: "operations",
    name: "msp_template_sow_bid",
    tags: 'msp_template_sow',
    description: 'This file creates the  stdrv layer'
}
js {
    const {
        getCompleteTableConfig
    } = require("includes/table_config");
    const config = getCompleteTableConfig(ctx);
    const baseTables = config.baseTables.defaults;
}

DECLARE
  req_table_id STRING;
DECLARE
  gold_dataset STRING;

EXECUTE IMMEDIATE
  FORMAT ('''
  SELECT
  DISTINCT table_id,
  FROM
  `${dataform.projectConfig.vars.config_dataset}.ext_slvr_schema_cfg`
    WHERE standard_report_type = 'requisition_src' and dataset_id = '${dataform.projectConfig.vars.dataset_id}' LIMIT 1
''' )INTO req_table_id;

IF req_table_id IS NULL THEN
  RAISE USING MESSAGE = 'REQUSITION TABLE ID IS MISSING FROM CONFIGS';
END IF;

SET
  gold_dataset = CONCAT("dev","_gold_","${dataform.projectConfig.vars.dataset_id}");

EXECUTE IMMEDIATE FORMAT ("""

CREATE OR REPLACE TABLE `${dataform.projectConfig.vars.ds_name}.stdrv_sow_bid_${dataform.projectConfig.vars.client_code}` AS (
SELECT
  sow_bid.buyer,
  sow_bid.buyer_code,
  sow.city,
  sow.classification,
  sow_bid.close_reason,
  sow.country,
  sow_bid.created_from_sow_bid_id,
  sow_bid.currency,
  sow_bid.sow,
  sow_bid.sow_bid,
  sow_bid.sow_bid_approved_date,
  sow_bid.sow_bid_create_date,
  sow_bid.sow_bid_id,
  sow_bid.sow_bid_response_close_date,
  sow_bid.sow_bid_response_id,
  sow_bid.sow_bid_response_status,
  sow_bid.sow_bid_status,
  sow_bid.sow_id,
  sow.state,
  sow_bid.supplier,
  sow_bid.supplier_code,
  sow.sow_create_date,
  sow_acc.original_maximum_budget_amount,
  sow_v0.sow_create_date_initial,
  gcr.rsr_country as rsr_country,
  COALESCE(gsm.suppliername_dw, CAST(NULL AS STRING)) AS rsr_supplier,
  gbl_sow.service_category_classification as rsr_classification,
  CASE
    WHEN COALESCE(TRIM(sow_bid.sow_id), CAST(NULL AS STRING)) IS NULL THEN 0
    ELSE 1
  END AS bids_won_cnt,
  CASE
    WHEN sow_bid.sow_bid_response_status IN ('Declined', 'Withdrawn') OR sow_bid.supplier_code IS NULL THEN 0
    ELSE 1
  END AS submittal_bid_id,
  CASE
    WHEN sow_bid.sow_bid_response_status IN ('Declined', 'Withdrawn') OR sow_bid.sow_bid_response_id IS NULL THEN 0
    ELSE 1
  END AS response_bid_id,
  Function_library${dataform.projectConfig.vars.region}.f_workday(sow_bid.sow_bid_create_date,sow_bid.sow_bid_submit_date) AS bid_create_to_submit_bd,
  Function_library${dataform.projectConfig.vars.region}.f_workday(sow_bid.sow_bid_submit_date,sow_bid.sow_bid_approved_date) AS bid_submit_to_approve_bd,
  Function_library${dataform.projectConfig.vars.region}.f_workday(sow_bid.sow_bid_approved_date,sow_bid.sow_bid_respond_date) AS bid_approved_to_supplier_response_bd,
  Function_library${dataform.projectConfig.vars.region}.f_workday(sow_bid.sow_bid_respond_date,sow_bid.last_sow_bid_response_reject_date) AS bid_response_to_last_response_reject_bd,
  Function_library${dataform.projectConfig.vars.region}.f_workday(sow_bid.last_sow_bid_response_reject_date,sow_v0.sow_create_date_initial) AS bid_last_response_reject_to_create_bd,
  Function_library${dataform.projectConfig.vars.region}.f_workday(sow_bid.sow_bid_create_date,sow_v0.sow_create_date_initial) AS bid_to_sow_create_bd,
  sow_bid.presented_budget,
  sow_bid.last_sow_bid_response_reject_date,
  sow_bid.classification_0,
  sow_bid.classification_1,
  sow_bid.classification_2,
  sow_bid.classification_3,
  supplier.rsr_vendor_id,
  sow_bid.distribute_time,
  sow_bid.sow_bid_response_time
FROM ${dataform.projectConfig.vars.ds_name}.prs_sow_bid_${dataform.projectConfig.vars.client_code} sow_bid
LEFT JOIN ${dataform.projectConfig.vars.ds_name}.prs_sow_${dataform.projectConfig.vars.client_code} sow ON sow_bid.sow_bid_id = sow.created_from_sow_bid_id
LEFT JOIN ${dataform.projectConfig.vars.ds_name}.prs_sow_accounting_${dataform.projectConfig.vars.client_code} sow_acc ON sow.sow_id = sow_acc.sow_id
LEFT JOIN ${dataform.projectConfig.vars.ds_name}.prs_sow_v0_${dataform.projectConfig.vars.client_code} sow_v0 ON sow.sow_id = sow_v0.sow_id
LEFT JOIN ${dataform.projectConfig.vars.ds_name}.prs_supplier_${dataform.projectConfig.vars.client_code} supplier ON sow_bid.supplier_code = supplier.supplier_code
LEFT JOIN db_common${dataform.projectConfig.vars.region}.global_countries gcr on lower(sow.country)=lower(gcr.country)
LEFT JOIN db_common${dataform.projectConfig.vars.region}.global_supplier_mapping gsm ON gsm.buyer = sow_bid.buyer AND gsm.supplier = sow_bid.supplier
LEFT JOIN db_common${dataform.projectConfig.vars.region}.global_sow_classification gbl_sow ON gbl_sow.sub_categories_to_match_those_used_in_the_vms = sow.classification)