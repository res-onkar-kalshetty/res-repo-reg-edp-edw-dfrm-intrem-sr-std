config {
    type: "operations",
    name: "msp_template_sow_non_worker_gold",
    tags: 'msp_template_sow_gold',
    description: 'This file creates the  stdrv layer'
}
js {
    const helper = require("/includes/helper");

    const config_ds_name = helper.get_config_ds();
    const config_table_name = helper.get_config_table();
    const env = helper.get_env();
    const region = helper.get_region();
    const dataset_id = dataform.projectConfig.vars.dataset_id;

    const gold_dataset = (env == "prd") ?
        `gold_${dataset_id}` :
        `dev_gold_${dataset_id}`;

    const slvr_dataset = (env == "prd") ?
        `slvr_${dataset_id}` :
        `dev_slvr_${dataset_id}`;

    const slvr_sow_linw = helper.getSlvrTableName(config_ds_name, config_table_name, 'sow_linw_src', dataset_id);
    const slvr_supplier = helper.getSlvrTableName(config_ds_name, config_table_name, 'supplier_src', dataset_id);
    const slvr_sow = helper.getSlvrTableName(config_ds_name, config_table_name, 'sow_src', dataset_id);

}

DECLARE
  sow_non_worker_table_id STRING;
DECLARE
  gold_dataset STRING;
DECLARE
  slvr_dataset STRING;
DECLARE
  config_ds_name STRING;
DECLARE
  config_table_name STRING;
DECLARE
  region STRING;
DECLARE
  slvr_sow_linw STRING;
DECLARE
  slvr_supplier STRING;
DECLARE
  slvr_sow STRING;
SET
  config_ds_name = '${config_ds_name}';
SET
  config_table_name = '${config_table_name}';
SET
  region = '${region}';
SET
  gold_dataset = '${gold_dataset}';
SET
  slvr_dataset = '${slvr_dataset}';
SET
  slvr_sow_linw= 't_' || ${slvr_sow_linw};
SET
  slvr_supplier = 't_' || ${slvr_supplier};
SET
  slvr_sow= 't_' || ${slvr_sow};
EXECUTE IMMEDIATE
  FORMAT ('''
  SELECT
  DISTINCT 'v_' || table_id,
  FROM
  `%s.%s`
    WHERE entity_type = 'sow_linw_src' and dataset_id = '${dataform.projectConfig.vars.dataset_id}' LIMIT 1
''', config_ds_name,config_table_name) INTO sow_non_worker_table_id;
IF
  sow_non_worker_table_id IS NULL THEN RAISE
USING
  MESSAGE = 'REQUISITION TABLE ID IS MISSING FROM CONFIGS';
END IF
  ;

EXECUTE IMMEDIATE FORMAT ("""
CREATE OR REPLACE VIEW `%s.%s` AS (
SELECT
  sow_details.business_unit_code,
  sow_details.city,
  sow_details.classification,
  sow_details.country,
  sow_details.sow_closed_date,
  sow_details.sow_create_date,
  sow_details.sow_status,
  sow_details.state,
  sow_nonworker.business_unit,
  sow_nonworker.buyer,
  sow_nonworker.buyer_code,
  sow_nonworker.committed_amount,
  sow_nonworker.due_on_date_of_sow_line_item,
  sow_nonworker.end_date,
  sow_nonworker.line_item_approved_date,
  sow_nonworker.line_item_completed_date,
  sow_nonworker.line_item_date,
  sow_nonworker.line_item_id,
  sow_nonworker.line_item_status,
  sow_nonworker.line_item_type,
  sow_nonworker.net_amount,
  sow_nonworker.requested_amount,
  sow_nonworker.sow_id,
  sow_nonworker.start_date,
  sow_nonworker.supplier,
  sow_nonworker.supplier_code,
  COALESCE(gsm.suppliername_dw, CAST(NULL AS STRING)) AS rsr_supplier,
    CASE
    WHEN sow_nonworker.line_item_completed_date < sow_nonworker.due_on_date_of_sow_line_item THEN 'Ahead of Schedule'
    WHEN sow_nonworker.line_item_completed_date = sow_nonworker.due_on_date_of_sow_line_item THEN 'On-time'
    WHEN sow_nonworker.line_item_completed_date > sow_nonworker.due_on_date_of_sow_line_item THEN 'Late'
    ELSE CAST(NULL AS STRING)
  END AS ontime_completion,
  CASE
    WHEN sow_nonworker.committed_amount > sow_nonworker.requested_amount THEN 'Over Budget'
    WHEN sow_nonworker.committed_amount = sow_nonworker.requested_amount THEN 'At Budget'
    WHEN sow_nonworker.committed_amount < sow_nonworker.requested_amount THEN 'Under Budget'
    ELSE CAST(NULL AS STRING)
  END AS budget_compliance,
  sow_details.classification_0,
  sow_details.classification_1,
  sow_details.classification_2,
  sow_details.classification_3,
  sow_supplier.rsr_vendor_id,
  sow_nonworker.line_item_submit_date
FROM ${slvr_dataset}.%s  sow_nonworker
LEFT JOIN ${slvr_dataset}.%s  sow_details ON sow_details.sow_id = sow_nonworker.sow_id
LEFT JOIN ${slvr_dataset}.%s sow_supplier ON sow_supplier.supplier_code = sow_nonworker.supplier_code
LEFT JOIN db_common${region}.global_supplier_mapping gsm ON gsm.buyer = sow_nonworker.buyer AND gsm.supplier = sow_nonworker.supplier)""",
gold_dataset,sow_non_worker_table_id,
slvr_sow_linw,
slvr_sow,
slvr_supplier)