config {
    type: "operations",
    name: "msp_template_sow_non_worker_gold",
    tags: 'msp_template_sow_gold',
    description: 'This file creates the  stdrv layer'
}
CREATE OR REPLACE TABLE `${dataform.projectConfig.vars.ds_name}.stdrv_sow_non_worker_${dataform.projectConfig.vars.client_code}` AS (
SELECT
  sow_details.business_unit_code,
  sow_details.city,
  sow_details.classification,
  sow_details.country,
  sow_details.sow_closed_date,
  sow_details.sow_create_date,
  sow_details.sow_status,
  sow_details.state,
  sow_nonworker.business_unit,
  sow_nonworker.buyer,
  sow_nonworker.buyer_code,
  sow_nonworker.committed_amount,
  sow_nonworker.due_on_date_of_sow_line_item,
  sow_nonworker.end_date,
  sow_nonworker.line_item_approved_date,
  sow_nonworker.line_item_completed_date,
  sow_nonworker.line_item_date,
  sow_nonworker.line_item_id,
  sow_nonworker.line_item_status,
  sow_nonworker.line_item_type,
  sow_nonworker.net_amount,
  sow_nonworker.requested_amount,
  sow_nonworker.sow_id,
  sow_nonworker.start_date,
  sow_nonworker.supplier,
  sow_nonworker.supplier_code,
  COALESCE(gsm.suppliername_dw, CAST(NULL AS STRING)) AS rsr_supplier,
    CASE
    WHEN sow_nonworker.line_item_completed_date < sow_nonworker.due_on_date_of_sow_line_item THEN 'Ahead of Schedule'
    WHEN sow_nonworker.line_item_completed_date = sow_nonworker.due_on_date_of_sow_line_item THEN 'On-time'
    WHEN sow_nonworker.line_item_completed_date > sow_nonworker.due_on_date_of_sow_line_item THEN 'Late'
    ELSE CAST(NULL AS STRING)
  END AS ontime_completion,
  CASE
    WHEN sow_nonworker.committed_amount > sow_nonworker.requested_amount THEN 'Over Budget'
    WHEN sow_nonworker.committed_amount = sow_nonworker.requested_amount THEN 'At Budget'
    WHEN sow_nonworker.committed_amount < sow_nonworker.requested_amount THEN 'Under Budget'
    ELSE CAST(NULL AS STRING)
  END AS budget_compliance,
  sow_details.classification_0,
  sow_details.classification_1,
  sow_details.classification_2,
  sow_details.classification_3,
  sow_supplier.rsr_vendor_id,
  sow_nonworker.line_item_submit_date
FROM ${dataform.projectConfig.vars.ds_name}.prs_sow_line_item_non_worker_${dataform.projectConfig.vars.client_code}  sow_nonworker
LEFT JOIN ${dataform.projectConfig.vars.ds_name}.prs_sow_${dataform.projectConfig.vars.client_code}  sow_details ON sow_details.sow_id = sow_nonworker.sow_id
LEFT JOIN ${dataform.projectConfig.vars.ds_name}.prs_supplier_${dataform.projectConfig.vars.client_code} sow_supplier ON sow_supplier.supplier_code = sow_nonworker.supplier_code
LEFT JOIN db_common${dataform.projectConfig.vars.region}.global_supplier_mapping gsm ON gsm.buyer = sow_nonworker.buyer AND gsm.supplier = sow_nonworker.supplier)