config {
    type: "operations",
    description: "Dynamically creates the anonymized table for requisition_distributions.",
    dependencies: "msp_template_requisition_distribution_gold",
    tags: ["msp_template_gold_anmz"]
}

js {
    const anonymization = require("includes/anonymization");
    const helper = require("/includes/helper");
    const config_ds_name = helper.get_config_ds();
    const config_table_name = helper.get_config_table();
    const env = helper.get_env();
    const region = helper.get_region();
    // Get region_code for the hardcoded dataset name (emea, nam, or apac)
    const region_code = helper.get_region_code(); 
    
    const dataset_id = dataform.projectConfig.vars.dataset_id;
    
    const gold_dataset = (env == "prd") ?
     `gold_${dataset_id}` : 
     `dev_gold_${dataset_id}`;
     
    const anmz_dataset =
     `db_anmz_${region_code}_requisition_distribution_stdschema`;
}

DECLARE requisition_distribution_table_id STRING;
DECLARE gold_dataset STRING;
DECLARE config_ds_name STRING;
DECLARE config_table_name STRING;
DECLARE select_clause STRING;
DECLARE final_ddl_statement STRING;
DECLARE region STRING;

SET gold_dataset='${gold_dataset}';
SET config_ds_name = '${config_ds_name}';
SET config_table_name = '${config_table_name}';
SET region='${region}';

-- -- Find the stdrv_ table in Gold
-- EXECUTE IMMEDIATE
--   FORMAT ('''
--   SELECT DISTINCT table_id FROM `%s.%s`
--   WHERE entity_type = 'requisition_distribution_src' AND dataset_id = '${dataform.projectConfig.vars.dataset_id}' LIMIT 1
-- ''', config_ds_name, config_table_name) INTO requisition_distribution_table_id;

SET requisition_distribution_table_id = CONCAT('stdrv_requisition_distribution_', '${dataform.projectConfig.vars.client_code}');

IF
  requisition_distribution_table_id IS NULL THEN RAISE
USING
  MESSAGE = 'requisition_distribution TABLE ID IS MISSING FROM CONFIGS';
END IF
  ;

-- Generate Anonymization logic
EXECUTE IMMEDIATE
  FORMAT("""${
        anonymization.get_anonymized_select_clause({
            report_type: "requisition_distribution",
            solution: "MSP",
            metadata_table: "common%s.master_template_report_fields"
        })
    }""", region) INTO select_clause;

-- Create anmz table in the dynamic region-based dataset
SET final_ddl_statement = FORMAT("""
  CREATE OR REPLACE TABLE `${anmz_dataset}.anmz_requisition_distribution_${dataform.projectConfig.vars.client_code}` AS (
    SELECT %s FROM `%s.%s`
  )
""", select_clause, gold_dataset, requisition_distribution_table_id );

EXECUTE IMMEDIATE final_ddl_statement;