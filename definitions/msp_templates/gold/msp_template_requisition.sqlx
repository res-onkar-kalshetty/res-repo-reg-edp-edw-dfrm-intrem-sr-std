config {
    type: "operations",
    name: "msp_template_requisition_gold",
    tags: "msp_template_gold"
}

js {
    const helper = require("/includes/helper");
    const source_builder = require("/includes/resilient_source");

    const config_ds_name = helper.get_config_ds();
    const config_table_name = helper.get_config_table();
    const env = helper.get_env();
    const region = helper.get_region();
    const dataset_id = dataform.projectConfig.vars.dataset_id;

    const gold_dataset = (env == "prd") ?
        `gold_${dataset_id}` :
        `dev_gold_${dataset_id}`;

    const slvr_dataset = (env == "prd") ?
        `slvr_${dataset_id}` :
        `dev_slvr_${dataset_id}`;

    const slvr_req = helper.getSlvrTableName(config_ds_name, config_table_name, 'requisition_src', dataset_id);
    const slvr_cand = helper.getSlvrTableName(config_ds_name, config_table_name, 'candidate_src', dataset_id);
    const slvr_req_tmp = helper.getSlvrTableName(config_ds_name, config_table_name, 'requisition_template_src', dataset_id);
    const slvr_assgn = helper.getSlvrTableName(config_ds_name, config_table_name, 'assignment_src', dataset_id);
    const slvr_req_dist = helper.getSlvrTableName(config_ds_name, config_table_name, 'requisition_distribution_src', dataset_id);

}

DECLARE
  resilient_req_cte_sql STRING;
DECLARE
  resilient_cand_cte_sql STRING;
DECLARE
  resilient_req_tmp_cte_sql STRING;
DECLARE
  resilient_assgn_cte_sql STRING;
DECLARE
  resilient_req_dist_cte_sql STRING;
DECLARE
  requisition_table_id STRING;
DECLARE
  gold_dataset STRING;
DECLARE
  slvr_dataset STRING;
DECLARE
  config_ds_name STRING;
DECLARE
  config_table_name STRING;
DECLARE
  region STRING;
DECLARE
  slvr_req STRING;
DECLARE
  slvr_cand STRING;
DECLARE
  slvr_req_tmp STRING;
DECLARE
  slvr_assgn STRING;
DECLARE
  slvr_req_dist STRING;
  -- Declare temporary variables to hold the query strings
DECLARE
  req_query STRING;
DECLARE
  cand_query STRING;
DECLARE
  req_tmp_query STRING;
DECLARE
  assgn_query STRING;
DECLARE
  req_dist_query STRING;
SET
  config_ds_name = '${config_ds_name}';
SET
  config_table_name = '${config_table_name}';
SET
  region = '${region}';
SET
  gold_dataset = '${gold_dataset}';
SET
  slvr_dataset = '${slvr_dataset}';
SET
  slvr_req = 'v_' || ${slvr_req};
SET
  slvr_cand = 'v_' || ${slvr_cand};
SET
  slvr_req_tmp = 'v_' || ${slvr_req_tmp};
SET
  slvr_assgn = 'v_' || ${slvr_assgn};
SET
  slvr_req_dist = 'v_' || ${slvr_req_dist};
SET
  requisition_table_id="stdrv_requisition_" || '${dataform.projectConfig.vars.client_code}';

SET
  req_query = """${source_builder.resilient_source(slvr_req, slvr_dataset, config_ds_name, 'requisition_src', 'gold_requisition','fg')}""";
SET
  cand_query = """${source_builder.resilient_source(slvr_cand, slvr_dataset, config_ds_name, 'candidate_src', 'gold_requisition','fg')}""";
SET
  req_tmp_query = """${source_builder.resilient_source(slvr_req_tmp, slvr_dataset, config_ds_name, 'requisition_template_src', 'gold_requisition','fg')}""";
SET
  assgn_query = """${source_builder.resilient_source(slvr_assgn, slvr_dataset, config_ds_name, 'assignment_src', 'gold_requisition','fg')}""";
SET
  req_dist_query = """${source_builder.resilient_source(slvr_req_dist, slvr_dataset, config_ds_name, 'requisition_distribution_src', 'gold_requisition','fg')}""";

  -- Execute the variables into your CTE strings
EXECUTE IMMEDIATE
  req_query INTO resilient_req_cte_sql;
EXECUTE IMMEDIATE
  cand_query INTO resilient_cand_cte_sql;
EXECUTE IMMEDIATE
  req_tmp_query INTO resilient_req_tmp_cte_sql;
EXECUTE IMMEDIATE
  assgn_query INTO resilient_assgn_cte_sql;
EXECUTE IMMEDIATE
  req_dist_query INTO resilient_req_dist_cte_sql;
EXECUTE IMMEDIATE
  FORMAT ("""
CREATE OR REPLACE TABLE %s.%s AS (
WITH resilient_req AS (SELECT %s FROM %s.%s AS T_SOURCE),
resilient_cand AS (SELECT %s FROM %s.%s AS T_SOURCE),
resilient_req_tmp AS (SELECT %s FROM %s.%s AS T_SOURCE),
resilient_assgn AS (SELECT %s FROM %s.%s AS T_SOURCE),
resilient_req_dist AS (SELECT %s FROM %s.%s AS T_SOURCE),
candidate_data AS
(SELECT
	buyer_code
	,req_id
	,min(cand_submit_date) as first_cand_submitted_date
	,count(distinct cand_id) as cand_submitted_cnt
	,count(DISTINCT supplier) AS suppliers_responded_cnt
from resilient_cand
group by req_id,buyer_code
) ,
req_temp_data AS
(select
	req_id,
	buyer_code,
	max_template_bill_rate_st_hr,
	max_template_bill_rate_st_day,
	max_template_bill_rate_st_week,
	max_template_bill_rate_st_month
FROM resilient_req_tmp
),wo_data AS (
  SELECT

      count(assignment_id) AS hired_cnt,
      buyer_code,
      main_document_id
    FROM
      resilient_assgn
    GROUP BY buyer_code,main_document_id
),req_dist_data AS
(
	SELECT
      count(DISTINCT CASE
        WHEN coalesce(req_distribution_status, 'na') <> 'Declined' THEN supplier
        ELSE CAST(NULL as STRING)
      END) AS suppliers_posted_cnt,
      min(req_distribution_date) AS earliest_req_dist_date,
      buyer_code,
      req_id
    FROM
      resilient_req_dist
    GROUP BY buyer_code,req_id
)

select distinct
  req.buyer,
  req.buyer_code ,
  req.req_id ,
  req.req_title ,
  req.labor_type ,
  req.sourcing_type,
  req.sourcing_type_template,
  IFNULL(
    gbl_src.sourcing_dw,
    CASE WHEN cand.cand_submitted_cnt <= 1 AND req_dist.suppliers_posted_cnt <= 1
         THEN 'Pre-ID'
        ELSE 'Recruited'
    END
    ) AS rsr_sourced_type,
  req.req_status,
  req.req_owner,
  req.req_type,
  req.posting_type,
  req.close_reason,
  req.withdraw_reason,
  req.business_unit_code,
  req.business_unit,
  req.site,
  req.site_code,
  req.division,
  req.location_code,
  req.location,
  req.req_category,
  req.city,
  req.state_province,
  req.country,
  req.zip_postal_code,
  req.first_respond_date,
  req.req_approved_date,
  req.req_closed_date,
  req.req_create_date,
  req.req_end_date,
  req.req_respond_by_date as req_responded_by_date,
  req.req_start_date,
  req.req_submit_date as req_submitted_date,
  req.req_first_approved_date,
  req.req_creator_name,
  req.req_distributor_name,
  req.req_coordinator_name,
--   req.max_requested_bill_rate_st_hr,
  CASE
    WHEN NULLIF(req.max_requested_bill_rate_st_hr, 0) IS NOT NULL
    THEN req.max_requested_bill_rate_st_hr
    WHEN NULLIF(req.max_requested_bill_rate_st_day, 0) IS NOT NULL
         AND NULLIF(req.hours_per_day, 0) IS NOT NULL
    THEN req.max_requested_bill_rate_st_day / req.hours_per_day
    WHEN NULLIF(req.max_requested_bill_rate_st_week, 0) IS NOT NULL
         AND NULLIF(req.hours_per_week, 0) IS NOT NULL
    THEN req.max_requested_bill_rate_st_week / req.hours_per_week
    WHEN NULLIF(req.max_requested_bill_rate_st_month, 0) IS NOT NULL
         AND NULLIF(req.hours_per_week, 0) IS NOT NULL
    THEN (req.max_requested_bill_rate_st_month / 4.33) / req.hours_per_week
    ELSE NULL
END AS max_requested_bill_rate_st_hr,
--   req.max_requested_pay_rate_st_hr,
CASE
    WHEN NULLIF(req.max_requested_pay_rate_st_hr, 0) IS NOT NULL
    THEN req.max_requested_pay_rate_st_hr
    WHEN NULLIF(req.max_requested_pay_rate_st_day, 0) IS NOT NULL
         AND NULLIF(req.hours_per_day, 0) IS NOT NULL
    THEN req.max_requested_pay_rate_st_day / req.hours_per_day
    WHEN NULLIF(req.max_requested_pay_rate_st_week, 0) IS NOT NULL
         AND NULLIF(req.hours_per_week, 0) IS NOT NULL
    THEN req.max_requested_pay_rate_st_week / req.hours_per_week
    WHEN NULLIF(req.max_requested_pay_rate_st_month, 0) IS NOT NULL
         AND NULLIF(req.hours_per_week, 0) IS NOT NULL
    THEN (req.max_requested_pay_rate_st_month / 4.33) / req.hours_per_week
    ELSE NULL
END AS max_requested_pay_rate_st_hr,
--   req.min_requested_bill_rate_st_hr,
CASE
    WHEN NULLIF(req.min_requested_bill_rate_st_hr, 0) IS NOT NULL
    THEN req.min_requested_bill_rate_st_hr
    WHEN NULLIF(req.min_requested_bill_rate_st_day, 0) IS NOT NULL
         AND NULLIF(req.hours_per_day, 0) IS NOT NULL
    THEN req.min_requested_bill_rate_st_day / req.hours_per_day
    WHEN NULLIF(req.min_requested_bill_rate_st_week, 0) IS NOT NULL
         AND NULLIF(req.hours_per_week, 0) IS NOT NULL
    THEN req.min_requested_bill_rate_st_week / req.hours_per_week
    WHEN NULLIF(req.min_requested_bill_rate_st_month, 0) IS NOT NULL
         AND NULLIF(req.hours_per_week, 0) IS NOT NULL
    THEN (req.min_requested_bill_rate_st_month / 4.33) / req.hours_per_week
    ELSE NULL
END AS min_requested_bill_rate_st_hr,
--   req.min_requested_pay_rate_st_hr,
CASE
    WHEN NULLIF(req.min_requested_pay_rate_st_hr, 0) IS NOT NULL
    THEN req.min_requested_pay_rate_st_hr
    WHEN NULLIF(req.min_requested_pay_rate_st_day, 0) IS NOT NULL
         AND NULLIF(req.hours_per_day, 0) IS NOT NULL
    THEN req.min_requested_pay_rate_st_day / req.hours_per_day
    WHEN NULLIF(req.min_requested_pay_rate_st_week, 0) IS NOT NULL
         AND NULLIF(req.hours_per_week, 0) IS NOT NULL
    THEN req.min_requested_pay_rate_st_week / req.hours_per_week
    WHEN NULLIF(req.min_requested_pay_rate_st_month, 0) IS NOT NULL
         AND NULLIF(req.hours_per_week, 0) IS NOT NULL
    THEN (req.min_requested_pay_rate_st_month / 4.33) / req.hours_per_week
    ELSE NULL
END AS min_requested_pay_rate_st_hr,
  req.hours_per_week,
  req.hours_per_day,
  req.msp_code,
  req.msp,
  req.start_day_of_week,
  req.positions_requested_cnt,
  req.positions_remaining_cnt,
--  req_temp.max_template_bill_rate_st_hr,
CASE
    WHEN NULLIF(req_temp.max_template_bill_rate_st_hr, 0) IS NOT NULL
    THEN req_temp.max_template_bill_rate_st_hr
    WHEN NULLIF(req_temp.max_template_bill_rate_st_day, 0) IS NOT NULL
         AND NULLIF(req.hours_per_day, 0) IS NOT NULL
    THEN req_temp.max_template_bill_rate_st_day / req.hours_per_day
    WHEN NULLIF(req_temp.max_template_bill_rate_st_week, 0) IS NOT NULL
         AND NULLIF(req.hours_per_week, 0) IS NOT NULL
    THEN req_temp.max_template_bill_rate_st_week / req.hours_per_week
    WHEN NULLIF(req_temp.max_template_bill_rate_st_month, 0) IS NOT NULL
         AND NULLIF(req.hours_per_week, 0) IS NOT NULL
    THEN (req_temp.max_template_bill_rate_st_month / 4.33) / req.hours_per_week
    ELSE NULL
END AS max_template_bill_rate_st_hr,
  -- gjcr.closed_reason_dw as rsr_close_reason,
  CASE
    WHEN IFNULL(gjcr.closed_reason_dw, '') <> '' THEN gjcr.closed_reason_dw
    WHEN IFNULL(req.close_reason, '') = '' THEN 'Undisclosed'
    ELSE 'Unmapped'
  END AS rsr_close_reason,
  CASE
    WHEN IFNULL(glt.labor_type_dw, '') <> '' THEN glt.labor_type_dw
    WHEN IFNULL(req.labor_type, '') = '' THEN 'Undisclosed'
    ELSE 'Unmapped'
  END AS rsr_labor_type,
  -- gsm.rsr_state,
  CASE
    WHEN IFNULL(gsm.rsr_state, '') <> '' THEN gsm.rsr_state
    WHEN IFNULL(req.state_province, '') = '' THEN 'Undisclosed'
    ELSE 'Unmapped'
  END AS rsr_state,
  -- gcr.rsr_country,
  CASE
    WHEN IFNULL(gcr.rsr_country, '') <> '' THEN gcr.rsr_country
    WHEN IFNULL(req.country, '') = '' THEN 'Undisclosed'
    ELSE 'Unmapped'
  END AS rsr_country,
  -- gcr.rsr_region,
  CASE
    WHEN IFNULL(gcr.rsr_region, '') <> '' THEN gcr.rsr_region
    WHEN IFNULL(req.country, '') = '' THEN 'Undisclosed'
    ELSE 'Unmapped'
  END AS rsr_region,
  gcr.country AS rsr_country_code,
  CURRENT_DATE() as current_date,

  CAST(Function_library${region}.f_calendarday(req.req_approved_date, CAST(current_timestamp() as DATETIME)) AS INT64) AS req_aging_cd,
  round(Function_library${region}.f_workday(req.req_approved_date, CAST(current_timestamp() as DATETIME)),2) AS req_aging_bd,

  CAST(Function_library${region}.f_calendarday(req.req_create_date,req.req_approved_date) AS INT64) AS create_to_approve_cd,
  round(Function_library${region}.f_workday(req.req_create_date,req.req_approved_date),2) AS create_to_approve_bd,

  CAST(Function_library${region}.f_calendarday(req.req_approved_date, cand.first_cand_submitted_date) AS INT64) AS time_to_submit_first_cand_cd,
  round(Function_library${region}.f_workday(req.req_approved_date, cand.first_cand_submitted_date),2) AS time_to_submit_first_cand_bd,
  grs.rsr_job_posting_status as rsr_req_status, -- job posting status
  assing.hired_cnt,
  cand.cand_submitted_cnt,
  req_dist.suppliers_posted_cnt,
  cand.suppliers_responded_cnt,
  cand.first_cand_submitted_date,
  req_dist.earliest_req_dist_date,
  -- Fields used for other derv views
  req.dist_list,
  req.primary_cost_center,
  req.req_title_classification,
  '${dataform.projectConfig.vars.client_code}' as rsr_client_code,
  req.updated_ts as rsr_processed_date,
  req.currency,
req.rsr_staffing_entity, -- winter_release 2025
norm_jt.suppressed_title,
norm_jt.pii_found,
norm_jt.process_status,
norm_jt.suppression_type,
norm_jt.llm_cleaned,
norm_jt.title_cleaned,
norm_jt.ms_category_1,
norm_jt.ms_category_2,
norm_jt.onet_career_pathway,
norm_jt.onet_job_family,
norm_jt.onet_career_cluster,
norm_jt.onet_occupation,
norm_jt.soc_major_group,
norm_jt.soc_minor_group,
norm_jt.soc_broad_group,
norm_jt.onet_detailed_occupation,
norm_jt.bg_categorization,
norm_jt.tk_categorization,
norm_jt.rand_categorization,
norm_jt.rmi_categorization,
norm_jt.R1_label,
norm_jt.R2_label,
norm_jt.R3_label,
norm_jt.R4_label,
norm_jt.R5_label,
norm_jt.R6_label,
norm_loc.location_level_1,
norm_loc.location_level_2,
norm_loc.location_level_3,
norm_loc.location_level_4,
norm_loc.location_level_5,
norm_loc.location_level_6,
norm_loc.location_level_7,
norm_loc.location_level_8,
norm_loc.location_level_1a,
norm_loc.location_level_2a

  from resilient_req req
  left join req_dist_data as req_dist ON req.req_id = req_dist.req_id
  left join candidate_data AS cand ON req.req_id = cand.req_id
  left join req_temp_data AS req_temp ON req.req_id= req_temp.req_id
  left join wo_data AS assing on req.req_id = assing.main_document_id
  left join `db_common${region}.global_jp_closed_reason` gjcr on req.close_reason = gjcr.close_reason
  left join `db_common${region}.global_labor_type` glt on req.labor_type = glt.vms_labor_type
  left join `db_common${region}.global_state_mapping` gsm on req.state_province = gsm.vms_state
  left join `db_common${region}.global_countries` gcr on lower(req.country)=lower(gcr.country)
  left join `db_common${region}.global_job_posting_status` grs on grs.job_posting_status = req.req_status
  left outer join db_common${region}.global_sourcing as gbl_src on TRIM(LOWER(gbl_src.sourcing_type)) = TRIM(LOWER(COALESCE(req.sourcing_type, req.sourcing_type_template, '')))
  LEFT JOIN db${region}_yellowdata_normalization.job_titles_gold_${dataform.projectConfig.vars.dataset_id}_normalised norm_jt on req.req_title = norm_jt.raw_job_title
    LEFT JOIN db${region}_yellowdata_normalization.locations_gold_${dataform.projectConfig.vars.dataset_id}_normalised norm_loc on COALESCE(req.city, '') = COALESCE(norm_loc.city, '') AND COALESCE((CASE
    WHEN IFNULL(gsm.vms_state, '') <> '' THEN gsm.vms_state
    WHEN IFNULL(req.state_province, '') = '' THEN 'Undisclosed'
    ELSE 'Unmapped'
  END), '') = COALESCE(norm_loc.state, '')
  AND COALESCE(req.state_province, '') = COALESCE(norm_loc.province, '') AND COALESCE((CASE
    WHEN IFNULL(gcr.rsr_country, '') <> '' THEN gcr.rsr_country
    WHEN IFNULL(req.country, '') = '' THEN 'Undisclosed'
    ELSE 'Unmapped'
  END), '') = COALESCE(norm_loc.country_name, '') AND COALESCE(req.country, '') = COALESCE(norm_loc.country_code, ''))
;

""","dev_gold_tr_eu_goldschemacheck",requisition_table_id, 
resilient_req_cte_sql,slvr_dataset, slvr_req, 
resilient_cand_cte_sql,slvr_dataset, slvr_cand, 
resilient_req_tmp_cte_sql,slvr_dataset, slvr_req_tmp, 
resilient_assgn_cte_sql,slvr_dataset, slvr_assgn, 
resilient_req_dist_cte_sql,slvr_dataset, slvr_req_dist
);
