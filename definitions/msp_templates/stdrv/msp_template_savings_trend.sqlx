config {
    type: "operations",
    name: "msp_template_savings_trend",
    tags: 'msp_template',
    dependencies: ['msp_template_assignment', 'msp_template_spend'],
    description: 'This file creates the  stdrv layer'
}

js {
    const {
        getCompleteTableConfig
    } = require("includes/table_config");
    const config = getCompleteTableConfig(ctx);
    const baseTables = config.baseTables.defaults;
}

DECLARE
  savings_trend_table_id STRING;
DECLARE
  spend_table_id STRING;
DECLARE
  assignment_table_id STRING;
DECLARE
  gold_dataset STRING;
EXECUTE IMMEDIATE
  FORMAT ('''
SELECT
DISTINCT table_id,
FROM
`${dataform.projectConfig.vars.config_dataset}.ext_slvr_schema_cfg`
WHERE standard_report_type = 'savings_trend_src' and dataset_id = '${dataform.projectConfig.vars.dataset_id}' LIMIT 1
''' )INTO savings_trend_table_id;
EXECUTE IMMEDIATE
  FORMAT ('''
  SELECT
  DISTINCT table_id,
  FROM
  `${dataform.projectConfig.vars.config_dataset}.ext_slvr_schema_cfg`
    WHERE standard_report_type = 'spend_src' and dataset_id = '${dataform.projectConfig.vars.dataset_id}' LIMIT 1
''' )INTO spend_table_id;
EXECUTE IMMEDIATE
  FORMAT ('''
  SELECT
  DISTINCT table_id,
  FROM
  `${dataform.projectConfig.vars.config_dataset}.ext_slvr_schema_cfg`
    WHERE standard_report_type = 'assignment_src' and dataset_id = '${dataform.projectConfig.vars.dataset_id}' LIMIT 1
''' )INTO assignment_table_id;
IF
  savings_trend_table_id IS NULL THEN RAISE
USING
  MESSAGE = 'SAVINGS TREND TABLE ID IS MISSING FROM CONFIGS';
END IF
  ;
IF
  assignment_table_id IS NULL THEN RAISE
USING
  MESSAGE = 'REQUISITION TABLE ID IS MISSING FROM CONFIGS';
END IF
  ;
IF
  spend_table_id IS NULL THEN RAISE
USING
  MESSAGE = 'SPEND TABLE ID IS MISSING FROM CONFIGS';
END IF
  ;
SET
  gold_dataset = CONCAT("dev","_gold_","${dataform.projectConfig.vars.dataset_id}");

CREATE OR REPLACE TABLE
  `${dataform.projectConfig.vars.ds_name}.stdrv_savings_trend_${dataform.projectConfig.vars.client_code}` AS (
  WITH
    calendar AS (
    SELECT
      calendar_reporting_month,
      PARSE_DATE("%m/%d/%Y",calendar_reporting_month_date) AS calendar_reporting_month_date,
      calendar_reporting_quarter,
      calendar_reporting_year
    FROM
      db_common${dataform.projectConfig.vars.region}.global_calendar_445 calendar
    GROUP BY
      1,
      2,
      3,
      4 ),
    spend AS (
    SELECT
      SUM(extension_negotiated_savings) AS extension_negotiated_savings,
      SUM(extension_negotiated_savings_in_usd) AS extension_negotiated_savings_in_usd,
      SUM(extension_negotiated_savings_in_eur) AS extension_negotiated_savings_in_eur,
      SUM(extension_negotiated_savings_in_cad) AS extension_negotiated_savings_in_cad,
      SUM(extension_negotiated_savings_in_inr) AS extension_negotiated_savings_in_inr,
      SUM(extension_negotiated_savings_in_gbp) AS extension_negotiated_savings_in_gbp,
      SUM(savings_vs_max_rate) AS savings_vs_max_rate,
      SUM(savings_vs_max_rate_in_inr) AS savings_vs_max_rate_in_inr,
      SUM(savings_vs_max_rate_in_usd) AS savings_vs_max_rate_in_usd,
      SUM(savings_vs_max_rate_in_eur) AS savings_vs_max_rate_in_eur,
      SUM(savings_vs_max_rate_in_cad) AS savings_vs_max_rate_in_cad,
      SUM(savings_vs_max_rate_in_gbp) AS savings_vs_max_rate_in_gbp,
      SUM(initial_negotiated_savings) AS initial_negotiated_savings,
      SUM(initial_negotiated_savings_in_inr) AS initial_negotiated_savings_in_inr,
      SUM(initial_negotiated_savings_in_usd) AS initial_negotiated_savings_in_usd,
      SUM(initial_negotiated_savings_in_cad) AS initial_negotiated_savings_in_cad,
      SUM(initial_negotiated_savings_in_eur) AS initial_negotiated_savings_in_eur,
      SUM(initial_negotiated_savings_in_gbp) AS initial_negotiated_savings_in_gbp,
      SUM(direct_sourcing_savings) AS direct_sourcing_savings,
      SUM(direct_sourcing_savings_in_inr) AS direct_sourcing_savings_in_inr,
      SUM(direct_sourcing_savings_in_usd) AS direct_sourcing_savings_in_usd,
      SUM(direct_sourcing_savings_in_eur) AS direct_sourcing_savings_in_eur,
      SUM(direct_sourcing_savings_in_cad) AS direct_sourcing_savings_in_cad,
      SUM(direct_sourcing_savings_in_gbp) AS direct_sourcing_savings_in_gbp,
      SUM(payroll_savings) AS payroll_savings,
      SUM(payroll_savings_in_inr) AS payroll_savings_in_inr,
      SUM(payroll_savings_in_usd) AS payroll_savings_in_usd,
      SUM(payroll_savings_in_eur) AS payroll_savings_in_eur,
      SUM(payroll_savings_in_cad) AS payroll_savings_in_cad,
      SUM(payroll_savings_in_gbp) AS payroll_savings_in_gbp,
      SUM(tenure_discount_savings) AS tenure_discount_savings,
      SUM(tenure_discount_savings_in_inr) AS tenure_discount_savings_in_inr,
      SUM(tenure_discount_savings_in_usd) AS tenure_discount_savings_in_usd,
      SUM(tenure_discount_savings_in_eur) AS tenure_discount_savings_in_eur,
      SUM(tenure_discount_savings_in_cad) AS tenure_discount_savings_in_cad,
      SUM(tenure_discount_savings_in_gbp) AS tenure_discount_savings_in_gbp,
      SUM(prior_state_savings) AS prior_state_savings,
      SUM(prior_state_savings_in_inr) AS prior_state_savings_in_inr,
      SUM(prior_state_savings_in_usd) AS prior_state_savings_in_usd,
      SUM(prior_state_savings_in_eur) AS prior_state_savings_in_eur,
      SUM(prior_state_savings_in_cad) AS prior_state_savings_in_cad,
      SUM(prior_state_savings_in_gbp) AS prior_state_savings_in_gbp,
      --supplier_tier_savings,
      SUM(savings_vs_highest_rate) AS savings_vs_highest_rate,
      SUM(savings_vs_highest_rate_in_inr) AS savings_vs_highest_rate_in_inr,
      SUM(savings_vs_highest_rate_in_usd) AS savings_vs_highest_rate_in_usd,
      SUM(savings_vs_highest_rate_in_eur) AS savings_vs_highest_rate_in_eur,
      SUM(savings_vs_highest_rate_in_cad) AS savings_vs_highest_rate_in_cad,
      SUM(savings_vs_highest_rate_in_gbp) AS savings_vs_highest_rate_in_gbp,
      SUM(qualified_cand_savings) AS qualified_cand_savings,
      SUM(qualified_cand_savings_in_inr) AS qualified_cand_savings_in_inr,
      SUM(qualified_cand_savings_in_usd) AS qualified_cand_savings_in_usd,
      SUM(qualified_cand_savings_in_eur) AS qualified_cand_savings_in_eur,
      SUM(qualified_cand_savings_in_cad) AS qualified_cand_savings_in_cad,
      SUM(qualified_cand_savings_in_gbp) AS qualified_cand_savings_in_gbp,
      SUM(previous_years_bill_rate_savings) AS previous_years_bill_rate_savings,
      SUM(previous_years_bill_rate_savings_in_inr) AS previous_years_bill_rate_savings_in_inr,
      SUM(previous_years_bill_rate_savings_in_usd) AS previous_years_bill_rate_savings_in_usd,
      SUM(previous_years_bill_rate_savings_in_eur) AS previous_years_bill_rate_savings_in_eur,
      SUM(previous_years_bill_rate_savings_in_cad) AS previous_years_bill_rate_savings_in_cad,
      SUM(previous_years_bill_rate_savings_in_gbp) AS previous_years_bill_rate_savings_in_gbp,
      DATE_TRUNC(consolidated_invoice_approved_date,MONTH) AS month_start_spend
    FROM
      ${dataform.projectConfig.vars.ds_name}.stdrv_spend_${dataform.projectConfig.vars.client_code}
    GROUP BY
      month_start_spend,
      rsr_client_code),
    assign AS (
    SELECT
      SUM(perm_recruitment_fee_savings) AS perm_recruitment_fee_savings,
      SUM(perm_recruitment_fee_savings_in_cad) AS perm_recruitment_fee_savings_in_cad,
      SUM(perm_recruitment_fee_savings_in_usd) AS perm_recruitment_fee_savings_in_usd,
      SUM(perm_recruitment_fee_savings_in_inr) AS perm_recruitment_fee_savings_in_inr,
      SUM(perm_recruitment_fee_savings_in_gbp) AS perm_recruitment_fee_savings_in_gbp,
      SUM(perm_recruitment_fee_savings_in_eur) AS perm_recruitment_fee_savings_in_eur,
      SUM(rehire_onboarding_savings) AS rehire_onboarding_savings,
      SUM(rehire_onboarding_savings_in_cad) AS rehire_onboarding_savings_in_cad,
      SUM(rehire_onboarding_savings_in_usd) AS rehire_onboarding_savings_in_usd,
      SUM(rehire_onboarding_savings_in_inr) AS rehire_onboarding_savings_in_inr,
      SUM(rehire_onboarding_savings_in_gbp) AS rehire_onboarding_savings_in_gbp,
      SUM(rehire_onboarding_savings_in_eur) AS rehire_onboarding_savings_in_eur,
      DATE_TRUNC(assignment_create_date_initial,MONTH) AS month_start_assign
    FROM
      ${dataform.projectConfig.vars.ds_name}.stdrv_assignment_${dataform.projectConfig.vars.client_code}
    GROUP BY
      month_start_assign,
      rsr_client_code),
    savings AS (
    SELECT
      savings.client_code,
      savings.currency,
      reporting_date,
      date_from,
      date_to,
      supplier_invoice_consolidation_fixed AS supplier_invoice_consolidation_savings,
      supplier_legal_fixed AS supplier_legal_savings,
      background_check_fixed AS background_check_savings,
    FROM (
      SELECT
        *
      FROM
        db_common${dataform.projectConfig.vars.region}.msp_cost_saving savings
      WHERE
        savings.client_code = '${dataform.projectConfig.vars.client_code}') savings,
      UNNEST(GENERATE_DATE_ARRAY( DATE_TRUNC(date_from, MONTH), DATE_TRUNC(date_to, MONTH), INTERVAL 1 MONTH ) ) AS reporting_date),
    fx_rates AS (
    SELECT
      CAST(fx_rate AS FLOAT64) AS fx_rate,
      from_currency,
      PARSE_DATE("%Y-%m-%d", month) AS month,
      to_currency
    FROM
      db_common${dataform.projectConfig.vars.region}.global_fx_rates )
  SELECT
    calendar.calendar_reporting_month,
    calendar.calendar_reporting_month_date,
    calendar.calendar_reporting_quarter,
    calendar.calendar_reporting_year,
    '${dataform.projectConfig.vars.client_code}' AS rsr_client_code,
    savings.currency,
    savings.reporting_date,
    savings.date_from,
    savings.date_to,
    savings.supplier_invoice_consolidation_savings,
    savings.supplier_legal_savings,
    savings.background_check_savings,
    CASE
      WHEN UPPER(currency) = 'USD' THEN CAST(savings.supplier_invoice_consolidation_savings AS FLOAT64)
      ELSE savings.supplier_invoice_consolidation_savings * fx_usd.fx_rate
  END
    AS supplier_invoice_consolidation_savings_in_usd,
    CASE
      WHEN UPPER(currency) = 'EUR' THEN CAST(savings.supplier_invoice_consolidation_savings AS FLOAT64)
      ELSE savings.supplier_invoice_consolidation_savings * fx_eur.fx_rate
  END
    AS supplier_invoice_consolidation_savings_in_eur,
    CASE
      WHEN UPPER(currency) = 'GBP' THEN CAST(savings.supplier_invoice_consolidation_savings AS FLOAT64)
      ELSE savings.supplier_invoice_consolidation_savings * fx_gbp.fx_rate
  END
    AS supplier_invoice_consolidation_savings_in_gbp,
    CASE
      WHEN UPPER(currency) = 'INR' THEN CAST(savings.supplier_invoice_consolidation_savings AS FLOAT64)
      ELSE savings.supplier_invoice_consolidation_savings * fx_inr.fx_rate
  END
    AS supplier_invoice_consolidation_savings_in_inr,
    CASE
      WHEN UPPER(currency) = 'CAD' THEN CAST(savings.supplier_invoice_consolidation_savings AS FLOAT64)
      ELSE savings.supplier_invoice_consolidation_savings * fx_cad.fx_rate
  END
    AS supplier_invoice_consolidation_savings_in_cad,
    CASE
      WHEN UPPER(currency) = 'USD' THEN CAST(savings.supplier_legal_savings AS FLOAT64)
      ELSE savings.supplier_legal_savings * fx_usd.fx_rate
  END
    AS supplier_legal_savings_in_usd,
    CASE
      WHEN UPPER(currency) = 'EUR' THEN CAST(savings.supplier_legal_savings AS FLOAT64)
      ELSE savings.supplier_legal_savings * fx_eur.fx_rate
  END
    AS supplier_legal_savings_in_eur,
    CASE
      WHEN UPPER(currency) = 'GBP' THEN CAST(savings.supplier_legal_savings AS FLOAT64)
      ELSE savings.supplier_legal_savings * fx_gbp.fx_rate
  END
    AS supplier_legal_savings_in_gbp,
    CASE
      WHEN UPPER(currency) = 'INR' THEN CAST(savings.supplier_legal_savings AS FLOAT64)
      ELSE savings.supplier_legal_savings * fx_inr.fx_rate
  END
    AS supplier_legal_savings_in_inr,
    CASE
      WHEN UPPER(currency) = 'CAD' THEN CAST(savings.supplier_legal_savings AS FLOAT64)
      ELSE savings.supplier_legal_savings * fx_cad.fx_rate
  END
    AS supplier_legal_savings_in_cad,
    CASE
      WHEN UPPER(currency) = 'USD' THEN CAST(savings.background_check_savings AS FLOAT64)
      ELSE savings.background_check_savings * fx_usd.fx_rate
  END
    AS background_check_savings_in_usd,
    CASE
      WHEN UPPER(currency) = 'EUR' THEN CAST(savings.background_check_savings AS FLOAT64)
      ELSE savings.background_check_savings * fx_eur.fx_rate
  END
    AS background_check_savings_in_eur,
    CASE
      WHEN UPPER(currency) = 'GBP' THEN CAST(savings.background_check_savings AS FLOAT64)
      ELSE savings.background_check_savings * fx_gbp.fx_rate
  END
    AS background_check_savings_in_gbp,
    CASE
      WHEN UPPER(currency) = 'INR' THEN CAST(savings.background_check_savings AS FLOAT64)
      ELSE savings.background_check_savings * fx_inr.fx_rate
  END
    AS background_check_savings_in_inr,
    CASE
      WHEN UPPER(currency) = 'CAD' THEN CAST(savings.background_check_savings AS FLOAT64)
      ELSE savings.background_check_savings * fx_cad.fx_rate
  END
    AS background_check_savings_in_cad,
    spend.extension_negotiated_savings,
    spend.extension_negotiated_savings_in_usd,
    spend.extension_negotiated_savings_in_eur,
    spend.extension_negotiated_savings_in_cad,
    spend.extension_negotiated_savings_in_inr,
    spend.extension_negotiated_savings_in_gbp,
    spend.savings_vs_max_rate,
    spend.savings_vs_max_rate_in_inr,
    spend.savings_vs_max_rate_in_usd,
    spend.savings_vs_max_rate_in_eur,
    spend.savings_vs_max_rate_in_cad,
    spend.savings_vs_max_rate_in_gbp,
    spend.initial_negotiated_savings,
    spend.initial_negotiated_savings_in_inr,
    spend.initial_negotiated_savings_in_usd,
    spend.initial_negotiated_savings_in_cad,
    spend.initial_negotiated_savings_in_eur,
    spend.initial_negotiated_savings_in_gbp,
    spend.direct_sourcing_savings,
    spend.direct_sourcing_savings_in_inr,
    spend.direct_sourcing_savings_in_usd,
    spend.direct_sourcing_savings_in_eur,
    spend.direct_sourcing_savings_in_cad,
    spend.direct_sourcing_savings_in_gbp,
    spend.payroll_savings,
    spend.payroll_savings_in_inr,
    spend.payroll_savings_in_usd,
    spend.payroll_savings_in_eur,
    spend.payroll_savings_in_cad,
    spend.payroll_savings_in_gbp,
    tenure_discount_savings,
    tenure_discount_savings_in_inr,
    tenure_discount_savings_in_usd,
    tenure_discount_savings_in_eur,
    tenure_discount_savings_in_cad,
    tenure_discount_savings_in_gbp,
    prior_state_savings,
    prior_state_savings_in_inr,
    prior_state_savings_in_usd,
    prior_state_savings_in_eur,
    prior_state_savings_in_cad,
    prior_state_savings_in_gbp,
    --supplier_tier_savings,
    savings_vs_highest_rate,
    savings_vs_highest_rate_in_inr,
    savings_vs_highest_rate_in_usd,
    savings_vs_highest_rate_in_eur,
    savings_vs_highest_rate_in_cad,
    savings_vs_highest_rate_in_gbp,
    qualified_cand_savings,
    qualified_cand_savings_in_inr,
    qualified_cand_savings_in_usd,
    qualified_cand_savings_in_eur,
    qualified_cand_savings_in_cad,
    qualified_cand_savings_in_gbp,
    previous_years_bill_rate_savings,
    previous_years_bill_rate_savings_in_inr,
    previous_years_bill_rate_savings_in_usd,
    previous_years_bill_rate_savings_in_eur,
    previous_years_bill_rate_savings_in_cad,
    previous_years_bill_rate_savings_in_gbp,
    assign.perm_recruitment_fee_savings,
    assign.perm_recruitment_fee_savings_in_usd,
    assign.perm_recruitment_fee_savings_in_eur,
    assign.perm_recruitment_fee_savings_in_cad,
    assign.perm_recruitment_fee_savings_in_inr,
    assign.perm_recruitment_fee_savings_in_gbp,
    assign.rehire_onboarding_savings AS rehire_onboarding_savings,
    assign.rehire_onboarding_savings_in_usd AS rehire_onboarding_savings_in_usd,
    assign.rehire_onboarding_savings_in_eur AS rehire_onboarding_savings_in_eur,
    assign.rehire_onboarding_savings_in_cad AS rehire_onboarding_savings_in_cad,
    assign.rehire_onboarding_savings_in_inr AS rehire_onboarding_savings_in_inr,
    assign.rehire_onboarding_savings_in_gbp AS rehire_onboarding_savings_in_gbp,
    CURRENT_DATE() AS current_date
  FROM
    calendar
  LEFT JOIN
    savings
  ON
    savings.reporting_date=calendar.calendar_reporting_month_date
  LEFT JOIN
    spend
  ON
    spend.month_start_spend=calendar.calendar_reporting_month_date
  LEFT JOIN
    assign
  ON
    assign.month_start_assign=calendar.calendar_reporting_month_date
  LEFT JOIN
    fx_rates AS fx_usd
  ON
    TRIM(LOWER(savings.currency)) = TRIM(LOWER(fx_usd.from_currency))
    AND savings.reporting_date = fx_usd.month
    AND TRIM(UPPER(fx_usd.to_currency)) = 'USD'
  LEFT JOIN
    fx_rates AS fx_eur
  ON
    TRIM(LOWER(savings.currency)) = TRIM(LOWER(fx_eur.from_currency))
    AND savings.reporting_date = fx_eur.Month
    AND TRIM(UPPER(fx_eur.to_currency)) = 'EUR'
  LEFT JOIN
    fx_rates AS fx_gbp
  ON
    TRIM(LOWER(savings.currency)) = TRIM(LOWER(fx_gbp.from_currency))
    AND savings.reporting_date = fx_gbp.month
    AND TRIM(UPPER(fx_gbp.to_currency)) = 'GBP'
  LEFT JOIN
    fx_rates AS fx_inr
  ON
    TRIM(LOWER(savings.currency)) = TRIM(LOWER(fx_inr.from_currency))
    AND savings.reporting_date = fx_inr.month
    AND TRIM(UPPER(fx_inr.to_currency)) = 'INR'
  LEFT JOIN
    fx_rates AS fx_cad
  ON
    TRIM(LOWER(savings.currency)) = TRIM(LOWER(fx_cad.from_currency))
    AND savings.reporting_date = fx_cad.month
    AND TRIM(UPPER(fx_cad.to_currency)) = 'CAD'
  ORDER BY
    calendar_reporting_month_date )
