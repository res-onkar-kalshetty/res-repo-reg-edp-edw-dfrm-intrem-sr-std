config {
    type: "operations",
    name: "msp_ntv_template_assignment_gold",
    tags: 'msp_ntv_template_gold',
    dependencies: 'msp_ntv_template_requisition_gold',
    description: 'This file creates the  stdrv layer'
}

js {
    const helper = require("/includes/helper");

    const config_ds_name = helper.get_config_ds();
    const config_table_name = helper.get_config_table();
    const env = helper.get_env();
    const region = helper.get_region();
    const dataset_id = dataform.projectConfig.vars.dataset_id;

    const gold_dataset = (env == "prd") ?
        `gold_${dataset_id}` :
        `dev_gold_${dataset_id}`;

    const slvr_dataset = (env == "prd") ?
        `slvr_${dataset_id}` :
        `dev_slvr_${dataset_id}`;

    const slvr_cand = helper.getSlvrTableName(config_ds_name, config_table_name, 'candidate_src', dataset_id);
    const slvr_assgn = helper.getSlvrTableName(config_ds_name, config_table_name, 'assignment_src', dataset_id);
    const slvr_assgn_v0 = helper.getSlvrTableName(config_ds_name, config_table_name, 'assignment_v0_src', dataset_id);
    const slvr_wrkr = helper.getSlvrTableName(config_ds_name, config_table_name, 'worker_src', dataset_id);
    const slvr_assgn_rt = helper.getSlvrTableName(config_ds_name, config_table_name, 'assignment_rates_src', dataset_id);
    const slvr_assgn_rt_v0 = helper.getSlvrTableName(config_ds_name, config_table_name, 'assignment_rates_v0_src', dataset_id);

}

DECLARE
  assignment_table_id STRING;
DECLARE
  requisition_table_id STRING;
DECLARE
  gold_dataset STRING;
DECLARE
  slvr_dataset STRING;
DECLARE
  config_ds_name STRING;
DECLARE
  config_table_name STRING;
DECLARE
  region STRING;
DECLARE
  slvr_cand STRING;
DECLARE
  slvr_assgn STRING;
DECLARE
  slvr_assgn_v0 STRING;
DECLARE
  slvr_wrkr STRING;
DECLARE
  slvr_assgn_rt STRING;
DECLARE
  slvr_assgn_rt_v0 STRING;
SET
  config_ds_name = '${config_ds_name}';
SET
  config_table_name = '${config_table_name}';
SET
  region = '${region}';
SET
  gold_dataset = '${gold_dataset}';
SET
  slvr_dataset = '${slvr_dataset}';
SET
  slvr_cand = 'v_' || ${slvr_cand};
SET
  slvr_assgn= 'v_' || ${slvr_assgn};
SET
  slvr_assgn_v0= 'v_' || ${slvr_assgn_v0};
SET
  slvr_wrkr= 'v_' || ${slvr_wrkr};
SET
  slvr_assgn_rt= 'v_' || ${slvr_assgn_rt};
SET
  slvr_assgn_rt_v0= 'v_' || ${slvr_assgn_rt_v0};


SET requisition_table_id="stdrv_requisition_" || '${dataform.projectConfig.vars.client_code}';
SET assignment_table_id="stdrv_assignment_" || '${dataform.projectConfig.vars.client_code}';


EXECUTE IMMEDIATE
  FORMAT ("""
CREATE OR REPLACE TABLE
  %s.%s AS (
 ------------------------------------------------------------------------
-- CANDIDATE STATUS CTE
------------------------------------------------------------------------

with
status_dates AS (
SELECT
    *,
    -- rank rows to get most recent status for application_status field
    ROW_NUMBER() OVER (PARTITION BY cand_status.req_id, cand_status.cand_id ORDER BY cand_status.status_datetime DESC, cand_status.rsr_processed_date DESC) AS rnk
FROM (
    SELECT
    buyer,
    req_id,
    cand_id,
    new_status as activity_status,
    MAX(new_status_datetime) AS status_datetime,
    MAX(updated_ts) AS rsr_processed_date
    FROM
     `${slvr_dataset}.%s`
    GROUP BY
    buyer,
    req_id,
    cand_id,
    new_status ) cand_status
),

------------------------------------------------------------------------
-- Candidate non transactional dataset
------------------------------------------------------------------------

cand_non_transactional as(
SELECT DISTINCT
------------------------------------------------------------------------
-- STANDARD FIELDS FROM SOURCE
------------------------------------------------------------------------
cand.buyer
,cand.buyer_code
,cand.req_id
,cand.cand_id
,cand.cand_name
,cand.supplier
,cand.cand_status
,cand.cand_withdraw_reason as withdrawn_reason
,cand.cand_rejected_reason as rejected_reason
,cand.currency
,cand.cand_available_date
,cand.cand_buyer_first_viewed_date
,cand.cand_first_submit_date as cand_first_submitted_date
,cand.cand_last_modified_date
,cand.cand_unshortlisted_date
,cand.location
,cand.site_code
,cand.site
,cand.cand_code
,cand.msp_code
,cand.msp_company
,cand.presented_bill_rate_supplier_st_hr
,cand.supplier_code
,cand.uploaded
,cand.rsr_client_code
,cand.presented_bill_rate_st_basis
,cand.presented_bill_rate
,cand.presented_pay_rate

---- needed for supporting other calcs---
,cand.assignment_id

------------------------------------------------------------------------
-- PIVOTED DATE FIELDS
------------------------------------------------------------------------
-- cand_submit_date
,(SELECT MIN(status_datetime)
    FROM status_dates
    WHERE cand.req_id = status_dates.req_id
        AND cand.cand_id = status_dates.cand_id
        AND status_dates.activity_status IN ('proposed')) AS cand_submit_date

-- cand_shortlisted_date
,(SELECT MIN(status_datetime)
    FROM status_dates
    WHERE cand.req_id = status_dates.req_id
        AND cand.cand_id = status_dates.cand_id
        AND status_dates.activity_status IN ('submitted_manager')) AS cand_shortlisted_date

-- cand_interview_date
,(SELECT MIN(status_datetime)
    FROM status_dates
    WHERE cand.req_id = status_dates.req_id
        AND cand.cand_id = status_dates.cand_id
        AND status_dates.activity_status IN ('interview_1')) AS cand_interview_date

-- cand_withdrawn_date
,(SELECT MIN(status_datetime)
    FROM status_dates
    WHERE cand.req_id = status_dates.req_id
        AND cand.cand_id = status_dates.cand_id
        AND status_dates.activity_status IN ('withdraw')) AS cand_withdrawn_date

-- assignment_activation_date
,(SELECT MIN(status_datetime)
    FROM status_dates
    WHERE cand.req_id = status_dates.req_id
        AND cand.cand_id = status_dates.cand_id
        AND status_dates.activity_status IN ('hired')) AS assignment_activation_date

-- cand_rejected_date
,(SELECT MIN(status_datetime)
    FROM status_dates
    WHERE cand.req_id = status_dates.req_id
        AND cand.cand_id = status_dates.cand_id
        AND status_dates.activity_status IN ('auto_rejected', 'rejected', 'rejected_msp')) AS cand_rejected_date

-- cand_first_interview_date
,(SELECT MIN(status_datetime)
    FROM status_dates
    WHERE cand.req_id = status_dates.req_id
        AND cand.cand_id = status_dates.cand_id
        AND status_dates.activity_status IN ('interview_1','interview_2')) AS cand_first_interviewed_date


-- cand_last_interview_date
,(SELECT MAX(status_datetime)
    FROM status_dates
    WHERE cand.req_id = status_dates.req_id
        AND cand.cand_id = status_dates.cand_id
        AND status_dates.activity_status IN ('interview_1','interview_2')) AS cand_last_interviewed_date


,(SELECT MAX(updated_ts)
    FROM status_dates
    WHERE cand.req_id = status_dates.req_id
    AND cand.cand_id = status_dates.cand_id) AS rsr_processed_date

FROM `${slvr_dataset}.%s` cand
QUALIFY ROW_NUMBER() OVER (partition by cand.req_id, cand.cand_id order by cand_last_modified_date desc)= 1) -- this needs to be done beacuse we would want to get the latest details for each candidate id and req_id, incase there are two dates in cand_last_modified date two rows will appear even for 1 can id and req id combination

,fx_rates AS (
  SELECT
      CAST(fx_rate AS FLOAT64) AS fx_rate,
      from_currency,
      PARSE_DATE("%%Y-%%m-%%d", month) AS month,
      to_currency
    FROM
      db_common${region}.global_fx_rates
), asg_asg_v0 AS (
  select asg.*,
  asg_v0.assignment_create_date AS assignment_create_date_initial,
--   asg_v0.assignment_activation_date AS assignment_activation_date_initial,
  asg_v0.cand_offer_accepted_date AS cand_offer_accepted_date_initial,
  EXTRACT(DATE FROM Function_library${region}.least_array([asg.assignment_create_date,asg_v0.assignment_create_date])) AS rsr_assignment_control_date,
  DATE_TRUNC(EXTRACT(DATE FROM Function_library${region}.least_array([asg.assignment_create_date,asg_v0.assignment_create_date])),MONTH) AS rsr_assignment_control_date_monthstart,
  #cost_savings 2024 Fall Release
  savings.currency AS rsr_savings_currency,
  savings.perm_recruitment_fee_fixed,
  savings.rehire_onboarding_hours,
   CASE 
      WHEN IFNULL(global_state_mapping.rsr_state, '') <> '' THEN global_state_mapping.rsr_state
      WHEN IFNULL(asg.state_province, '') = '' THEN 'Undisclosed'
      ELSE 'Unmapped'
    END AS rsr_state,
     CASE 
      WHEN IFNULL(gcr.rsr_country, '') <> '' THEN gcr.rsr_country
      WHEN IFNULL(asg.country, '') = '' THEN 'Undisclosed'
      ELSE 'Unmapped'
    END AS rsr_country
  FROM ${slvr_dataset}.%s AS asg
    LEFT OUTER JOIN ${slvr_dataset}.%s AS asg_v0 ON asg.assignment_id = asg_v0.assignment_id
    LEFT JOIN db_common${region}.msp_cost_saving savings on savings.client_code=asg.rsr_client_code and cast(asg_v0.assignment_create_date as date) BETWEEN savings.date_from AND savings.date_to
    LEFT JOIN db_common${region}.global_state_mapping AS global_state_mapping ON asg.state_province = global_state_mapping.vms_state
    LEFT JOIN db_common${region}.global_countries gcr on lower(asg.country) = lower(gcr.country)
    where asg.last_assignment_in_chain = 1 -- netive specific FILTER which picks the latest revision of the ASSIGNMENT
    

), worker AS (
    SELECT
    asg_asg_v0.assignment_id -- had to derive assignment id from assgn v0 since this is not present in netive worker src
    ,wk.country,
    wk.consolidated_worker_id,
    wk.worker,
	wk.worker_start_date,wk.worker_closed_date,
	-- wk.worker_end_date, -- this field is not present in the netive src. value is derievd from assignment report
    max(asg_asg_v0.assignment_end_date) over(partition by asg_asg_v0.worker_id) as worker_end_date,
	wk.site,
    wk.worker_id,
    CASE
        WHEN LOWER(wk.worker_status)='yes' THEN 'Open'
        ELSE 'Closed'
    END AS worker_status,
	wk.worker_close_reason,
    /*
	CASE
        WHEN LOWER(wk.worker_status) = 'no' THEN wk.worker_close_reason
        ELSE CAST(NULL AS STRING)
    END AS worker_close_reason,
    */
    gcr_wk.rsr_country as rsr_worker_country,
    /*
    EXTRACT(DATE FROM Function_library${region}.least_array([CURRENT_DATETIME(),wk.worker_end_date , wk.worker_closed_date])) AS rsr_assignment_control_date,
    DATE_TRUNC(EXTRACT(DATE FROM Function_library${region}.least_array([CURRENT_DATETIME(),wk.worker_end_date , wk.worker_closed_date])),MONTH) AS rsr_assignment_control_date_monthstart,
    */
    -- Function_library${region}.least_array([worker_end_date , wk.worker_closed_date]) as reporting_date_ends -- calculated outside since worker_end_date is calculated as part of the windowed query
    FROM ${slvr_dataset}.%s wk
    LEFT OUTER JOIN asg_asg_v0 on wk.worker_id = asg_asg_v0.worker_id
    LEFT JOIN db_common${region}.global_countries gcr_wk on lower(wk.country) = lower(gcr_wk.country)
),
assign_rates AS (
    SELECT asgm_rt.assignment_id,asgm_rt.currency,asgm_rt.assignment_revision_id,
        asgm_rt.bill_rate_st_hr, -- can be inferred directly calc in taken care at prs
        asgm_rt.pay_rate_st_hr,-- can be inferred directly calc in taken care at prs
        asgm_rt.assignment_markup_st_hr,
        asgm_rt.supplier_bill_rate_st_hr
    FROM ${slvr_dataset}.%s asgm_rt
    where asgm_rt.last_assignment_in_chain = 1 -- netive specific FILTER which picks the latest revision of the ASSIGNMENT
), assign_v0_rates AS (
    SELECT asgm_rt_v0.assignment_id,assignment_revision_id,
        asgm_rt_v0.bill_rate_st_hr AS bill_rate_st_hr_initial, -- can be inferred directly calc in taken care at prs
        asgm_rt_v0.pay_rate_st_hr AS pay_rate_st_hr_initial,  -- can be inferred directly calc in taken care at prs
        assignment_markup_st_hr AS assignment_markup_st_hr_initial,
        asgm_rt_v0.supplier_bill_rate_st_hr AS supplier_bill_rate_st_hr_initial
    FROM ${slvr_dataset}.%s asgm_rt_v0
)
SELECT
    assign.buyer,
    assign.buyer_code,
    assign.assignment_id,
    assign.assignment_revision_id, -- have to populate since revision id is considered alomg with assignment id as a unique key.
    assign.cand_id,
    assign.worker_id,
    assign.main_document_id,
    assign.main_document_title,
    assign.assignment_create_date,
    assign.assignment_status,
    assign.cost_center_code,
    assign.cost_center,
    assign.business_unit_code,
    assign.business_unit,
    ------------------
    assign.location_code,
    assign.location,
    assign.site_code,
    assign.site,
	worker.site as site_wk,
    assign.assignment_create_date_initial,
    --assign.assignment_activation_date_initial,
    -------------------
    assign.city,
    assign.state_province,
    assign.country,
    assign.supplier,
    assign.supplier_code,
	req.posting_type,
    PARSE_DATE('%%m/%%d/%%Y', global_calendar_445.calendar_reporting_month_date) AS calendar_reporting_month_date,
    -- below 4 columns need to come from Supplier IO once that data is available
    CASE
      WHEN gcr.rsr_country='United States of America' THEN div_supp.primary_diversity_type
      ELSE CAST(NULL AS STRING)
    END AS supplier_primary_diversity_type,
    CASE
      WHEN gcr.rsr_country='United States of America' THEN div_supp.small_business
      ELSE CAST(NULL AS STRING)
    END AS supplier_small_business,
    CASE
      WHEN gcr.rsr_country='United States of America' THEN div_supp.diverse_and_small
      ELSE CAST(NULL AS STRING)
    END AS supplier_diverse_small,
    CASE
      WHEN gcr.rsr_country='United States of America' THEN div_supp.supplier_id_erp
      ELSE CAST(NULL AS STRING)
    END AS supplier_erp_id,
    assign_rates.bill_rate_st_hr,
    assign_v0_rates.bill_rate_st_hr_initial,
    assign_rates.pay_rate_st_hr,
    assign_v0_rates.pay_rate_st_hr_initial,
    assign_rates.assignment_markup_st_hr ,
    assign_v0_rates.assignment_markup_st_hr_initial,
    assign_rates.supplier_bill_rate_st_hr,
    assign_v0_rates.supplier_bill_rate_st_hr_initial,
    req.max_template_bill_rate_st_hr,
    assign_rates.currency,
    worker.worker_start_date,
    worker_pay_type_code,
    worker_pay_type_name,
    worker.worker_closed_date,
    worker.worker_end_date,
    req.req_approved_date,
    worker.country AS worker_country,
    worker.consolidated_worker_id,
    worker.worker,
    req.labor_type,
    req.dist_list,
    --assign.assignment_create_date_initial,
    cand.assignment_activation_date as assignment_activation_date_initial,  -- this will come from candidate pivoted data
    --worker.worker_close_reason,
    CASE
        WHEN LOWER(worker.worker_status) = 'closed' THEN COALESCE(worker.worker_close_reason,assign.close_reason)
        ELSE CAST(NULL AS STRING)
    END AS worker_close_reason,
    worker.rsr_worker_country,
    -- global_state_mapping.rsr_state AS rsr_state,
    assign.rsr_state,
    -- gcr.rsr_country,
   assign.rsr_country,
    -- gcr.rsr_region,
    CASE 
      WHEN IFNULL(gcr.rsr_region, '') <> '' THEN gcr.rsr_region
      WHEN IFNULL(assign.country, '') = '' THEN 'Undisclosed'
      ELSE 'Unmapped'
    END AS rsr_region,
    global_supp_map.suppliername_dw AS rsr_supplier,
    req.rsr_labor_type,
    -- IFNULL(global_wo_term_reason.termination_reason_DW, 'NULL') as rsr_assignment_close_reason,
    CASE 
      WHEN IFNULL(global_wo_term_reason.termination_reason_DW, '') <> '' THEN global_wo_term_reason.termination_reason_DW
      WHEN IFNULL(worker.worker_close_reason, '') = '' THEN 'Undisclosed'
      ELSE 'Unmapped'
    END AS rsr_assignment_close_reason,
    -- IFNULL(global_wo_term_reason.termination_close_rating_DW, 'NULL') AS rsr_assignment_close_rating,
    CASE 
      WHEN IFNULL(global_wo_term_reason.termination_close_rating_DW, '') <> '' THEN global_wo_term_reason.termination_close_rating_DW
      WHEN IFNULL(worker.worker_close_reason, '') = '' THEN 'Undisclosed'
      ELSE 'Unmapped'
    END AS rsr_assignment_close_rating,
	assign.sourcing_type_wo,
	assign.sourcing_type_wo as sourcing_type_wk,
    -- global_sourcing_type_wo.sourced_type_assignment as sourcing_type_wk_mapped,
    CASE 
      WHEN IFNULL(assign.sourcing_type_wo, '') = '' THEN 'Undisclosed'
      WHEN IFNULL(global_sourcing_type_wo.sourced_type_assignment, '') <> '' THEN global_sourcing_type_wo.sourced_type_assignment
      ELSE 'Unmapped'
    END AS sourcing_type_wk_mapped,
    global_sourcing_type_wo.sourced_type_assignment as sourcing_type_wo_mapped,
    CASE
        WHEN lower(assign.main_document_type) = lower('Contract') THEN 'Contingent'
        WHEN lower(assign.main_document_type) = lower('Service Request') THEN 'Contingent'
        WHEN lower(assign.main_document_type) = lower('Contingent Labor Request') THEN 'Contingent'
        WHEN lower(assign.main_document_type) = lower('Job Posting') THEN 'Contingent'
        WHEN lower(assign.main_document_type) = lower('Non-Employee Posting') THEN 'Contingent'
        WHEN lower(assign.main_document_type) = lower('Requisition') THEN 'Contingent'
        WHEN lower(assign.main_document_type) = lower('Contingent Labor') THEN 'Contingent'
        WHEN lower(assign.main_document_type) = lower('Contingent Labour') THEN 'Contingent'
        WHEN lower(assign.main_document_type) = lower('Statement of Work') THEN 'SOW'
        WHEN lower(assign.main_document_type) = lower('Independent Contractor') THEN 'SOW'
        WHEN lower(assign.main_document_type) = lower('SOW Contract') THEN 'SOW'
        WHEN lower(assign.main_document_type) = lower('Project') THEN 'SOW'
        ELSE 'NULL'
    END AS contingent_vs_sow,
    Function_library${region}.least_array([worker.worker_end_date ,worker.worker_closed_date]) as reporting_date_ends,
       worker.worker_status,
    CAST(Function_library${region}.f_calendarday(req.req_approved_date, assign.assignment_create_date_initial) AS INT64) AS time_to_fill_cd,
    ROUND(Function_library${region}.f_workday(req.req_approved_date, assign.assignment_create_date_initial), 2) AS time_to_fill_bd,
    CAST(Function_library${region}.f_calendarday(req.req_approved_date, cand.cand_submit_date) AS INT64) AS approve_to_submit_cd,
    ROUND(Function_library${region}.f_workday(req.req_approved_date, cand.cand_submit_date), 4) AS approve_to_submit_bd,

    CASE
      WHEN req.max_requested_bill_rate_st_hr >= assign_v0_rates.bill_rate_st_hr_initial THEN 'Compliant'
      ELSE
        CASE
            WHEN assign_v0_rates.bill_rate_st_hr_initial <  (CAST('1.15' AS NUMERIC) * req.max_requested_bill_rate_st_hr) THEN 'Non-Compliant - Under 115%% Max Bill Rate'
            ELSE 'Non-Compliant - Over 115%% Max Bill Rate'
        END
    END AS compliance_vs_max_bill_rate,
-- As per BP TBA, template bill rate shd be replaced with max requested bill rate for Bee coz its not captured
    CASE
      WHEN req.max_template_bill_rate_st_hr >= assign_v0_rates.bill_rate_st_hr_initial THEN 'Compliant'
      ELSE
        CASE
            WHEN assign_v0_rates.bill_rate_st_hr_initial <  (CAST('1.15' AS NUMERIC) * req.max_template_bill_rate_st_hr) THEN 'Non-Compliant - Under 115%% Max Bill Rate'
            ELSE 'Non-Compliant - Over 115%% Max Bill Rate'
        END
    END AS compliance_vs_max_template_bill_rate,

    ROUND(CASE
            WHEN assign_rates.pay_rate_st_hr = 0 THEN 0.0000
            ELSE (assign_rates.bill_rate_st_hr / assign_rates.pay_rate_st_hr - 1)
        END
    , 4) AS markup,
    CASE
        WHEN assign_rates.currency = 'USD' THEN 1.0
        ELSE CAST(fx_usd.fx_rate AS NUMERIC)
    END AS usd_fx_rate,
    CASE
        WHEN assign_rates.currency = 'EUR' THEN 1.0
        ELSE CAST(fx_eur.fx_rate AS NUMERIC)
    END AS eur_fx_rate,
    CASE
        WHEN assign_rates.currency = 'GBP' THEN 1.0
        ELSE CAST(fx_gbp.fx_rate AS NUMERIC)
    END AS gbp_fx_rate,
    CASE
        WHEN assign_rates.currency = 'INR' THEN 1.0
        ELSE CAST(fx_inr.fx_rate AS NUMERIC)
    END AS inr_fx_rate,
    CASE
        WHEN assign_rates.currency = 'CAD' THEN 1.0
        ELSE CAST(fx_cad.fx_rate AS NUMERIC)
    END AS cad_fx_rate,
    CASE
        WHEN assign_rates.currency = 'USD' THEN assign_rates.bill_rate_st_hr
        ELSE assign_rates.bill_rate_st_hr * CAST(fx_usd.fx_rate AS NUMERIC)
    END AS bill_rate_st_hr_usd,
    CASE
        WHEN assign_rates.currency = 'EUR' THEN assign_rates.bill_rate_st_hr
        ELSE assign_rates.bill_rate_st_hr * CAST(fx_eur.fx_rate AS NUMERIC)
    END AS bill_rate_st_hr_eur,
    CASE
        WHEN assign_rates.currency = 'GBP' THEN assign_rates.bill_rate_st_hr
        ELSE assign_rates.bill_rate_st_hr * CAST(fx_gbp.fx_rate AS NUMERIC)
    END AS bill_rate_st_hr_gbp,
    CASE
        WHEN assign_rates.currency = 'INR' THEN assign_rates.bill_rate_st_hr
        ELSE assign_rates.bill_rate_st_hr * CAST(fx_inr.fx_rate AS NUMERIC)
    END AS bill_rate_st_hr_inr,
    CASE
        WHEN assign_rates.currency = 'CAD' THEN assign_rates.bill_rate_st_hr
        ELSE assign_rates.bill_rate_st_hr * CAST(fx_cad.fx_rate AS NUMERIC)
    END AS bill_rate_st_hr_cad,
    assign.rsr_assignment_control_date,
    CASE
      WHEN coalesce(Function_library${region}.f_calendarday(worker.worker_start_date, worker.worker_end_date), CAST(0 as NUMERIC)) <= 60 THEN '< 2 months'
      WHEN coalesce(Function_library${region}.f_calendarday(worker.worker_start_date, worker.worker_end_date), CAST(0 as NUMERIC)) <= 181 THEN '2 - 6 months'
      WHEN coalesce(Function_library${region}.f_calendarday(worker.worker_start_date, worker.worker_end_date), CAST(0 as NUMERIC)) <= 365 THEN '6 - 12 months'
      WHEN  coalesce(Function_library${region}.f_calendarday(worker.worker_start_date, worker.worker_end_date), CAST(0 as NUMERIC)) <= 730 THEN '1 - 2 years'
      ELSE '2 + years'
    END AS planned_tenure_buckets,
	CASE
      WHEN coalesce(Function_library${region}.f_calendarday(worker.worker_start_date, CAST(current_timestamp() AS DATETIME)), CAST(0 as NUMERIC)) <= 60 THEN '< 2 months'
      WHEN coalesce(Function_library${region}.f_calendarday(worker.worker_start_date, CAST(current_timestamp() AS DATETIME)), CAST(0 as NUMERIC)) <= 181 THEN '2 - 6 months'
      WHEN coalesce(Function_library${region}.f_calendarday(worker.worker_start_date, CAST(current_timestamp() AS DATETIME)), CAST(0 as NUMERIC)) <= 365 THEN '6 - 12 months'
      WHEN coalesce(Function_library${region}.f_calendarday(worker.worker_start_date, CAST(current_timestamp() AS DATETIME)), CAST(0 as NUMERIC)) <= 730 THEN '1 - 2 years'
      ELSE '2 + years'
    END AS current_tenure_buckets,
    COALESCE(global_sourcing_type_wo.sourced_type_assignment, req.rsr_sourced_type, 'Recruited') AS rsr_sourced_type,
    CURRENT_DATE() as current_date,
    Function_library${region}.f_calendarday(worker.worker_start_date, worker.worker_end_date) AS planned_tenure_cd,
	Function_library${region}.f_calendarday(worker.worker_start_date, CAST(current_timestamp() AS DATETIME)) AS current_tenure_cd,
	CAST(Function_library${region}.f_calendarday(assign.assignment_create_date_initial, worker.worker_start_date) AS INT64) AS create_to_start_cd,
    CAST(Function_library${region}.f_workday(assign.assignment_create_date_initial, worker.worker_start_date) as INT64) AS create_to_start_bd,
    CAST(NULL AS STRING) AS vendor_id,
	-- Fields needed for other MSTs
    CASE
      WHEN LOWER(cand.presented_bill_rate_st_basis) = 'hourly' THEN cand.presented_bill_rate
      WHEN LOWER(cand.presented_bill_rate_st_basis) = 'daily' THEN (cand.presented_bill_rate /(req.hours_per_week/req.days_per_week))
      WHEN LOWER(cand.presented_bill_rate_st_basis) = 'monthly' THEN (cand.presented_bill_rate /((req.hours_per_week/req.days_per_week)*4.33))
      WHEN LOWER(cand.presented_bill_rate_st_basis) = 'weekly' THEN (cand.presented_bill_rate /(req.hours_per_week))
      ELSE CAST(NULL AS NUMERIC)
    END AS presented_bill_rate_st_hr, -- needed for Spend MST
    req.max_requested_bill_rate_st_hr, -- needed for Spend, Cand MST
    req.primary_cost_center, -- needed for Cand MST
	assign.main_document_type, -- needed for Assgn trend
	req.req_title_classification, -- needed for Assgn trend
	req.req_type, -- needed for Assgn trend
	req.req_closed_date, -- needed for Assgn trend
	assign.cand_offer_accepted_date_initial AS cand_offer_accepted_date,
	assign.rsr_client_code,
    req.req_id, -- main_document_id can be used in Asgn trend
	req.req_title, -- not needed
    req.req_create_date, -- not needed
    req.req_end_date, -- not needed
    worker.worker_close_reason AS _rf_worker_close_reason, -- need this for audit, can be removed later
    assign.close_reason AS _rf_asgm_close_reason, -- need this for audit, can be removed later
    assign.rsr_processed_date,
    CASE
        WHEN assign_rates.currency = 'USD' THEN assign_rates.pay_rate_st_hr
        ELSE assign_rates.pay_rate_st_hr * CAST(fx_usd.fx_rate AS NUMERIC)
    END AS pay_rate_st_hr_usd,
    CASE
        WHEN assign_rates.currency = 'EUR' THEN assign_rates.pay_rate_st_hr
        ELSE assign_rates.pay_rate_st_hr * CAST(fx_eur.fx_rate AS NUMERIC)
    END AS pay_rate_st_hr_eur,
    CASE
        WHEN assign_rates.currency = 'GBP' THEN assign_rates.pay_rate_st_hr
        ELSE assign_rates.pay_rate_st_hr * CAST(fx_gbp.fx_rate AS NUMERIC)
    END AS pay_rate_st_hr_gbp,
    CASE
        WHEN assign_rates.currency = 'INR' THEN assign_rates.pay_rate_st_hr
        ELSE assign_rates.pay_rate_st_hr * CAST(fx_inr.fx_rate AS NUMERIC)
    END AS pay_rate_st_hr_inr,
    CASE
        WHEN assign_rates.currency = 'CAD' THEN assign_rates.pay_rate_st_hr
        ELSE assign_rates.pay_rate_st_hr * CAST(fx_cad.fx_rate AS NUMERIC)
    END AS pay_rate_st_hr_cad
    ,NULL AS preferred_supplier_status,
    #cost_savings 2024 Fall Release
    assign.assignment_start_date,
assign.assignment_end_date,
assign.assignment_original_start_date,
assign.assignment_original_end_date,

  CASE WHEN IFNULL(global_wo_term_reason.termination_reason_DW, 'NULL') LIKE '%%Converted to FTE%%'
 THEN assign.perm_recruitment_fee_fixed
  ELSE CAST(NULL AS FLOAT64) 
  END as perm_recruitment_fee_savings,
   CASE
      WHEN assign.rsr_savings_currency = 'USD' THEN 
        (CASE WHEN IFNULL(global_wo_term_reason.termination_reason_DW, 'NULL') LIKE '%%Converted to FTE%%' THEN assign.perm_recruitment_fee_fixed END)
      ELSE (CASE WHEN IFNULL(global_wo_term_reason.termination_reason_DW, 'NULL') LIKE '%%Converted to FTE%%' THEN assign.perm_recruitment_fee_fixed END) * fx_usd_savings.fx_rate
    END AS perm_recruitment_fee_savings_in_usd,
    CASE
      WHEN assign.rsr_savings_currency = 'EUR' THEN 
        (CASE WHEN IFNULL(global_wo_term_reason.termination_reason_DW, 'NULL') LIKE '%%Converted to FTE%%' THEN assign.perm_recruitment_fee_fixed END)
      ELSE (CASE WHEN IFNULL(global_wo_term_reason.termination_reason_DW, 'NULL') LIKE '%%Converted to FTE%%' THEN assign.perm_recruitment_fee_fixed END) * fx_eur_savings.fx_rate
    END AS perm_recruitment_fee_savings_in_eur,
    CASE
      WHEN assign.rsr_savings_currency = 'GBP' THEN 
        (CASE WHEN IFNULL(global_wo_term_reason.termination_reason_DW, 'NULL') LIKE '%%Converted to FTE%%' THEN assign.perm_recruitment_fee_fixed END)
      ELSE (CASE WHEN IFNULL(global_wo_term_reason.termination_reason_DW, 'NULL') LIKE '%%Converted to FTE%%' THEN assign.perm_recruitment_fee_fixed END) * fx_gbp_savings.fx_rate
    END AS perm_recruitment_fee_savings_in_gbp,
    CASE
      WHEN assign.rsr_savings_currency = 'INR' THEN 
        (CASE WHEN IFNULL(global_wo_term_reason.termination_reason_DW, 'NULL') LIKE '%%Converted to FTE%%' THEN assign.perm_recruitment_fee_fixed END)
      ELSE (CASE WHEN IFNULL(global_wo_term_reason.termination_reason_DW, 'NULL') LIKE '%%Converted to FTE%%' THEN assign.perm_recruitment_fee_fixed END) * fx_inr_savings.fx_rate
    END AS perm_recruitment_fee_savings_in_inr,
    CASE
      WHEN assign.rsr_savings_currency = 'CAD' THEN 
        (CASE WHEN IFNULL(global_wo_term_reason.termination_reason_DW, 'NULL') LIKE '%%Converted to FTE%%' THEN assign.perm_recruitment_fee_fixed END)
      ELSE (CASE WHEN IFNULL(global_wo_term_reason.termination_reason_DW, 'NULL') LIKE '%%Converted to FTE%%' THEN assign.perm_recruitment_fee_fixed END) * fx_cad_savings.fx_rate
    END AS perm_recruitment_fee_savings_in_cad,

   CASE
    WHEN (worker.worker_start_date IS NOT NULL AND assign.assignment_original_start_date IS NOT NULL AND worker.worker_start_date < assign.assignment_original_start_date AND req.rsr_sourced_type NOT LIKE '%%Administrative%%') THEN 
    (assign.rehire_onboarding_hours * assign_v0_rates.bill_rate_st_hr_initial) 
    ELSE CAST(NULL AS FLOAT64) END
    as rehire_onboarding_savings,

  CASE
    WHEN (worker.worker_start_date IS NOT NULL AND assign.assignment_original_start_date IS NOT NULL AND worker.worker_start_date < assign.assignment_original_start_date AND req.rsr_sourced_type NOT LIKE '%%Administrative%%') THEN 
        CASE
          WHEN assign.rsr_savings_currency = 'USD' THEN (assign.rehire_onboarding_hours * assign_v0_rates.bill_rate_st_hr_initial)
          ELSE (assign.rehire_onboarding_hours * assign_v0_rates.bill_rate_st_hr_initial) * fx_usd_savings.fx_rate
        END
    END AS rehire_onboarding_savings_in_usd,
    CASE
      WHEN (worker.worker_start_date IS NOT NULL AND assign.assignment_original_start_date IS NOT NULL AND worker.worker_start_date < assign.assignment_original_start_date AND req.rsr_sourced_type NOT LIKE '%%Administrative%%') THEN
        CASE
          WHEN assign.rsr_savings_currency = 'CAD' THEN (assign.rehire_onboarding_hours * assign_v0_rates.bill_rate_st_hr_initial)
          ELSE (assign.rehire_onboarding_hours * assign_v0_rates.bill_rate_st_hr_initial) * fx_cad_savings.fx_rate
        END
    END AS rehire_onboarding_savings_in_cad,
    CASE
      WHEN (worker.worker_start_date IS NOT NULL AND assign.assignment_original_start_date IS NOT NULL AND worker.worker_start_date < assign.assignment_original_start_date AND req.rsr_sourced_type NOT LIKE '%%Administrative%%') THEN
        CASE
          WHEN assign.rsr_savings_currency = 'INR' THEN (assign.rehire_onboarding_hours * assign_v0_rates.bill_rate_st_hr_initial)
          ELSE (assign.rehire_onboarding_hours * assign_v0_rates.bill_rate_st_hr_initial) * fx_inr_savings.fx_rate
        END
    END AS rehire_onboarding_savings_in_inr,
    CASE
      WHEN (worker.worker_start_date IS NOT NULL AND assign.assignment_original_start_date IS NOT NULL AND worker.worker_start_date < assign.assignment_original_start_date AND req.rsr_sourced_type NOT LIKE '%%Administrative%%') THEN
        CASE
          WHEN assign.rsr_savings_currency = 'GBP' THEN (assign.rehire_onboarding_hours * assign_v0_rates.bill_rate_st_hr_initial)
          ELSE (assign.rehire_onboarding_hours * assign_v0_rates.bill_rate_st_hr_initial) * fx_gbp_savings.fx_rate
        END
    END AS rehire_onboarding_savings_in_gbp,
    CASE
      WHEN (worker.worker_start_date IS NOT NULL AND assign.assignment_original_start_date IS NOT NULL AND worker.worker_start_date < assign.assignment_original_start_date AND req.rsr_sourced_type NOT LIKE '%%Administrative%%') THEN
        CASE
          WHEN assign.rsr_savings_currency = 'EUR' THEN (assign.rehire_onboarding_hours * assign_v0_rates.bill_rate_st_hr_initial)
          ELSE (assign.rehire_onboarding_hours * assign_v0_rates.bill_rate_st_hr_initial) * fx_eur_savings.fx_rate
        END
    END AS rehire_onboarding_savings_in_eur,
	
assign.rsr_staffing_entity, -- winter_release 2025
norm_jt.suppressed_title,
norm_jt.pii_found,
norm_jt.process_status,
norm_jt.suppression_type,
norm_jt.llm_cleaned,
norm_jt.title_cleaned,
norm_jt.ms_category_1,
norm_jt.ms_category_2,
norm_jt.onet_career_pathway,
norm_jt.onet_job_family,
norm_jt.onet_career_cluster,
norm_jt.onet_occupation,
norm_jt.soc_major_group,
norm_jt.soc_minor_group,
norm_jt.soc_broad_group,
norm_jt.onet_detailed_occupation,
norm_jt.bg_categorization,
norm_jt.tk_categorization,
norm_jt.rand_categorization,
norm_jt.rmi_categorization,
norm_jt.R1_label,
norm_jt.R2_label,
norm_jt.R3_label,
norm_jt.R4_label,
norm_jt.R5_label,
norm_jt.R6_label,
norm_loc.location_level_1,
norm_loc.location_level_2,
norm_loc.location_level_3,
norm_loc.location_level_4,
norm_loc.location_level_5,
norm_loc.location_level_6,
norm_loc.location_level_7,
norm_loc.location_level_8,
norm_loc.location_level_1a,
norm_loc.location_level_2a





  FROM
    asg_asg_v0 AS assign
    LEFT OUTER JOIN %s.%s AS req ON assign.main_document_id = req.req_id
    LEFT OUTER JOIN worker ON assign.assignment_id = worker.assignment_id
    LEFT OUTER JOIN assign_rates ON assign.assignment_id = assign_rates.assignment_id and assign.assignment_revision_id = assign_rates.assignment_revision_id
    LEFT OUTER JOIN assign_v0_rates ON assign.assignment_id = assign_v0_rates.assignment_id
    -- and assign.assignment_revision_id = assign_v0_rates.assignment_revision_id -- extra condition added in join bcz netive has two fields as unique key
    LEFT OUTER JOIN cand_non_transactional cand ON assign.main_document_id = cand.req_id
     AND assign.cand_id = cand.cand_id
    LEFT OUTER JOIN db_common${region}.global_wo_term_reason AS global_wo_term_reason ON (CASE
        WHEN LOWER(worker.worker_status) = 'closed' THEN COALESCE(worker.worker_close_reason,assign.close_reason)
        ELSE CAST(NULL AS STRING)
    END) = global_wo_term_reason.work_order_close_reason
    LEFT OUTER JOIN db_common${region}.global_state_mapping AS global_state_mapping ON assign.state_province = global_state_mapping.vms_state
    LEFT OUTER JOIN db_common${region}.global_sourcing_type_assignment AS global_sourcing_type_wo
        ON assign.sourcing_type_wo = global_sourcing_type_wo.vms_source_type
    LEFT JOIN db_common${region}.global_countries gcr on lower(assign.country) = lower(gcr.country)
    LEFT OUTER JOIN db_common${region}.global_supplier_mapping AS global_supp_map ON assign.buyer = global_supp_map.buyer AND assign.supplier = global_supp_map.supplier
    LEFT OUTER JOIN db_common${region}.global_calendar_445 AS global_calendar_445 ON assign.rsr_assignment_control_date = PARSE_DATE("%%m/%%d/%%Y", global_calendar_445.day)
	LEFT JOIN fx_rates fx_usd ON assign_rates.currency = fx_usd.from_currency AND assign.rsr_assignment_control_date_monthstart=fx_usd.month AND fx_usd.to_currency = 'USD'
    LEFT JOIN fx_rates fx_eur ON assign_rates.currency = fx_eur.from_currency AND assign.rsr_assignment_control_date_monthstart=fx_eur.month AND fx_eur.to_currency = 'EUR'
    LEFT JOIN fx_rates fx_gbp ON assign_rates.currency = fx_gbp.from_currency AND assign.rsr_assignment_control_date_monthstart=fx_gbp.month AND fx_gbp.to_currency = 'GBP'
    LEFT JOIN fx_rates fx_inr ON assign_rates.currency = fx_inr.from_currency AND assign.rsr_assignment_control_date_monthstart=fx_inr.month AND fx_inr.to_currency = 'INR'
    LEFT JOIN fx_rates fx_cad ON assign_rates.currency = fx_cad.from_currency AND assign.rsr_assignment_control_date_monthstart=fx_cad.month AND fx_cad.to_currency = 'CAD'
    LEFT JOIN db${region}_aptus.aptus_suppio_supplier_diversity_data div_supp ON lower(div_supp.customer_code)=lower(assign.buyer_code) AND div_supp.supplier_code=assign.supplier_code AND div_supp.fiscal_year=CAST(EXTRACT(YEAR FROM CAST(assign.assignment_create_date AS DATE)) AS INTEGER) AND div_supp.accounting_period=CAST(EXTRACT(MONTH FROM CAST(assign.assignment_create_date AS DATE)) AS INTEGER)
     #cost_savings 2024 Fall Release
    LEFT JOIN fx_rates fx_usd_savings ON assign.rsr_savings_currency = fx_usd_savings.from_currency AND assign.rsr_assignment_control_date_monthstart=fx_usd_savings.month AND fx_usd_savings.to_currency = 'USD'
    LEFT JOIN fx_rates fx_eur_savings ON assign.rsr_savings_currency = fx_eur_savings.from_currency AND assign.rsr_assignment_control_date_monthstart=fx_eur_savings.month AND fx_eur_savings.to_currency = 'EUR'
    LEFT JOIN fx_rates fx_gbp_savings ON assign.rsr_savings_currency = fx_gbp_savings.from_currency AND assign.rsr_assignment_control_date_monthstart=fx_gbp_savings.month AND fx_gbp_savings.to_currency = 'GBP'
    LEFT JOIN fx_rates fx_inr_savings ON assign.rsr_savings_currency = fx_inr_savings.from_currency AND assign.rsr_assignment_control_date_monthstart=fx_inr_savings.month AND fx_inr_savings.to_currency = 'INR'
    LEFT JOIN fx_rates fx_cad_savings ON assign.rsr_savings_currency = fx_cad_savings.from_currency AND assign.rsr_assignment_control_date_monthstart=fx_cad_savings.month AND fx_cad_savings.to_currency = 'CAD'
    LEFT JOIN db${region}_yellowdata_normalization.job_titles_${dataform.projectConfig.vars.dataset_id}_normalised norm_jt on assign.main_document_title = norm_jt.raw_job_title
    LEFT JOIN db${region}_yellowdata_normalization.locations_${dataform.projectConfig.vars.dataset_id}_normalised norm_loc on COALESCE(assign.city, '') = COALESCE(norm_loc.city, '') AND COALESCE(assign.rsr_state, '') = COALESCE(norm_loc.state, '')
  AND COALESCE(assign.state_province, '') = COALESCE(norm_loc.province, '') AND COALESCE( assign.rsr_country, '') = COALESCE(norm_loc.country_name, '') AND COALESCE(assign.country, '') = COALESCE(norm_loc.country_code, ''))""",gold_dataset,assignment_table_id, slvr_cand, slvr_cand, slvr_assgn, slvr_assgn_v0, slvr_wrkr, slvr_assgn_rt, slvr_assgn_rt_v0, gold_dataset,requisition_table_id)
