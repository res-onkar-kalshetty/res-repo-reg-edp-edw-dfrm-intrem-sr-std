config {
    type: "operations",
    name: "msp_ntv_template_requisition_gold",
    tags: 'msp_ntv_template_gold',
    description: 'This file creates the  stdrv layer '
}

js {
   const helper = require("/includes/helper");

    const config_ds_name = helper.get_config_ds();
    const config_table_name = helper.get_config_table();
    const env = helper.get_env();
    const region = helper.get_region();
    const dataset_id = dataform.projectConfig.vars.dataset_id;

    const gold_dataset = (env == "prd") ?
        `gold_${dataset_id}` :
        `dev_gold_${dataset_id}`;

    const slvr_dataset = (env == "prd") ?
        `slvr_${dataset_id}` :
        `dev_slvr_${dataset_id}`;

    const slvr_cand = helper.getSlvrTableName(config_ds_name, config_table_name, 'candidate_src', dataset_id);
    const slvr_req_tmp = helper.getSlvrTableName(config_ds_name, config_table_name, 'requisition_template_src', dataset_id);
    const slvr_req = helper.getSlvrTableName(config_ds_name, config_table_name, 'requisition_src', dataset_id);
    const slvr_assgn = helper.getSlvrTableName(config_ds_name, config_table_name, 'assignment_src', dataset_id);
    const slvr_req_dist = helper.getSlvrTableName(config_ds_name, config_table_name, 'requisition_distribution_src', dataset_id);
}

DECLARE
  requisition_table_id STRING;
DECLARE
  gold_dataset STRING;
DECLARE
  slvr_dataset STRING;
DECLARE
  config_ds_name STRING;
DECLARE
  config_table_name STRING;
DECLARE
  region STRING;
DECLARE
  slvr_req STRING;
DECLARE
  slvr_cand STRING;
DECLARE
  slvr_req_tmp STRING;
DECLARE
  slvr_assgn STRING;
DECLARE
  slvr_req_dist STRING;
SET
  config_ds_name = '${config_ds_name}';
SET
  config_table_name = '${config_table_name}';
SET
  region = '${region}';
SET
  gold_dataset = '${gold_dataset}';
SET
  slvr_dataset = '${slvr_dataset}';
SET
  slvr_req = 'v_' || ${slvr_req};
SET
  slvr_cand = 'v_' || ${slvr_cand};
SET
  slvr_req_tmp = 'v_' || ${slvr_req_tmp};
SET
  slvr_assgn = 'v_' || ${slvr_assgn};
SET
  slvr_req_dist = 'v_' || ${slvr_req_dist};

SET requisition_table_id="stdrv_requisition_" || '${dataform.projectConfig.vars.client_code}';

EXECUTE IMMEDIATE
FORMAT ("""
CREATE OR REPLACE TABLE
  %s.%s AS (
  WITH
candidate_data AS (
SELECT
  buyer_code,
  req_id,
  MIN(cand_submit_date) AS first_cand_submitted_date,
  COUNT(DISTINCT cand_id) AS cand_submitted_cnt,
  COUNT(DISTINCT supplier) AS suppliers_responded_cnt
FROM
  `${slvr_dataset}.%s`
GROUP BY
  req_id,
  buyer_code ),
req_temp_data AS (
SELECT
  req_temp_in.req_id,
  req_temp_in.buyer_code,
  CASE
    WHEN LOWER(req_temp_in.max_template_bill_rate_st_basis) = 'hourly' THEN req_temp_in.max_template_bill_rate_st_hr
    WHEN LOWER(req_temp_in.max_template_bill_rate_st_basis) = 'daily' THEN (req_temp_in.max_template_bill_rate_st_hr /(req_in.hours_per_week/req_in.days_per_week))
    WHEN LOWER(req_temp_in.max_template_bill_rate_st_basis) = 'monthly' THEN (req_temp_in.max_template_bill_rate_st_hr /((req_in.hours_per_week/req_in.days_per_week)*4.33))
    WHEN LOWER(req_temp_in.max_template_bill_rate_st_basis) = 'weekly' THEN (req_temp_in.max_template_bill_rate_st_hr /(req_in.hours_per_week))
END
  AS max_template_bill_rate_st_hr,
FROM
  `${slvr_dataset}.%s` req_temp_in
LEFT JOIN
  `${slvr_dataset}.%s` req_in
ON
  req_in.req_id= req_temp_in.req_id ),
wo_data AS (
SELECT
  COUNT(assignment_id) AS hired_cnt,
  buyer_code,
  main_document_id
FROM
  `${slvr_dataset}.%s`
WHERE
  last_assignment_in_chain = 1 -- netive specific FILTER which picks the latest revision OF the ASSIGNMENT
GROUP BY
  buyer_code,
  main_document_id ),
req_dist_data AS (
SELECT
  COUNT(DISTINCT
    CASE
      WHEN COALESCE(req_distribution_status, 'na') <> 'Declined' THEN supplier
      ELSE CAST(NULL AS STRING)
  END
    ) AS suppliers_posted_cnt,
  MIN(req_distribution_date) AS earliest_req_dist_date,
  buyer_code,
  req_id
FROM
  `${slvr_dataset}.%s`
GROUP BY
  buyer_code,
  req_id )
SELECT
req.buyer,
req.buyer_code,
req.req_id,
req.req_title,
req.labor_type,
req.sourcing_type,
req.sourcing_type_template,
IFNULL( gbl_src.sourcing_dw,
  CASE
    WHEN cand.cand_submitted_cnt <= 1 AND req_dist.suppliers_posted_cnt <= 1 THEN 'Pre-ID'
    ELSE 'Recruited'
END
  ) AS rsr_sourced_type,
req.req_status,
req.req_owner,
COALESCE(req.req_type, req.posting_type) AS req_type,
req.posting_type,
CASE
  WHEN req.req_status NOT IN ('Open', 'On Hold', 'Pending') THEN req.close_reason
  ELSE NULL
END
AS close_reason,
CASE
  WHEN req.req_status LIKE 'Cancelled' THEN (CASE
    WHEN req.req_status NOT IN ('Open',
    'On Hold',
    'Pending') THEN req.close_reason
    ELSE NULL
END
  )
  ELSE NULL
END
AS withdraw_reason,
req.business_unit_code,
req.business_unit,
req.site,
req.site_code,
req.division,
req.location_code,
req.location,
req.req_category,
req.city,
req.state_province,
req.country,
req.zip_postal_code,
req.first_respond_date,
req.req_approved_date,
req.req_closed_date,
req.req_create_date,
req.req_end_date,
req.req_respond_by_date AS req_responded_by_date,
req.req_start_date,
req.req_submit_date AS req_submitted_date,
req.req_first_approved_date,
req.req_creator_name,
req.req_distributor_name,
req.req_coordinator_name,
req.max_requested_bill_rate_st_hr,
CASE
  WHEN LOWER(req.max_requested_bill_rate_basis) = 'hourly' THEN req.max_requested_pay_rate
  WHEN LOWER(req.max_requested_bill_rate_basis) = 'daily' THEN (req.max_requested_pay_rate /(req.hours_per_week/days_per_week))
  WHEN LOWER(req.max_requested_bill_rate_basis) = 'monthly' THEN (req.max_requested_pay_rate /((req.hours_per_week/days_per_week)*4.33))
  WHEN LOWER(req.max_requested_bill_rate_basis) = 'weekly' THEN (req.max_requested_pay_rate /(req.hours_per_week))
END
AS max_requested_pay_rate_st_hr,
req.min_requested_bill_rate_st_hr,
req.min_requested_pay_rate_st_hr,
req.hours_per_week,
req.hours_per_day,
req.msp_code,
req.msp,
req.start_day_of_week,
req.positions_requested_cnt,
req.positions_remaining_cnt,
req_temp.max_template_bill_rate_st_hr,
-- gjcr.closed_reason_dw AS rsr_close_reason,
CASE 
    WHEN IFNULL(gjcr.closed_reason_dw, '') <> '' THEN gjcr.closed_reason_dw
    WHEN IFNULL(CASE WHEN req.req_status NOT IN ('Open', 'On Hold', 'Pending') THEN req.close_reason ELSE NULL END, '') = '' THEN 'Undisclosed'
    ELSE 'Unmapped'
END AS rsr_close_reason,
CASE 
    WHEN IFNULL(glt.labor_type_dw, '') <> '' THEN glt.labor_type_dw
    WHEN IFNULL(req.labor_type, '') = '' THEN 'Undisclosed'
    ELSE 'Unmapped'
END AS rsr_labor_type,
-- gsm.rsr_state,
  CASE 
    WHEN IFNULL(gsm.rsr_state, '') <> '' THEN gsm.rsr_state
    WHEN IFNULL(req.state_province, '') = '' THEN 'Undisclosed'
    ELSE 'Unmapped'
  END AS rsr_state,
  -- gcr.rsr_country,
  CASE 
    WHEN IFNULL(gcr.rsr_country, '') <> '' THEN gcr.rsr_country
    WHEN IFNULL(req.country, '') = '' THEN 'Undisclosed'
    ELSE 'Unmapped'
  END AS rsr_country,
  -- gcr.rsr_region,
  CASE 
    WHEN IFNULL(gcr.rsr_region, '') <> '' THEN gcr.rsr_region
    WHEN IFNULL(req.country, '') = '' THEN 'Undisclosed'
    ELSE 'Unmapped'
  END AS rsr_region,
gcr.country AS rsr_country_code,
CURRENT_DATE() AS current_date,
CAST(Function_library${region}.f_calendarday(req.req_approved_date,
    CAST(CURRENT_TIMESTAMP() AS DATETIME)) AS INT64) AS req_aging_cd,
ROUND(Function_library${region}.f_workday(req.req_approved_date,
    CAST(CURRENT_TIMESTAMP() AS DATETIME)),2) AS req_aging_bd,
CAST(Function_library${region}.f_calendarday(req.req_create_date,
    req.req_approved_date) AS INT64) AS create_to_approve_cd,
ROUND(Function_library${region}.f_workday(req.req_create_date,
    req.req_approved_date),2) AS create_to_approve_bd,
CAST(Function_library${region}.f_calendarday(req.req_approved_date,
    cand.first_cand_submitted_date) AS INT64) AS time_to_submit_first_cand_cd,
ROUND(Function_library${region}.f_workday(req.req_approved_date,
    cand.first_cand_submitted_date),2) AS time_to_submit_first_cand_bd,
grs.rsr_job_posting_status AS rsr_req_status,-- job posting status
assing.hired_cnt,
cand.cand_submitted_cnt,
req_dist.suppliers_posted_cnt,
cand.suppliers_responded_cnt,
cand.first_cand_submitted_date,
req_dist.earliest_req_dist_date,
-- Fields used FOR other derv views
req.dist_list,
req.primary_cost_center,
req.req_title_classification,
'${dataform.projectConfig.vars.client_code}' AS rsr_client_code,
req.updated_ts as rsr_processed_date,
req.currency,
req.days_per_week,
req.rate_unit_type, -- needed FOR CANDIDATE MST netive specific field
req.service_type, -- needed FOR ASSIGNMENT MST,added BY SB
req.rsr_staffing_entity, -- winter_release 2025
norm_jt.suppressed_title,
norm_jt.pii_found,
norm_jt.process_status,
norm_jt.suppression_type,
norm_jt.llm_cleaned,
norm_jt.title_cleaned,
norm_jt.ms_category_1,
norm_jt.ms_category_2,
norm_jt.onet_career_pathway,
norm_jt.onet_job_family,
norm_jt.onet_career_cluster,
norm_jt.onet_occupation,
norm_jt.soc_major_group,
norm_jt.soc_minor_group,
norm_jt.soc_broad_group,
norm_jt.onet_detailed_occupation,
norm_jt.bg_categorization,
norm_jt.tk_categorization,
norm_jt.rand_categorization,
norm_jt.rmi_categorization,
norm_jt.R1_label,
norm_jt.R2_label,
norm_jt.R3_label,
norm_jt.R4_label,
norm_jt.R5_label,
norm_jt.R6_label,
norm_loc.location_level_1,
norm_loc.location_level_2,
norm_loc.location_level_3,
norm_loc.location_level_4,
norm_loc.location_level_5,
norm_loc.location_level_6,
norm_loc.location_level_7,
norm_loc.location_level_8,
norm_loc.location_level_1a,
norm_loc.location_level_2a
FROM
`${slvr_dataset}.%s` req
LEFT JOIN
req_dist_data AS req_dist
ON
req.req_id = req_dist.req_id
LEFT JOIN
candidate_data AS cand
ON
req.req_id = cand.req_id
LEFT JOIN
req_temp_data AS req_temp
ON
req.req_id= req_temp.req_id
LEFT JOIN
wo_data AS assing
ON
req.req_id = assing.main_document_id
LEFT JOIN
`db_common${region}.global_jp_closed_reason` gjcr
ON
(CASE
    WHEN req.req_status NOT IN ('Open', 'On Hold', 'Pending') THEN req.close_reason
END
  ) = gjcr.close_reason
LEFT JOIN
`db_common${region}.global_labor_type` glt
ON
req.labor_type = glt.vms_labor_type
LEFT JOIN
`db_common${region}.global_state_mapping` gsm
ON
req.state_province = gsm.vms_state
LEFT JOIN
`db_common${region}.global_countries` gcr
ON
LOWER(req.country)=LOWER(gcr.country)
LEFT JOIN
`db_common${region}.global_job_posting_status` grs
ON
grs.job_posting_status = req.req_status
LEFT OUTER JOIN
db_common${region}.global_sourcing AS gbl_src
ON
TRIM(LOWER(gbl_src.sourcing_type)) = TRIM(LOWER(COALESCE(req.sourcing_type, req.sourcing_type_template, '')))
LEFT JOIN db${region}_yellowdata_normalization.job_titles_${dataform.projectConfig.vars.dataset_id}_normalised norm_jt on req.req_title = norm_jt.raw_job_title
    LEFT JOIN db${region}_yellowdata_normalization.locations_${dataform.projectConfig.vars.dataset_id}_normalised norm_loc on COALESCE(req.city, '') = COALESCE(norm_loc.city, '') AND COALESCE((CASE 
    WHEN IFNULL(gsm.vms_state, '') <> '' THEN gsm.vms_state
    WHEN IFNULL(req.state_province, '') = '' THEN 'Undisclosed'
    ELSE 'Unmapped'
  END), '') = COALESCE(norm_loc.state, '')
  AND COALESCE(req.state_province, '') = COALESCE(norm_loc.province, '') AND COALESCE((CASE 
    WHEN IFNULL(gcr.rsr_country, '') <> '' THEN gcr.rsr_country
    WHEN IFNULL(req.country, '') = '' THEN 'Undisclosed'
    ELSE 'Unmapped'
  END), '') = COALESCE(norm_loc.country_name, '') AND COALESCE(req.country, '') = COALESCE(norm_loc.country_code, ''))""",gold_dataset,requisition_table_id,
  slvr_cand,
  slvr_req_tmp,
  slvr_req,
  slvr_assgn,
  slvr_req_dist,
  slvr_req  
  );