config {
    type: "operations",
    name: "msp_ntv_template_candidate",
    tags: 'msp_ntv_template',
    dependencies: ['msp_ntv_template_requisition', 'msp_ntv_template_assignment'],
    description: 'This file creates the  stdrv layer'
}

CREATE OR REPLACE TABLE
  `${dataform.projectConfig.vars.ds_name}.stdrv_candidate_${dataform.projectConfig.vars.client_code}` AS (
  ------------------------------------------------------------------------
  -- CANDIDATE STATUS CTE
  ------------------------------------------------------------------------
  WITH
    status_dates AS (
    SELECT
      *,
      -- rank rows to get most recent status for application_status field
      ROW_NUMBER() OVER (PARTITION BY cand_status.req_id, cand_status.cand_id ORDER BY cand_status.status_datetime DESC, cand_status.rsr_processed_date DESC) AS rnk
    FROM (
      SELECT
        buyer,
        req_id,
        cand_id,
        new_status AS activity_status,
        MAX(new_status_datetime) AS status_datetime,
        MAX(rsr_processed_date) AS rsr_processed_date
      FROM
        `${dataform.projectConfig.vars.ds_name}.prs_candidate_${dataform.projectConfig.vars.client_code}`
      GROUP BY
        buyer,
        req_id,
        cand_id,
        new_status ) cand_status ),
    ------------------------------------------------------------------------
    -- Candidate non transactional dataset
    ------------------------------------------------------------------------
    cand_non_transactional AS(
  SELECT
    DISTINCT
    ------------------------------------------------------------------------
    -- STANDARD FIELDS FROM SOURCE
    ------------------------------------------------------------------------
    cand.buyer,
    cand.buyer_code,
    cand.req_id,
    cand.cand_id,
    cand.cand_name,
    cand.supplier,
    cand.cand_status,
    cand.cand_withdraw_reason AS withdrawn_reason,
    cand.cand_rejected_reason AS rejected_reason,
    cand.currency,
    cand.cand_available_date,
    cand.cand_buyer_first_viewed_date,
    cand.cand_first_submit_date AS cand_first_submitted_date,
    cand.cand_last_modified_date,
    cand.cand_unshortlisted_date,
    cand.location,
    cand.site_code,
    cand.site,
    cand.cand_code,
    cand.msp_code,
    cand.msp_company
    -- ,cand.presented_bill_rate_supplier_st_hr -- fields not present in ntv cand
    ,
    cand.default_rate
    -- netive specific field
    -- ,cand.supplier_code -- fields not present in ntv cand
    ,
    cand.uploaded,
    cand.rsr_client_code,
    cand.presented_bill_rate_st_basis,
    cand.presented_bill_rate,
    cand.presented_pay_rate
    ---- needed for supporting other calcs---
    ,
    cand.assignment_id
    ------------------------------------------------------------------------
    -- PIVOTED DATE FIELDS
    ------------------------------------------------------------------------
    -- cand_submit_date
    ,
    (
    SELECT
      MIN(status_datetime)
    FROM
      status_dates
    WHERE
      cand.req_id = status_dates.req_id
      AND cand.cand_id = status_dates.cand_id
      AND status_dates.activity_status IN ('proposed')) AS cand_submit_date
      -- cand_shortlisted_date
      ,
    (
    SELECT
      MIN(status_datetime)
    FROM
      status_dates
    WHERE
      cand.req_id = status_dates.req_id
      AND cand.cand_id = status_dates.cand_id
      AND status_dates.activity_status IN ('submitted_manager')) AS cand_shortlisted_date
      -- cand_interview_date
      ,
    (
    SELECT
      MIN(status_datetime)
    FROM
      status_dates
    WHERE
      cand.req_id = status_dates.req_id
      AND cand.cand_id = status_dates.cand_id
      AND status_dates.activity_status IN ('interview_1')) AS cand_interview_date
      -- cand_withdrawn_date
      ,
    (
    SELECT
      MIN(status_datetime)
    FROM
      status_dates
    WHERE
      cand.req_id = status_dates.req_id
      AND cand.cand_id = status_dates.cand_id
      AND status_dates.activity_status IN ('withdraw')) AS cand_withdrawn_date
      -- assignment_activation_date
      ,
    (
    SELECT
      MIN(status_datetime)
    FROM
      status_dates
    WHERE
      cand.req_id = status_dates.req_id
      AND cand.cand_id = status_dates.cand_id
      AND status_dates.activity_status IN ('hired')) AS assignment_activation_date
      -- cand_rejected_date
      ,
    (
    SELECT
      MIN(status_datetime)
    FROM
      status_dates
    WHERE
      cand.req_id = status_dates.req_id
      AND cand.cand_id = status_dates.cand_id
      AND status_dates.activity_status IN ('auto_rejected',
        'rejected',
        'rejected_msp')) AS cand_rejected_date
        -- cand_first_interview_date
        ,
    (
    SELECT
      MIN(status_datetime)
    FROM
      status_dates
    WHERE
      cand.req_id = status_dates.req_id
      AND cand.cand_id = status_dates.cand_id
      AND status_dates.activity_status IN ('interview_1',
        'interview_2')) AS cand_first_interviewed_date
        -- cand_last_interview_date
        ,
    (
    SELECT
      MAX(status_datetime)
    FROM
      status_dates
    WHERE
      cand.req_id = status_dates.req_id
      AND cand.cand_id = status_dates.cand_id
      AND status_dates.activity_status IN ('interview_1',
        'interview_2')) AS cand_last_interviewed_date,
    (
    SELECT
      MAX(rsr_processed_date)
    FROM
      status_dates
    WHERE
      cand.req_id = status_dates.req_id
      AND cand.cand_id = status_dates.cand_id) AS rsr_processed_date,
    cand.rsr_staffing_entity
    -- winter_release 2025
  FROM
    `${dataform.projectConfig.vars.ds_name}.prs_candidate_${dataform.projectConfig.vars.client_code}` cand
  QUALIFY
    ROW_NUMBER() OVER (PARTITION BY cand.req_id, cand.cand_id ORDER BY cand_last_modified_date DESC)= 1
    -- this needs to be done beacuse we would want to get the latest details for each candidate id and req_id, incase there are two dates in cand_last_modified date two rows will appear even for 1 can id and req id combination
    ),
    ------------------------------------------------------------------------
    -- Standard MSP template after pivitoing to non transactional
    ------------------------------------------------------------------------
    js_assingment_data AS (
  SELECT
    cand.* EXCEPT(presented_bill_rate,
      presented_bill_rate_st_basis,
      presented_pay_rate)
      -- removing these fields since they are not standalone fields in the template
      ,
    assingment_in.assignment_create_date_initial AS cand_offer_extended_date
    -- ,assingment_in.supplier_code,
    ,
    assingment_supplier_details.supplier_code,
    CASE
      WHEN LOWER(req.rate_unit_type) LIKE '%hour%' THEN cand.presented_bill_rate
      WHEN LOWER(req.rate_unit_type) LIKE '%day%' THEN (cand.presented_bill_rate /(req.hours_per_week/req.days_per_week))
      WHEN LOWER(req.rate_unit_type) = 'monthly' THEN (cand.presented_bill_rate /((req.hours_per_week/req.days_per_week)*4.33))
      WHEN LOWER(req.rate_unit_type) = 'weekly' THEN (cand.presented_bill_rate /(req.hours_per_week))
  END
    AS presented_bill_rate_st_hr,
    CASE
      WHEN LOWER(req.rate_unit_type) LIKE '%hour%' THEN cand.presented_pay_rate
      WHEN LOWER(req.rate_unit_type) LIKE '%day%' THEN (cand.presented_pay_rate /(req.hours_per_week/req.days_per_week))
      WHEN LOWER(req.rate_unit_type) = 'monthly' THEN (cand.presented_pay_rate /((req.hours_per_week/req.days_per_week)*4.33))
      WHEN LOWER(req.rate_unit_type) = 'weekly' THEN (cand.presented_pay_rate /(req.hours_per_week))
  END
    AS presented_pay_rate_st_hr,
    CASE
      WHEN LOWER(req.rate_unit_type) LIKE '%hour%' THEN cand.default_rate
      WHEN LOWER(req.rate_unit_type) LIKE '%day%' THEN (cand.default_rate /(req.hours_per_week/req.days_per_week))
  END
    AS presented_bill_rate_supplier_st_hr,
    assingment_in.assignment_create_date_initial,
    assingment_in.assignment_activation_date_initial,
    assingment_in.sourcing_type_wk_mapped,
    assingment_in.sourcing_type_wo_mapped,
    assingment_in.cand_offer_accepted_date
    --cast(null as date) as cand_offer_accepted_date--assingment_in.cand_offer_accepted_date
    ,
    req.req_title,
    req.req_type,
    req.max_requested_bill_rate_st_hr,
    req.max_requested_pay_rate_st_hr,
    req.min_requested_bill_rate_st_hr,
    req.min_requested_pay_rate_st_hr,
    req.labor_type,
    req.req_status,
    req.site AS req_site,
    req.site_code AS req_site_code,
    req.location AS req_location,
    req.city AS req_city,
    req.state_province AS req_state_province,
    req.country AS req_country,
    req.req_approved_date,
    req.req_closed_date,
    req.req_create_date,
    req.req_end_date,
    req.req_submitted_date,
    req.req_coordinator_name,
    req.positions_requested_cnt,
    req.rsr_state,
    req.rsr_country,
    req.rsr_labor_type,
    req.rsr_region,
    req.business_unit_code,
    req.business_unit,
    req.currency AS req_currency
    --null as req_currency
    ,
    req.hours_per_day,
    req.hours_per_week,
    req.max_template_bill_rate_st_hr,
    req.rsr_req_status,
    req.primary_cost_center,
    req.rsr_sourced_type,
    assingment_in.worker_start_date
  FROM
    cand_non_transactional cand
  LEFT JOIN
    ${dataform.projectConfig.vars.ds_name}.stdrv_assignment_${dataform.projectConfig.vars.client_code} assingment_in
  ON
    cand.buyer = assingment_in.buyer
    AND assingment_in.cand_id IS NOT NULL
    AND cand.cand_id= assingment_in.cand_id
  LEFT JOIN
    ${dataform.projectConfig.vars.ds_name}.stdrv_assignment_${dataform.projectConfig.vars.client_code} AS assingment_supplier_details
  ON
    LOWER(REGEXP_REPLACE(cand.supplier, r"\s+", "")) = LOWER(REGEXP_REPLACE(assingment_supplier_details.supplier, r"\s+", ""))
  LEFT JOIN
    ${dataform.projectConfig.vars.ds_name}.stdrv_requisition_${dataform.projectConfig.vars.client_code} req
  ON
    cand.buyer = req.buyer
    AND cand.req_id= req.req_id ),
  fx_rates AS (
  SELECT
    CAST(fx_rate AS FLOAT64) AS fx_rate,
    from_currency,
    PARSE_DATE("%Y-%m-%d", month) AS month,
    to_currency
  FROM
    db_common${dataform.projectConfig.vars.region}.global_fx_rates ),
  req_dist_data AS (
  SELECT
    buyer_code
    -- ,supplier_code --- null in req_dist hence not using in ntv template
    ,
    LOWER(REGEXP_REPLACE(supplier, r"\s+", "")) AS supplier,
    req_id,
    MIN(req_distribution_date) AS min_req_dist_date
  FROM
    ${dataform.projectConfig.vars.ds_name}.prs_requisition_distribution_${dataform.projectConfig.vars.client_code}
  GROUP BY
    buyer_code
    -- ,supplier_code --grouping by supplier instead of supplier code due to absence of supplier code in req dist
    ,
    LOWER(REGEXP_REPLACE(supplier, r"\s+", ""))
    --  supplier will be string like 'Investigo Limited'/ 'Randstad Sourceright LTD'
    ,
    req_id )
SELECT
  DISTINCT candidate_assingment_req.buyer,
  candidate_assingment_req.buyer_code,
  candidate_assingment_req.req_id,
  candidate_assingment_req.cand_id,
  candidate_assingment_req.cand_name,
  candidate_assingment_req.supplier,
  candidate_assingment_req.cand_status,
  candidate_assingment_req.cand_submit_date,
  candidate_assingment_req.withdrawn_reason,
  candidate_assingment_req.rejected_reason,
  candidate_assingment_req.business_unit_code,
  candidate_assingment_req.business_unit,
  candidate_assingment_req.currency,
  candidate_assingment_req.req_currency,
  candidate_assingment_req.cand_available_date,
  candidate_assingment_req.cand_buyer_first_viewed_date,
  candidate_assingment_req.cand_first_interviewed_date,
  candidate_assingment_req.cand_first_submitted_date,
  candidate_assingment_req.cand_last_interviewed_date,
  candidate_assingment_req.cand_last_modified_date,
  candidate_assingment_req.cand_rejected_date,
  candidate_assingment_req.cand_shortlisted_date,
  candidate_assingment_req.cand_unshortlisted_date,
  candidate_assingment_req.cand_withdrawn_date,
  candidate_assingment_req.assignment_activation_date,
  candidate_assingment_req.cand_offer_accepted_date,
  candidate_assingment_req.cand_offer_extended_date,
  candidate_assingment_req.location,
  candidate_assingment_req.site_code,
  candidate_assingment_req.site,
  candidate_assingment_req.cand_code,
  candidate_assingment_req.msp_code,
  candidate_assingment_req.msp_company,
  candidate_assingment_req.hours_per_day,
  candidate_assingment_req.hours_per_week,
  candidate_assingment_req.presented_bill_rate_st_hr,
  candidate_assingment_req.presented_bill_rate_supplier_st_hr,
  candidate_assingment_req.presented_pay_rate_st_hr,
  candidate_assingment_req.supplier_code,
  candidate_assingment_req.uploaded,
  candidate_assingment_req.primary_cost_center,
  CASE
    WHEN candidate_assingment_req.currency = 'USD' THEN ROUND(candidate_assingment_req.presented_bill_rate_st_hr, 4)
    ELSE ROUND((fx_usd.fx_rate * candidate_assingment_req.presented_bill_rate_st_hr), 4)
END
  AS presented_bill_rate_st_hr_usd,
  CASE
    WHEN candidate_assingment_req.currency = 'USD' THEN ROUND( candidate_assingment_req.presented_bill_rate_supplier_st_hr, 4)
    ELSE ROUND((fx_usd.fx_rate * candidate_assingment_req.presented_bill_rate_supplier_st_hr), 4)
END
  AS supplier_presented_bill_rate_st_hr_usd,
  CASE
    WHEN candidate_assingment_req.currency = 'USD' THEN ROUND(candidate_assingment_req.presented_pay_rate_st_hr, 4)
    ELSE ROUND((fx_usd.fx_rate * candidate_assingment_req.presented_pay_rate_st_hr), 4)
END
  AS presented_pay_rate_st_hr_usd,
  CASE
    WHEN candidate_assingment_req.currency = 'EUR' THEN ROUND(candidate_assingment_req.presented_bill_rate_st_hr, 4)
    ELSE ROUND((fx_eur.fx_rate * candidate_assingment_req.presented_bill_rate_st_hr), 4)
END
  AS presented_bill_rate_st_hr_eur,
  CASE
    WHEN candidate_assingment_req.currency = 'EUR' THEN ROUND( candidate_assingment_req.presented_bill_rate_supplier_st_hr, 4)
    ELSE ROUND((fx_eur.fx_rate * candidate_assingment_req.presented_bill_rate_supplier_st_hr), 4)
END
  AS supplier_presented_bill_rate_st_hr_eur,
  CASE
    WHEN candidate_assingment_req.currency = 'EUR' THEN ROUND(candidate_assingment_req.presented_pay_rate_st_hr, 4)
    ELSE ROUND((fx_eur.fx_rate * candidate_assingment_req.presented_pay_rate_st_hr), 4)
END
  AS presented_pay_rate_st_hr_eur,
  CASE
    WHEN candidate_assingment_req.currency = 'GBP' THEN ROUND(candidate_assingment_req.presented_bill_rate_st_hr, 4)
    ELSE ROUND((fx_gbp.fx_rate * candidate_assingment_req.presented_bill_rate_st_hr), 4)
END
  AS presented_bill_rate_st_hr_gbp,
  CASE
    WHEN candidate_assingment_req.currency = 'GBP' THEN ROUND( candidate_assingment_req.presented_bill_rate_supplier_st_hr, 4)
    ELSE ROUND((fx_gbp.fx_rate * candidate_assingment_req.presented_bill_rate_supplier_st_hr), 4)
END
  AS supplier_presented_bill_rate_st_hr_gbp,
  CASE
    WHEN candidate_assingment_req.currency = 'GBP' THEN ROUND(candidate_assingment_req.presented_pay_rate_st_hr, 4)
    ELSE ROUND((fx_gbp.fx_rate * candidate_assingment_req.presented_pay_rate_st_hr), 4)
END
  AS presented_pay_rate_st_hr_gbp,
  CASE
    WHEN candidate_assingment_req.currency = 'INR' THEN ROUND(candidate_assingment_req.presented_bill_rate_st_hr, 4)
    ELSE ROUND((fx_inr.fx_rate * candidate_assingment_req.presented_bill_rate_st_hr), 4)
END
  AS presented_bill_rate_st_hr_inr,
  CASE
    WHEN candidate_assingment_req.currency = 'INR' THEN ROUND(candidate_assingment_req.presented_bill_rate_supplier_st_hr, 4)
    ELSE ROUND((fx_inr.fx_rate * candidate_assingment_req.presented_bill_rate_supplier_st_hr), 4)
END
  AS supplier_presented_bill_rate_st_hr_inr,
  CASE
    WHEN candidate_assingment_req.currency = 'INR' THEN ROUND( candidate_assingment_req.presented_pay_rate_st_hr, 4)
    ELSE ROUND((fx_inr.fx_rate * candidate_assingment_req.presented_pay_rate_st_hr), 4)
END
  AS presented_pay_rate_st_hr_inr,
  CASE
    WHEN candidate_assingment_req.currency = 'CAD' THEN ROUND( candidate_assingment_req.presented_bill_rate_st_hr, 4)
    ELSE ROUND((fx_cad.fx_rate * candidate_assingment_req.presented_bill_rate_st_hr), 4)
END
  AS presented_bill_rate_st_hr_cad,
  CASE
    WHEN candidate_assingment_req.currency = 'CAD' THEN ROUND( candidate_assingment_req.presented_bill_rate_supplier_st_hr, 4)
    ELSE ROUND((fx_cad.fx_rate * candidate_assingment_req.presented_bill_rate_supplier_st_hr), 4)
END
  AS supplier_presented_bill_rate_st_hr_cad,
  CASE
    WHEN candidate_assingment_req.currency = 'CAD' THEN ROUND(candidate_assingment_req.presented_pay_rate_st_hr, 4)
    ELSE ROUND((fx_cad.fx_rate * candidate_assingment_req.presented_pay_rate_st_hr), 4)
END
  AS presented_pay_rate_st_hr_cad,
  PARSE_DATE('%m/%d/%Y', global_calendar_445.calendar_reporting_month_date) AS control,
  CASE
    WHEN candidate_assingment_req.rsr_country='United States of America' THEN div_supp.primary_diversity_type
    ELSE CAST(NULL AS STRING)
END
  AS supplier_primary_diversity_type,
  CASE
    WHEN candidate_assingment_req.rsr_country='United States of America' THEN div_supp.small_business
    ELSE CAST(NULL AS STRING)
END
  AS supplier_small_business,
  CASE
    WHEN candidate_assingment_req.rsr_country='United States of America' THEN div_supp.diverse_and_small
    ELSE CAST(NULL AS STRING)
END
  AS supplier_diverse_small,
  CASE
    WHEN candidate_assingment_req.rsr_country='United States of America' THEN div_supp.supplier_id_erp
    ELSE CAST(NULL AS STRING)
END
  AS supplier_erp_id,
  candidate_assingment_req.assignment_create_date_initial,
  candidate_assingment_req.assignment_activation_date_initial,
  candidate_assingment_req.req_title,
  candidate_assingment_req.req_type,
  candidate_assingment_req.max_requested_bill_rate_st_hr,
  candidate_assingment_req.max_requested_pay_rate_st_hr,
  candidate_assingment_req.min_requested_bill_rate_st_hr,
  candidate_assingment_req.min_requested_pay_rate_st_hr,
  candidate_assingment_req.labor_type,
  candidate_assingment_req.req_status,
  candidate_assingment_req.req_site,
  candidate_assingment_req.req_site_code,
  candidate_assingment_req.req_location,
  candidate_assingment_req.req_city,
  candidate_assingment_req.req_state_province,
  candidate_assingment_req.req_country,
  candidate_assingment_req.req_approved_date,
  candidate_assingment_req.req_closed_date,
  candidate_assingment_req.req_create_date,
  candidate_assingment_req.req_end_date,
  candidate_assingment_req.req_submitted_date,
  candidate_assingment_req.req_coordinator_name,
  candidate_assingment_req.positions_requested_cnt,
  candidate_assingment_req.sourcing_type_wk_mapped,
  candidate_assingment_req.sourcing_type_wo_mapped,
  candidate_assingment_req.max_template_bill_rate_st_hr
  -- used max_requested_bill_rate_st_hr instead of max_template_bill_rate_st_hr
  ,
  (CASE
      WHEN candidate_assingment_req.max_template_bill_rate_st_hr >= candidate_assingment_req.presented_bill_rate_supplier_st_hr THEN 'Compliant'
      ELSE CASE
      WHEN candidate_assingment_req.presented_bill_rate_supplier_st_hr < (CAST('1.15' AS NUMERIC) * candidate_assingment_req.max_template_bill_rate_st_hr) THEN 'Non-Compliant - Under 115% Max Bill Rate'
      ELSE 'Non-Compliant - Over 115% Max Bill Rate'
  END
  end) AS compliance_vs_max_template_bill_rate,
  candidate_assingment_req.rsr_state,
  candidate_assingment_req.rsr_country,
  candidate_assingment_req.rsr_region,
  candidate_assingment_req.rsr_labor_type,
  global_supp_map.suppliername_dw AS rsr_supplier,
  candidate_assingment_req.rsr_req_status,
  IFNULL(candidate_assingment_req.rsr_sourced_type,'Recruited') AS rsr_sourced_type,
  IFNULL(global_js_status_mapping.submittal_status_dw, NULL) AS rsr_cand_status,
  CAST(Function_library${dataform.projectConfig.vars.region}.f_calendarday(candidate_assingment_req.req_approved_date,
      candidate_assingment_req.cand_submit_date) AS INT64) AS approved_to_submit_cd,
  ROUND(Function_library${dataform.projectConfig.vars.region}.f_workday(candidate_assingment_req.req_approved_date,
      candidate_assingment_req.cand_submit_date), 4)AS approved_to_submit_bd,
  CAST(Function_library${dataform.projectConfig.vars.region}.f_calendarday( candidate_assingment_req.cand_submit_date,
      candidate_assingment_req.cand_shortlisted_date) AS INT64) AS submit_to_shortlist_cd,
  ROUND(Function_library${dataform.projectConfig.vars.region}.f_workday(candidate_assingment_req.cand_submit_date,
      candidate_assingment_req.cand_shortlisted_date), 4)AS submit_to_shortlist_bd,
  'msp_ntv${dataform.projectConfig.vars.region}_mundipharma' AS rsr_client_code,
  CURRENT_DATE() AS current_date,
  candidate_assingment_req.rsr_processed_date,
  NULL AS preferred_supplier_status,
  req_dist_data.min_req_dist_date AS req_distribution_date,
  candidate_assingment_req.rsr_staffing_entity
  -- winter_release 2025
  ,
  candidate_assingment_req.worker_start_date
FROM
  js_assingment_data AS candidate_assingment_req
LEFT JOIN
  req_dist_data
ON
  candidate_assingment_req.buyer_code = req_dist_data.buyer_code
  -- AND candidate_assingment_req.supplier_code = req_dist_data.supplier_code --- had to use supplier instead of supplier code due to ntv limitations
  AND LOWER(REGEXP_REPLACE(candidate_assingment_req.supplier, r"\s+", "")) = LOWER(REGEXP_REPLACE(req_dist_data.supplier, r"\s+", ""))
  AND candidate_assingment_req.req_id = req_dist_data.req_id
LEFT JOIN
  db_common${dataform.projectConfig.vars.region}.global_supplier_mapping AS global_supp_map
ON
  candidate_assingment_req.buyer = global_supp_map.buyer
  AND candidate_assingment_req.supplier = global_supp_map.supplier
LEFT JOIN
  db_common${dataform.projectConfig.vars.region}.global_js_status AS global_js_status_mapping
ON
  TRIM(LOWER(candidate_assingment_req.cand_status)) = TRIM(LOWER(global_js_status_mapping.job_seeker_status))
LEFT JOIN
  db_common${dataform.projectConfig.vars.region}.global_calendar_445 AS global_calendar_445
ON
  EXTRACT(DATE
  FROM
    Function_library${dataform.projectConfig.vars.region}.max_array([candidate_assingment_req.cand_submit_date,
      candidate_assingment_req.assignment_activation_date_initial])) = PARSE_DATE("%m/%d/%Y", global_calendar_445.day)
LEFT JOIN
  fx_rates fx_usd
ON
  candidate_assingment_req.currency = fx_usd.from_currency
  AND PARSE_DATE('%m/%d/%Y', global_calendar_445.calendar_reporting_month_date)=fx_usd.month
  AND fx_usd.to_currency = 'USD'
LEFT JOIN
  fx_rates fx_eur
ON
  candidate_assingment_req.currency = fx_eur.from_currency
  AND PARSE_DATE('%m/%d/%Y', global_calendar_445.calendar_reporting_month_date)=fx_eur.month
  AND fx_eur.to_currency = 'EUR'
LEFT JOIN
  fx_rates fx_gbp
ON
  candidate_assingment_req.currency = fx_gbp.from_currency
  AND PARSE_DATE('%m/%d/%Y', global_calendar_445.calendar_reporting_month_date)=fx_gbp.month
  AND fx_gbp.to_currency = 'GBP'
LEFT JOIN
  fx_rates fx_inr
ON
  candidate_assingment_req.currency = fx_inr.from_currency
  AND PARSE_DATE('%m/%d/%Y', global_calendar_445.calendar_reporting_month_date)=fx_inr.month
  AND fx_inr.to_currency = 'INR'
LEFT JOIN
  fx_rates fx_cad
ON
  candidate_assingment_req.currency = fx_cad.from_currency
  AND PARSE_DATE('%m/%d/%Y', global_calendar_445.calendar_reporting_month_date)=fx_cad.month
  AND fx_cad.to_currency = 'CAD'
LEFT JOIN
  db${dataform.projectConfig.vars.region}_aptus.aptus_suppio_supplier_diversity_data div_supp
ON
  LOWER(div_supp.customer_code)=LOWER(candidate_assingment_req.buyer_code)
  AND div_supp.supplier_code=candidate_assingment_req.supplier_code
  AND div_supp.fiscal_year=CAST(EXTRACT(YEAR
    FROM
      CAST(candidate_assingment_req.cand_submit_date AS DATE)) AS INTEGER)
  AND div_supp.accounting_period=CAST(EXTRACT(MONTH
    FROM
      CAST(candidate_assingment_req.cand_submit_date AS DATE)) AS INTEGER) )
