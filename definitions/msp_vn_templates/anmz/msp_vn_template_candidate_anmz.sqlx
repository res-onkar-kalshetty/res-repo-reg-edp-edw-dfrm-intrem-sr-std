config {
    type: "operations",
    description: "Dynamically creates the anonymized table for candidates.",
    dependencies: "msp_vn_template_candidate_gold",
    tags: ["msp_vn_template_gold_anmz"] 
}

js {
    const anonymization = require("includes/anonymization");
    const helper = require("/includes/helper");

    const env = helper.get_env();
    const region = helper.get_region();
 // Get region_code for the hardcoded dataset name (emea, nam, or apac)
    const region_code = helper.get_region_code(); 
    
    const dataset_id = dataform.projectConfig.vars.dataset_id;
    
    const gold_dataset = (env == "prd") ?
     `gold_${dataset_id}` : 
     `dev_gold_${dataset_id}`;
     
    const anmz_dataset =
     `db_anmz_${region_code}_candidate_stdschema`;
    const metadata_path = `\`rsr-bi-group-prd-701e.db_${region_code}_mysql_configs.master_template_report_fields\``;
}

DECLARE candidate_table_id STRING;
DECLARE gold_dataset STRING;
DECLARE select_clause STRING;
DECLARE final_ddl_statement STRING;
DECLARE region STRING;

SET gold_dataset='${gold_dataset}';
SET region='${region}';
SET candidate_table_id="stdrv_candidate_" || '${dataform.projectConfig.vars.client_code}';

IF
  candidate_table_id IS NULL THEN RAISE
USING
  MESSAGE = 'candidate stdrv TABLE IS MISSING ';
END IF
  ;

-- Generate Anonymization logic
EXECUTE IMMEDIATE
  FORMAT("""${
        anonymization.get_anonymized_select_clause({
            report_type: "candidate",
            solution: "MSP",
            metadata_table:  metadata_path
        })
    }""") INTO select_clause;

-- Create anmz table in the dynamic region-based dataset
SET final_ddl_statement = FORMAT("""
  CREATE OR REPLACE TABLE `${anmz_dataset}.anmz_candidate_${dataform.projectConfig.vars.client_code}` AS (
    SELECT %s FROM `%s.%s`
  )
""", select_clause, gold_dataset, candidate_table_id );

EXECUTE IMMEDIATE final_ddl_statement;